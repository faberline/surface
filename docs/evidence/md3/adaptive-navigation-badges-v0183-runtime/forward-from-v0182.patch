+#[test]
+fn badged_scaffold_keeps_owner_name_selection_focus_and_geometry_across_breakpoints() {
+    let mut fonts = TextSystem::default();
+    for direction in [LayoutDirection::LeftToRight, LayoutDirection::RightToLeft] {
+        let mut runtime = Runtime::new(Page {
+            badged: true,
+            selected: 2,
+            direction,
+            ..Page::default()
+        })
+        .unwrap();
+        render(&mut runtime, &mut fonts, 839., 720.);
+
+        for _ in 0..8 {
+            if runtime.focused() == Some("saved") {
+                break;
+            }
+            runtime
+                .dispatch(Event::FocusNext { reverse: false })
+                .unwrap();
+        }
+        assert_eq!(runtime.focused(), Some("saved"));
+        assert!(runtime.app().calls.is_empty());
+
+        let mut bounds_by_width = Vec::new();
+        for width in [840., 839., 599., 600., 840.] {
+            let display = runtime.render(width, 720., &mut fonts).unwrap();
+            assert_eq!(runtime.focused(), Some("saved"));
+            assert_eq!(runtime.app().selected, 2);
+            assert!(runtime.app().calls.is_empty());
+
+            let owner = rect(&runtime, "saved");
+            let badge = error_badge_bounds(&display);
+            assert!(badge.x >= owner.x && badge.y >= owner.y);
+            assert!(badge.x + badge.width <= owner.x + owner.width);
+            assert!(badge.y + badge.height <= owner.y + owner.height);
+            assert!(display
+                .ops
+                .iter()
+                .any(|op| matches!(op, PaintOp::StyledText { text, .. } if text == "999+")));
+
+            let frame = runtime.accessibility_frame().unwrap();
+            let saved_id = id(&runtime, "saved");
+            let saved = frame.node(saved_id).unwrap().node;
+            assert_eq!(saved.role(), Role::Button);
+            assert_eq!(saved.name(), "收藏，1,200 則未讀");
+            assert_eq!(saved.is_current_page(), Some(true));
+            assert_eq!(
+                frame.children(saved_id).count(),
+                0,
+                "badge has no AX child at {width} dp"
+            );
+            bounds_by_width.push((width, owner));
+        }
+
+        let frame = runtime.accessibility_frame().unwrap();
+        let focus = frame.focus_target(id(&runtime, "saved")).unwrap();
+        let enter = KeyPress::new(Key::Enter, Modifiers::default());
+        assert!(runtime
+            .accessibility_key(&focus, &enter, Event::Activate)
+            .unwrap());
+        let display = runtime.render(840., 720., &mut fonts).unwrap();
+        assert_eq!(runtime.focused(), Some("saved"));
+        assert_eq!(runtime.app().calls, [2]);
+        assert_eq!(runtime.app().selected, 2);
+        assert!(!has_error_badge(&display));
+        let frame = runtime.accessibility_frame().unwrap();
+        let saved_id = id(&runtime, "saved");
+        let saved = frame.node(saved_id).unwrap().node;
+        assert_eq!(saved.name(), "收藏");
+        assert_eq!(saved.is_current_page(), Some(true));
+        assert_eq!(frame.children(saved_id).count(), 0);
+
+        for (width, before) in bounds_by_width {
+            let display = runtime.render(width, 720., &mut fonts).unwrap();
+            assert_eq!(runtime.focused(), Some("saved"));
+            assert_eq!(rect(&runtime, "saved"), before);
+            assert!(!has_error_badge(&display));
+            let frame = runtime.accessibility_frame().unwrap();
+            let saved = frame.node(id(&runtime, "saved")).unwrap().node;
+            assert_eq!(saved.name(), "收藏");
+            assert_eq!(saved.is_current_page(), Some(true));
+        }
+    }
+}
