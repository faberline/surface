diff --git a/e2e/src/material_adaptive_navigation_badges.rs b/e2e/src/material_adaptive_navigation_badges.rs
new file mode 100644
index 0000000000000000000000000000000000000000..896fc4904eecca6e1ad7fe51ddefa9599d932257
--- /dev/null
+++ b/e2e/src/material_adaptive_navigation_badges.rs
@@ -0,0 +1,290 @@
+//! Browser proof for badges on the adaptive navigation scaffold.
+
+use anyhow::{Context, Result};
+use serde_json::{json, Value};
+
+use super::material_time_input::{
+    activate, ax, ax_property, ax_tree, bounds, contains, focus_projected, focused, projected,
+    resize, Raster,
+};
+use super::{state, until};
+use crate::browser::{js, Chrome, Tab};
+use crate::check::step;
+use crate::{check, check_eq, Env};
+
+pub(super) const STEPS: [&str; 2] = ["M389", "M390"];
+const SHOW: &str = "adaptive-navigation-badges-demo-show";
+const BACK: &str = "adaptive-navigation-demo-back";
+const THEME: &str = "adaptive-navigation-demo-theme";
+const RTL: &str = "adaptive-navigation-demo-rtl";
+const LARGE: &str = "adaptive-navigation-demo-large";
+const NAV: &str = "adaptive-navigation-demo-bar";
+const HOME: &str = "adaptive-navigation-demo-home";
+const EXPLORE: &str = "adaptive-navigation-demo-explore";
+const SAVED: &str = "adaptive-navigation-demo-saved";
+const UPDATES: &str = "adaptive-navigation-demo-updates";
+const SETTINGS: &str = "adaptive-navigation-demo-settings";
+const IDS: [&str; 5] = [HOME, EXPLORE, SAVED, UPDATES, SETTINGS];
+const STEM: &str = "material-adaptive-navigation-badges";
+type Rect = [f64; 4];
+type Rgb = [u8; 3];
+
+async fn ready(tab: &Tab, condition: &str) -> Result<()> {
+    until(
+        tab,
+        &format!("(d => d?.visible && ({condition}))(s.adaptive_navigation)"),
+    )
+    .await
+}
+
+async fn current(tab: &Tab, id: &str, activations: usize) -> Result<()> {
+    ready(
+        tab,
+        &format!("d.selected === {id:?} && d.activations === {activations}"),
+    )
+    .await?;
+    tab.wait_for(&format!(
+        "{}?.getAttribute('aria-current') === 'page' &&
+         document.querySelectorAll('#surface-accessibility [aria-current=page]').length === 1",
+        projected(id)
+    ))
+    .await
+}
+
+async fn accessibility(tab: &Tab, acknowledged: bool) -> Result<Value> {
+    let tree = ax_tree(tab).await?;
+    let landmark = ax(&tree, "navigation", "主要導覽")?;
+    let names = [
+        "首頁",
+        "探索路線",
+        "收藏，有新項目",
+        if acknowledged {
+            "最新消息"
+        } else {
+            "最新消息，1,234 則未讀"
+        },
+        "設定，有新功能",
+    ];
+    let mut items = Vec::new();
+    for (index, (id, name)) in IDS.iter().zip(names).enumerate() {
+        let node = ax(&tree, "button", name)?;
+        let disabled = ax_property(node, "disabled")
+            .and_then(Value::as_bool)
+            .unwrap_or(false);
+        check_eq!(disabled, index == 1, "{id} exposes its disabled state");
+        // Chrome's AX serialization omits aria-current. Read its DOM projection.
+        let current = tab
+            .eval(&format!(
+                "{}?.getAttribute('aria-current') ?? null",
+                projected(id)
+            ))
+            .await?;
+        items.push(json!({"id":id,"name":name,"disabled":disabled,"current":current}));
+    }
+    check_eq!(
+        tree.iter()
+            .filter(|node| node["ignored"] == false && node["role"]["value"] == "navigation")
+            .count(),
+        1,
+        "the active page exposes one navigation landmark"
+    );
+    check!(
+        tree.iter()
+            .all(|node| node["ignored"] == true || node["name"]["value"] != "999+"),
+        "the abbreviated badge is not announced as a separate item"
+    );
+    Ok(json!({"landmark":landmark["name"]["value"],"items":items}))
+}
+
+fn rgb(value: &Value, name: &str) -> Result<Rgb> {
+    let [r, g, b, alpha]: [u8; 4] = serde_json::from_value(value.clone())
+        .with_context(|| format!("{name} is an RGBA palette color"))?;
+    check_eq!(alpha, 255, "{name} is opaque");
+    Ok([r, g, b])
+}
+
+fn pixels_near(image: &Raster, rect: Rect, color: Rgb, tolerance: u8) -> Result<usize> {
+    Ok(image
+        .colors(rect)?
+        .iter()
+        .filter(|(actual, _)| {
+            actual
+                .iter()
+                .zip(color)
+                .all(|(a, b)| a.abs_diff(b) <= tolerance)
+        })
+        .map(|(_, count)| count)
+        .sum())
+}
+
+async fn count_bounds(tab: &Tab, owner_id: &str, owner: Rect) -> Result<Rect> {
+    let value = tab
+        .eval(&format!(
+            "(() => {{
+                const {{dom,layout}} = JSON.parse(window.gallery.export_dom());
+                const nodes = dom.nodes;
+                const owner = nodes.findIndex(n => n.stable_id === {});
+                const index = nodes.findIndex(n => {{
+                    if (n.text !== '999+') return false;
+                    for (let i = n.parent; Number.isInteger(i); i = nodes[i].parent) {{
+                        if (i === owner) return true;
+                    }}
+                    return false;
+                }});
+                if (owner < 0 || index < 0) return null;
+                const {{x,y,width,height}} = layout.nodes[index].bounds;
+                return [x,y,width,height];
+            }})()",
+            js(owner_id),
+        ))
+        .await?;
+    let rect: Rect = serde_json::from_value(value).context("the 999+ text belongs to its owner")?;
+    check!(
+        contains(owner, rect),
+        "the count text stays inside {owner_id}: {rect:?}"
+    );
+    Ok(rect)
+}
+
+async fn capture(env: &Env, tab: &Tab, label: &str, acknowledged: bool) -> Result<Value> {
+    tab.settle().await?;
+    let state = state(tab).await?;
+    let demo = &state["adaptive_navigation"];
+    let error = rgb(&demo["badge_palette"]["error"], "Error")?;
+    let on_error = rgb(&demo["badge_palette"]["on_error"], "On Error")?;
+    let nav = bounds(tab, NAV).await?;
+    let canvas = tab.canvas_box().await?;
+    check!(
+        contains([0., 0., canvas[2], canvas[3]], nav),
+        "navigation is inside the screenshot"
+    );
+    let name = format!("{STEM}-{label}.png");
+    let path = env.artifact(&name);
+    tab.screenshot(&path).await?;
+    let image = Raster::read(tab, path).await?;
+    let mut owners = Vec::new();
+    for (index, id) in IDS.iter().copied().enumerate() {
+        let owner = bounds(tab, id).await?;
+        check!(
+            contains(nav, owner),
+            "{id} remains inside the navigation bounds"
+        );
+        let error_pixels = pixels_near(&image, owner, error, 8)?;
+        if index == 2 || (index == 3 && !acknowledged) || index == 4 {
+            check!(
+                error_pixels >= 8,
+                "the badge paints inside {id}: {error_pixels} pixels"
+            );
+        }
+        owners.push(json!({"id":id,"bounds":owner,"error_pixels":error_pixels}));
+    }
+    let count = if acknowledged {
+        Value::Null
+    } else {
+        let owner = bounds(tab, UPDATES).await?;
+        let text = count_bounds(tab, UPDATES, owner).await?;
+        let ink_pixels = pixels_near(&image, text, on_error, 8)?;
+        check!(
+            ink_pixels >= 4,
+            "count text paints with On Error ink: {ink_pixels} pixels"
+        );
+        json!({"bounds":text,"on_error_pixels":ink_pixels})
+    };
+    Ok(json!({"screenshot":name,"canvas":canvas,"navigation":nav,
+        "rtl":demo["rtl"],"text_scale":demo["text_scale"],"dark":state["dark"],
+        "colors":{"error":error,"on_error":on_error},
+        "owners":owners,"count":count,"accessibility":accessibility(tab,acknowledged).await?}))
+}
+
+pub(super) async fn run(env: &Env, chrome: &Chrome, url: &str) -> Result<()> {
+    let tab = chrome.page(960, 1400, 2.).await?;
+    tab.goto(url).await?;
+    crate::smoke::ready(&tab, "gallery").await?;
+    resize(&tab, 960, 1400).await?;
+    activate(&tab, "section-3").await?;
+    until(&tab, "s.section === 3").await?;
+    let launcher_tree = ax_tree(&tab).await?;
+    let launcher = ax(&launcher_tree, "button", "自適應導覽徽章")?["name"]["value"].clone();
+    activate(&tab, SHOW).await?;
+    ready(&tab, "d.badges_enabled && d.unread_count === 1234").await?;
+    focused(&tab, BACK).await?;
+    current(&tab, HOME, 0).await?;
+    check_eq!(
+        state(&tab).await?["adaptive_navigation"]["badge_contents"],
+        json!(["hidden", "hidden", "dot", "999+", "新"]),
+        "the application supplies stable hidden, dot, count and label badge data"
+    );
+
+    step(
+        STEPS[0],
+        "Keyboard focus and selection survive the 599/600 and 839/840 breakpoints",
+    );
+    resize(&tab, 599, 720).await?;
+    ready(&tab, "d.viewport[0] === 599").await?;
+    focus_projected(&tab, HOME).await?;
+    tab.press("Tab").await?;
+    focused(&tab, SAVED).await?;
+    current(&tab, HOME, 0).await?;
+    tab.press("Enter").await?;
+    current(&tab, SAVED, 1).await?;
+    ready(&tab, "d.accessible_names[3] === '最新消息，1,234 則未讀'").await?;
+    let initial_accessibility = accessibility(&tab, false).await?;
+    resize(&tab, 600, 720).await?;
+    ready(&tab, "d.viewport[0] === 600").await?;
+    focused(&tab, SAVED).await?;
+    current(&tab, SAVED, 1).await?;
+    let medium = capture(env, &tab, "light-medium-600", false).await?;
+    resize(&tab, 599, 720).await?;
+    focused(&tab, SAVED).await?;
+    current(&tab, SAVED, 1).await?;
+    resize(&tab, 839, 720).await?;
+    focused(&tab, SAVED).await?;
+    current(&tab, SAVED, 1).await?;
+    resize(&tab, 840, 720).await?;
+    focused(&tab, SAVED).await?;
+    current(&tab, SAVED, 1).await?;
+    tab.press("ArrowDown").await?;
+    focused(&tab, UPDATES).await?;
+    current(&tab, SAVED, 1).await?;
+    check_eq!(
+        accessibility(&tab, false).await?,
+        initial_accessibility,
+        "layout changes preserve the full AX name and disabled destination"
+    );
+    let light_rail = capture(env, &tab, "light-rail-840", false).await?;
+
+    step(
+        STEPS[1],
+        "Dark RTL 200 percent text keeps badges attached and selection clears the count",
+    );
+    activate(&tab, THEME).await?;
+    activate(&tab, RTL).await?;
+    activate(&tab, LARGE).await?;
+    ready(&tab, "s.dark && d.rtl && d.text_scale === 2").await?;
+    resize(&tab, 840, 720).await?;
+    focus_projected(&tab, UPDATES).await?;
+    current(&tab, SAVED, 1).await?;
+    let dark = capture(env, &tab, "dark-rtl-200-count", false).await?;
+    tab.press("Enter").await?;
+    current(&tab, UPDATES, 2).await?;
+    ready(&tab, "d.unread_count === 0 && d.accessible_names[3] === '最新消息' && d.badge_contents[3] === 'hidden'").await?;
+    let acknowledged = accessibility(&tab, true).await?;
+    let cleared = capture(env, &tab, "dark-rtl-200-cleared", true).await?;
+    env.write_json(
+        &format!("{STEM}.json"),
+        &json!({
+            "browser":chrome.version,"steps":STEPS,"breakpoints":[599,600,839,840],
+            "launcher_accessibility":launcher,
+            "light_medium":medium,"light_rail":light_rail,"dark_rtl_200":dark,
+            "acknowledged":cleared,"initial_accessibility":initial_accessibility,
+            "acknowledged_accessibility":acknowledged,"selected":UPDATES,
+            "activations":2,"errors":tab.errors()
+        }),
+    )?;
+    check!(
+        tab.errors().is_empty(),
+        "page errors: {}",
+        tab.errors().join("\n")
+    );
+    Ok(())
+}
