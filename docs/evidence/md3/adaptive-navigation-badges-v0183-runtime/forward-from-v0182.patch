+    /// Place a caller-owned page beside adaptive navigation destinations with
+    /// decorative badges.
+    ///
+    /// Use the same stable IDs, accessible names, selection state and messages
+    /// as the unbadged scaffold. Put the full localized badge meaning in the
+    /// destination's accessible name. The badge itself adds no accessibility
+    /// stop. The caller owns badge changes and current-page state.
+    ///
+    /// This uses the same compact, medium and expanded breakpoints as
+    /// [`adaptive_navigation_scaffold`](Self::adaptive_navigation_scaffold).
+    /// It reserves the same scaffold and navigation IDs. It returns `None`
+    /// for the same invalid sizes and destination counts.
+    pub fn adaptive_navigation_scaffold_with_badges<'a, M: 'a>(
+        &self,
+        options: AdaptiveNavigationScaffoldOptions<'_>,
+        page: View<M>,
+        items: impl IntoIterator<Item = BadgedFlexibleNavigationBarItem<'a, M>>,
+    ) -> Option<View<M>> {
+        let width_class = WindowWidthSizeClass::from_dp(options.available_width)?;
+        if !options.available_height.is_finite() || options.available_height < 64. {
+            return None;
+        }
+        let items: Vec<_> = items.into_iter().take(6).collect();
+        if !(3..=5).contains(&items.len()) {
+            return None;
         }
-        let content_style = if rail {
-            Style::column().width(Length::Px(0.))
-        } else {
-            Style::column().height(Length::Px(0.))
+
+        let rail = width_class >= WindowWidthSizeClass::Expanded;
+        let bar_options = FlexibleNavigationBarOptions {
+            id: options.navigation_id,
+            name: options.name,
+            available_width: options.available_width,
+            direction: options.direction,
         };
-        let content = View::new(
-            Node::new(Role::Group, "")
-                .id(format!("{}-content", options.id))
-                .styled(content_style.grow(1.).clip(true)),
-        )
-        .children([page]);
-        let children = if rail {
-            [navigation, content]
-        } else {
-            [content, navigation]
+        let navigation = match width_class {
+            WindowWidthSizeClass::Compact => {
+                self.flexible_navigation_bar_with_badges(bar_options, items)?
+            }
+            WindowWidthSizeClass::Medium => {
+                self.horizontal_flexible_navigation_bar_with_badges(bar_options, items)?
+            }
+            _ => self.scaffold_wide_navigation_rail(
+                options.navigation_id,
+                options.name,
+                items.into_iter().map(|entry| {
+                    self.wide_navigation_rail_item_with_badge(
+                        WideNavigationRailMode::Collapsed,
+                        options.direction,
+                        entry.item,
+                        entry.badge,
+                    )
+                    .suppress_repeated_activation()
+                    .accessibility_scroll_into_view()
+                }),
+            ),
         };
-        Some(View::new(shell).children(children))
+        Some(adaptive_scaffold_shell(options, page, navigation, rail))
+    }
+}
+
+fn adaptive_scaffold_shell<M>(
+    options: AdaptiveNavigationScaffoldOptions<'_>,
+    page: View<M>,
+    navigation: View<M>,
+    rail: bool,
+) -> View<M> {
+    let style = if rail { Style::row() } else { Style::column() }
+        .width(Length::Px(options.available_width))
+        .height(Length::Px(options.available_height))
+        .align(Align::Stretch);
+    let mut shell = Node::new(Role::Group, "").id(options.id).styled(style);
+    if rail && options.direction == LayoutDirection::RightToLeft {
+        shell = shell.reverse_row();
     }
+    let content_style = if rail {
+        Style::column().width(Length::Px(0.))
+    } else {
+        Style::column().height(Length::Px(0.))
+    };
+    let content = View::new(
+        Node::new(Role::Group, "")
+            .id(format!("{}-content", options.id))
+            .styled(content_style.grow(1.).clip(true)),
+    )
+    .children([page]);
+    let children = if rail {
+        [navigation, content]
+    } else {
+        [content, navigation]
+    };
+    View::new(shell).children(children)
 }
