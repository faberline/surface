+use surface::{GridRole, Insets, Length, Node, Rect, Role, Style, TextMeasurer};
+use surface_app::{Application, EditKey, Event, Runtime, View};
+
+#[derive(Clone)]
+enum Message {
+    Activate(&'static str),
+    Remove,
+    Disable,
+    Modal(bool),
+}
+
+#[derive(Default)]
+struct App {
+    rtl: bool,
+    scrolled: bool,
+    nested: bool,
+    removed: bool,
