+fn key(id: &str, part: &str) -> String {
+    format!("{id}-{part}")
+}
+
+fn right(rect: Rect) -> f64 {
+    rect[0] + rect[2]
+}
+
+fn bottom(rect: Rect) -> f64 {
+    rect[1] + rect[3]
+}
+
+fn center(rect: Rect) -> [f64; 2] {
+    [rect[0] + rect[2] / 2., rect[1] + rect[3] / 2.]
+}
+
+fn rgb(color: [u8; 4]) -> Rgb {
+    [color[0], color[1], color[2]]
+}
