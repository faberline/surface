+async fn menu_trigger(tab: &Tab, id: &str) -> Result<()> {
+    for (attr, expected) in [("aria-haspopup", "menu"), ("aria-expanded", "false")] {
+        let value = tab
+            .eval(&format!("{}?.getAttribute({})", projected(id), js(attr)))
+            .await?;
+        check_eq!(value, json!(expected), format!("{id} {attr}"));
+    }
+    Ok(())
+}
