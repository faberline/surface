+async fn focused_from_pointer(tab: &Tab, id: &str) -> Result<Value> {
+    until(tab, &format!("s.focused === {}", json!(id))).await?;
+    let element = projected(id);
+    let canvas_active = "document.activeElement === document.querySelector('canvas')";
+    let projected_active = format!("{element} !== null && document.activeElement === {element}");
+    tab.wait_for(&format!("({projected_active}) || {canvas_active}"))
+        .await?;
+    tab.settle().await?;
+    let active = tab
+        .eval(&format!(
+            "{canvas_active} ? 'canvas' : (({projected_active}) ? 'projected' : null)"
+        ))
+        .await?;
+    check!(
+        active.is_string(),
+        "pointer focus remains in Surface for {id}"
+    );
+    check_eq!(
+        state(tab).await?["focused"],
+        id,
+        "runtime focus stays on {id}"
+    );
+    Ok(active)
+}
