+#[test]
+fn submenu_keys_and_escape_close_only_the_child_before_the_parent() {
+    for rtl in [false, true] {
+        let viewport = if rtl { (320., 420.) } else { (640., 600.) };
+        let mut app = Runtime::new(Demo {
+            rtl,
+            with_submenu: true,
+            ..Demo::default()
+        })
+        .unwrap();
+        open(&mut app, viewport);
+        assert_eq!(node(&app, "export").expanded_state(), Some(false));
+        assert!(node(&app, "export").has_menu_popup());
+        edit(&mut app, EditKey::Down);
+        assert_eq!(app.focused(), Some("export"));
+        let (open_key, close_key) = if rtl {
+            (EditKey::Left, EditKey::Right)
+        } else {
+            (EditKey::Right, EditKey::Left)
+        };
+        edit(&mut app, open_key);
+        settle(&mut app, viewport);
+        assert_eq!(app.focused(), Some("pdf"));
+        assert_eq!(node(&app, "export").expanded_state(), Some(true));
+        let child_id = app.dom().by_id("export-menu").unwrap();
+        let child = node(&app, "export-menu");
+        assert_eq!(child.role(), Role::Menu);
+        assert_eq!(child.name(), "匯出");
+        let command_rows = app.dom().by_id("commands-content").unwrap();
+        assert_eq!(child.parent(), Some(command_rows));
+        let child_bounds = bounds(&app, "export-menu");
+        let safe = Rect::new(8., 8., viewport.0 - 16., viewport.1 - 16.);
+        assert_eq!(child_bounds, child_bounds.intersect(safe));
+        if !rtl {
+            let trigger = bounds(&app, "export");
+            assert_eq!(child_bounds.x, trigger.x + trigger.width + 4.);
+        }
+        assert!(app.accessibility_frame().unwrap().node(child_id).is_some());
+        edit(&mut app, EditKey::Down);
+        assert_eq!(app.focused(), Some("plain-text"));
+        assert!(!app.dispatch(Event::Activate).unwrap());
+        assert_eq!(app.app().choices, 0);
+        edit(&mut app, close_key);
+        assert!(app.app().open);
+        assert!(!app.app().submenu_open);
+        assert_eq!(app.focused(), Some("export"));
+        app.dispatch(Event::Activate).unwrap();
+        assert_eq!(app.focused(), Some("pdf"));
+        app.dispatch(Event::Cancel).unwrap();
+        assert!(app.app().open);
+        assert_eq!(app.focused(), Some("export"));
+        app.dispatch(Event::Cancel).unwrap();
+        assert!(!app.app().open);
+        assert_eq!(app.focused(), Some("trigger"));
+    }
+}
