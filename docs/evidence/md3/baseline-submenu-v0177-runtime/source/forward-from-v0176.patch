diff --git a/e2e/src/material_command_menu_submenus.rs b/e2e/src/material_command_menu_submenus.rs
new file mode 100644
index 0000000..12d55d5
--- /dev/null
+++ b/e2e/src/material_command_menu_submenus.rs
@@ -0,0 +1,436 @@
+//! One-level Baseline command submenu coverage.
+
+use anyhow::{bail, Result};
+use serde_json::{json, Value};
+
+use super::material_time_input::{
+    activate, ax, ax_property, ax_tree, bounds, contains, focus_projected, focused, projected,
+    resize,
+};
+use super::{state, until};
+use crate::browser::{Chrome, Tab};
+use crate::check::step;
+use crate::{check, check_eq, Env};
+
+const SHOW: &str = "menu-demo-submenus-show";
+const BACK: &str = "menu-demo-back";
+const OPENER: &str = "menu-demo-opener";
+const MENU: &str = "menu-demo-panel";
+const SUBMENU: &str = "menu-demo-export-panel";
+const SUBMENU_ROW: &str = "menu-demo-export";
+const PDF: &str = "menu-demo-export-pdf";
+const DISABLED: &str = "menu-demo-export-csv";
+const OUTSIDE: &str = "menu-demo-list";
+
+pub(super) const STEPS: [&str; 4] = ["M376", "M377", "M378", "M379"];
+
+async fn route(tab: &Tab, url: &str) -> Result<()> {
+    tab.goto(url).await?;
+    crate::smoke::ready(tab, "gallery").await?;
+    resize(tab, 960, 2040).await?;
+    activate(tab, "section-2").await?;
+    until(tab, "s.section === 2").await?;
+    activate(tab, SHOW).await?;
+    until(tab, "s.menu_demo.submenus").await?;
+    focused(tab, BACK).await?;
+    resize(tab, 960, 800).await
+}
+
+async fn open(tab: &Tab) -> Result<()> {
+    focus_projected(tab, OPENER).await?;
+    tab.press("Enter").await?;
+    until(tab, "s.menu_demo.open").await?;
+    focused(tab, SUBMENU_ROW).await?;
+    tab.wait_for(&format!(
+        "{}?.getAttribute('aria-haspopup') === 'menu'",
+        projected(SUBMENU_ROW)
+    ))
+    .await?;
+    tab.wait_for(&format!(
+        "{}?.getAttribute('aria-disabled') !== 'true'",
+        projected(SUBMENU_ROW)
+    ))
+    .await
+}
+
+async fn open_child(tab: &Tab, key: &str) -> Result<()> {
+    tab.press(key).await?;
+    until(tab, "s.menu_demo.active_submenu === 'menu-demo-export'").await?;
+    focused(tab, PDF).await?;
+    Ok(())
+}
+
+async fn focused_from_pointer(tab: &Tab, id: &str) -> Result<Value> {
+    until(tab, &format!("s.focused === {}", json!(id))).await?;
+    let element = projected(id);
+    let canvas_active = "document.activeElement === document.querySelector('canvas')";
+    let projected_active = format!("{element} !== null && document.activeElement === {element}");
+    tab.wait_for(&format!("({projected_active}) || {canvas_active}"))
+        .await?;
+    tab.settle().await?;
+    let active = tab
+        .eval(&format!(
+            "{canvas_active} ? 'canvas' : (({projected_active}) ? 'projected' : null)"
+        ))
+        .await?;
+    check!(
+        active.is_string(),
+        "pointer focus remains in Surface for {id}"
+    );
+    check_eq!(
+        state(tab).await?["focused"],
+        id,
+        "runtime focus stays on {id}"
+    );
+    Ok(active)
+}
+
+async fn screenshot_witness(tab: &Tab) -> Result<Value> {
+    Ok(json!({
+        "menu": bounds(tab, MENU).await?,
+        "submenu": bounds(tab, SUBMENU).await?,
+        "first": bounds(tab, PDF).await?,
+        "canvas": tab.canvas_box().await?,
+        "device_pixel_ratio": tab.eval("window.devicePixelRatio").await?,
+        "surface": state(tab).await?["menu_demo"]["baseline_surface"],
+    }))
+}
+
+async fn outside_point(tab: &Tab) -> Result<(f64, f64)> {
+    let list = bounds(tab, OUTSIDE).await?;
+    let menu = bounds(tab, MENU).await?;
+    let child = bounds(tab, SUBMENU).await?;
+    let [left, top, _, _] = tab.canvas_box().await?;
+    for fraction in [0.5, 0.1, 0.9] {
+        let x = left + list[0] + list[2] * fraction;
+        let y = top + list[1] + list[3] * 0.5;
+        let point = [x - left, y - top, 0., 0.];
+        let inside = [menu, child].into_iter().any(|panel| {
+            point[0] >= panel[0]
+                && point[0] < panel[0] + panel[2]
+                && point[1] >= panel[1]
+                && point[1] < panel[1] + panel[3]
+        });
+        if !inside {
+            return Ok((x, y));
+        }
+    }
+    bail!("the list has no tested point outside both menu panels")
+}
+
+async fn journey(env: &Env, tab: &Tab) -> Result<Value> {
+    step(
+        "M376",
+        "keyboard opens a named child and Chrome exposes its state",
+    );
+    open(tab).await?;
+    let tree = ax_tree(tab).await?;
+    let parent = ax(&tree, "menuitem", "匯出選項")?;
+    check_eq!(
+        ax_property(parent, "hasPopup"),
+        Some(&json!("menu")),
+        "Chrome identifies the submenu row as a menu disclosure"
+    );
+    check_eq!(
+        ax_property(parent, "expanded"),
+        Some(&json!(false)),
+        "Chrome sees the closed child menu"
+    );
+    check!(
+        ax(&tree, "menu", "檔案動作").is_ok(),
+        "parent menu is named"
+    );
+    check!(
+        ax(&tree, "menu", "匯出選項").is_err(),
+        "child starts closed"
+    );
+
+    open_child(tab, "ArrowRight").await?;
+    let tree = ax_tree(tab).await?;
+    let parent = ax(&tree, "menuitem", "匯出選項")?;
+    check_eq!(
+        ax_property(parent, "expanded"),
+        Some(&json!(true)),
+        "Chrome sees the child open"
+    );
+    let child_menu = ax(&tree, "menu", "匯出選項")?;
+    check_eq!(
+        parent["parentId"],
+        child_menu["parentId"],
+        "the parent row and child menu are siblings in Chrome's accessibility tree"
+    );
+    ax(&tree, "menuitem", "匯出 PDF")?;
+    let disabled = ax(&tree, "menuitem", "匯出 CSV（無法使用）")?;
+    check_eq!(
+        ax_property(disabled, "disabled"),
+        Some(&json!(true)),
+        "the child action exposes its disabled state"
+    );
+    let mut report = screenshot_witness(tab).await?;
+    tab.screenshot(&env.artifact("material-command-menu-submenu.png"))
+        .await?;
+    report["parent"] = json!(parent);
+    report["child_items"] = json!(2);
+    report["keyboard"] = json!("ArrowRight");
+    Ok(report)
+}
+
+async fn pointer(tab: &Tab) -> Result<Value> {
+    step(
+        "M377",
+        "pointer opens the child and activates one enabled action once",
+    );
+    tab.press("Escape").await?;
+    until(
+        tab,
+        "s.menu_demo.open && s.menu_demo.active_submenu === null",
+    )
+    .await?;
+    focused(tab, SUBMENU_ROW).await?;
+    tab.press("Escape").await?;
+    until(tab, "!s.menu_demo.open").await?;
+    focused(tab, OPENER).await?;
+
+    open(tab).await?;
+    let [x, y, width, height] = bounds(tab, SUBMENU_ROW).await?;
+    let [left, top, _, _] = tab.canvas_box().await?;
+    tab.click(left + x + width * 0.5, top + y + height * 0.5)
+        .await?;
+    until(tab, "s.menu_demo.active_submenu === 'menu-demo-export'").await?;
+    let pointer_open_focus = focused_from_pointer(tab, PDF).await?;
+    check_eq!(
+        tab.eval(&format!(
+            "{}?.getAttribute('aria-expanded')",
+            projected(SUBMENU_ROW)
+        ))
+        .await?,
+        "true",
+        "the projected submenu row reports pointer opening"
+    );
+
+    let parent_panel = bounds(tab, MENU).await?;
+    let child_panel = bounds(tab, SUBMENU).await?;
+    let pdf = bounds(tab, PDF).await?;
+    let click_x = left + pdf[0] + pdf[2] * 0.5;
+    let click_y = top + pdf[1] + pdf[3] * 0.5;
+    check!(
+        click_x - left < parent_panel[0]
+            || click_x - left >= parent_panel[0] + parent_panel[2]
+            || click_y - top < parent_panel[1]
+            || click_y - top >= parent_panel[1] + parent_panel[3],
+        "the child action point is outside the parent panel box"
+    );
+    check!(
+        child_panel[0] + child_panel[2] <= parent_panel[0]
+            || child_panel[0] >= parent_panel[0] + parent_panel[2]
+            || child_panel[1] + child_panel[3] <= parent_panel[1]
+            || child_panel[1] >= parent_panel[1] + parent_panel[3],
+        "child panel extends beyond the parent panel bounds"
+    );
+
+    let before = state(tab).await?["menu_demo"]["commands_executed"]
+        .as_u64()
+        .unwrap_or(0);
+    let disabled = bounds(tab, DISABLED).await?;
+    tab.click(
+        left + disabled[0] + disabled[2] * 0.5,
+        top + disabled[1] + disabled[3] * 0.5,
+    )
+    .await?;
+    until(
+        tab,
+        "s.menu_demo.open && s.menu_demo.active_submenu === 'menu-demo-export'",
+    )
+    .await?;
+    check_eq!(
+        state(tab).await?["menu_demo"]["commands_executed"],
+        json!(before),
+        "the disabled child does not run"
+    );
+
+    tab.press("ArrowDown").await?;
+    let pointer_disabled_focus = focused_from_pointer(tab, DISABLED).await?;
+    tab.press("ArrowLeft").await?;
+    until(
+        tab,
+        "s.menu_demo.open && s.menu_demo.active_submenu === null",
+    )
+    .await?;
+    let pointer_return_focus = focused_from_pointer(tab, SUBMENU_ROW).await?;
+
+    let [x, y, width, height] = bounds(tab, SUBMENU_ROW).await?;
+    tab.click(left + x + width * 0.5, top + y + height * 0.5)
+        .await?;
+    until(tab, "s.menu_demo.active_submenu === 'menu-demo-export'").await?;
+    let pointer_reopen_focus = focused_from_pointer(tab, PDF).await?;
+
+    let parent_panel = bounds(tab, MENU).await?;
+    let pdf = bounds(tab, PDF).await?;
+    let click_x = left + pdf[0] + pdf[2] * 0.5;
+    let click_y = top + pdf[1] + pdf[3] * 0.5;
+    check!(
+        click_x - left < parent_panel[0]
+            || click_x - left >= parent_panel[0] + parent_panel[2]
+            || click_y - top < parent_panel[1]
+            || click_y - top >= parent_panel[1] + parent_panel[3],
+        "the trusted child action click is outside the parent panel box"
+    );
+    tab.click(click_x, click_y).await?;
+    until(
+        tab,
+        "!s.menu_demo.open && s.menu_demo.commands_executed === 1 && s.menu_demo.submenu_exported",
+    )
+    .await?;
+    let pointer_dismiss_focus = focused_from_pointer(tab, OPENER).await?;
+    check_eq!(
+        state(tab).await?["menu_demo"]["active_submenu"],
+        Value::Null,
+        "selection clears the submenu owner state"
+    );
+    Ok(
+        json!({"disabled_actions":0,"export_actions":1,"pointer_focus":{
+            "open":pointer_open_focus,"disabled":pointer_disabled_focus,"return":pointer_return_focus,
+            "reopen":pointer_reopen_focus,"dismiss":pointer_dismiss_focus,
+        }}),
+    )
+}
+
+async fn dismissal(tab: &Tab) -> Result<Value> {
+    step(
+        "M378",
+        "Escape closes one layer, Tab exits, and outside clicks do not pass through",
+    );
+    open(tab).await?;
+    open_child(tab, "ArrowRight").await?;
+    tab.press("Escape").await?;
+    until(
+        tab,
+        "s.menu_demo.open && s.menu_demo.active_submenu === null",
+    )
+    .await?;
+    focused(tab, SUBMENU_ROW).await?;
+    check_eq!(
+        tab.eval(&format!(
+            "{}?.getAttribute('aria-expanded')",
+            projected(SUBMENU_ROW)
+        ))
+        .await?,
+        "false",
+        "the parent row reports the child as closed"
+    );
+    tab.press("Escape").await?;
+    until(tab, "!s.menu_demo.open").await?;
+    focused(tab, OPENER).await?;
+
+    open(tab).await?;
+    open_child(tab, "ArrowRight").await?;
+    tab.press("Tab").await?;
+    until(tab, "!s.menu_demo.open").await?;
+    focused(tab, OUTSIDE).await?;
+
+    open(tab).await?;
+    open_child(tab, "ArrowRight").await?;
+    let (x, y) = outside_point(tab).await?;
+    tab.click(x, y).await?;
+    until(
+        tab,
+        "!s.menu_demo.open && s.menu_demo.outside_actions === 0",
+    )
+    .await?;
+    let outside_focus = focused_from_pointer(tab, OPENER).await?;
+    check_eq!(
+        state(tab).await?["menu_demo"]["active_submenu"],
+        Value::Null,
+        "outside dismissal clears the submenu owner state"
+    );
+    Ok(
+        json!({"escape_layers":2,"tab_target":OUTSIDE,"outside_action":0,
+        "outside_focus":outside_focus}),
+    )
+}
+
+async fn compact_dark_rtl(env: &Env, tab: &Tab) -> Result<Value> {
+    step(
+        "M379",
+        "dark RTL submenu opens on its logical trailing side at narrow width",
+    );
+    activate(tab, "menu-demo-theme").await?;
+    activate(tab, "menu-demo-rtl").await?;
+    until(tab, "s.dark && s.menu_demo.rtl").await?;
+    resize(tab, 320, 480).await?;
+    open(tab).await?;
+    open_child(tab, "ArrowLeft").await?;
+
+    let menu = bounds(tab, MENU).await?;
+    let child = bounds(tab, SUBMENU).await?;
+    check!(
+        contains([8., 8., 304., 464.], menu) && contains([8., 8., 304., 464.], child),
+        "both dark RTL panels fit the narrow safe viewport"
+    );
+    let tree = ax_tree(tab).await?;
+    let parent = ax(&tree, "menuitem", "匯出選項")?;
+    check_eq!(
+        ax_property(parent, "expanded"),
+        Some(&json!(true)),
+        "Chrome retains the expanded submenu state in RTL"
+    );
+    tab.press("ArrowRight").await?;
+    until(
+        tab,
+        "s.menu_demo.open && s.menu_demo.active_submenu === null",
+    )
+    .await?;
+    focused(tab, SUBMENU_ROW).await?;
+    open_child(tab, "ArrowLeft").await?;
+    let menu = bounds(tab, MENU).await?;
+    let child = bounds(tab, SUBMENU).await?;
+    check!(
+        contains([8., 8., 304., 464.], menu) && contains([8., 8., 304., 464.], child),
+        "both dark RTL panels fit the narrow safe viewport"
+    );
+    let mut report = screenshot_witness(tab).await?;
+    tab.screenshot(&env.artifact("material-command-menu-submenu-dark-rtl.png"))
+        .await?;
+    let count = state(tab).await?["menu_demo"]["commands_executed"]
+        .as_u64()
+        .unwrap_or(0);
+    tab.press("Enter").await?;
+    until(
+        tab,
+        &format!(
+            "!s.menu_demo.open && s.menu_demo.commands_executed === {}",
+            count + 1
+        ),
+    )
+    .await?;
+    report["viewport"] = json!([320, 480]);
+    report["dark"] = json!(true);
+    report["rtl"] = json!(true);
+    Ok(report)
+}
+
+pub(super) async fn run(env: &Env, chrome: &Chrome, url: &str) -> Result<()> {
+    let tab = chrome.page(1100, 1100, 2.0).await?;
+    route(&tab, url).await?;
+    let keyboard = journey(env, &tab).await?;
+    let pointer = pointer(&tab).await?;
+    let dismissal = dismissal(&tab).await?;
+    let compact = compact_dark_rtl(env, &tab).await?;
+    let report = json!({
+        "browser": chrome.version,
+        "steps": STEPS,
+        "keyboard": keyboard,
+        "pointer": pointer,
+        "dismissal": dismissal,
+        "compact": compact,
+        "state": state(&tab).await?["menu_demo"],
+        "errors": tab.errors(),
+    });
+    check!(
+        report["errors"].as_array().is_some_and(Vec::is_empty),
+        "browser errors: {}",
+        report["errors"]
+    );
+    env.write_json("browser-material-command-menu-submenus.json", &report)?;
+    Ok(())
+}
