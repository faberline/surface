+pub(super) fn place_submenu(
+    anchor: MenuAnchor,
+    preferred_size: (f32, f32),
+    direction: LayoutDirection,
+) -> Option<Rect> {
+    let fallback = place_menu(anchor, preferred_size, direction)?;
+    let safe = anchor.viewport.inset(VIEWPORT_INSET);
+    let trigger = anchor.trigger.intersect(anchor.viewport);
+    let right_start = trigger.x + trigger.width + ANCHOR_GAP;
+    let left_end = trigger.x - ANCHOR_GAP;
+    let right_room = safe.x + safe.width - right_start;
+    let left_room = left_end - safe.x;
+    let sides = match direction {
+        LayoutDirection::LeftToRight => [(true, right_room), (false, left_room)],
+        LayoutDirection::RightToLeft => [(false, left_room), (true, right_room)],
+    };
+    let width = preferred_size.0.clamp(MIN_WIDTH, MAX_WIDTH).min(safe.width);
+    let height = preferred_size.1.min(safe.height);
+    let last_y = (safe.y + safe.height - height).max(safe.y);
+    let y = trigger.y.clamp(safe.y, last_y);
+    let side = sides
+        .iter()
+        .find(|(_, room)| *room >= width)
+        .or_else(|| sides.iter().find(|(_, room)| *room >= MIN_WIDTH));
+    if let Some(&(right, room)) = side {
+        let width = width.min(room);
+        let x = if right { right_start } else { left_end - width };
+        Some(Rect::new(x, y, width, height))
+    } else {
+        Some(fallback.bounds)
+    }
+}
