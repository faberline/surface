diff --git a/crates/surface-app/tests/modal_submenu_support.rs b/crates/surface-app/tests/modal_submenu_support.rs
new file mode 100644
index 0000000..6b38ef4
--- /dev/null
+++ b/crates/surface-app/tests/modal_submenu_support.rs
@@ -0,0 +1,192 @@
+use surface::{Insets, Length, Node, Role, Style, TextMeasurer};
+use surface_app::{Application, Event, ModalDismissal, Runtime, View};
+
+#[derive(Clone, Copy)]
+enum Message {
+    Toggle,
+    OpenSubmenu,
+    CloseSubmenu,
+    Dismiss,
+    RunChild,
+}
+
+#[derive(Default)]
+struct App {
+    open: bool,
+    submenu_open: bool,
+    dismissal: ModalDismissal,
+    dismissals: usize,
+    child_activations: usize,
+}
+
+impl Application for App {
+    type Message = Message;
+
+    fn update(&mut self, message: Message) {
+        match message {
+            Message::Toggle => self.open = !self.open,
+            Message::OpenSubmenu => self.submenu_open = true,
+            Message::CloseSubmenu => self.submenu_open = false,
+            Message::Dismiss => {
+                self.open = false;
+                self.submenu_open = false;
+                self.dismissals += 1;
+            }
+            Message::RunChild => self.child_activations += 1,
+        }
+    }
+
+    fn view(&self) -> View<Message> {
+        let trigger = button("trigger", "Trigger", Message::Toggle, 32.);
+        let menu = self.open.then(|| {
+            let mut style = Style::column()
+                .width(Length::Px(180.))
+                .height(Length::Px(100.))
+                .fixed(Insets {
+                    left: Length::Px(100.),
+                    top: Length::Px(50.),
+                    ..Insets::default()
+                });
+            style.z_index = 10;
+            let submenu = View::new(
+                Node::new(Role::MenuItem, "More").id("submenu").styled(
+                    Style::row()
+                        .width(Length::Percent(1.))
+                        .height(Length::Px(40.)),
+                ),
+            )
+            .on_press_then_focus(Message::OpenSubmenu, "child");
+            let mut children = vec![submenu];
+            if self.submenu_open {
+                let child = button("child", "Child action", Message::RunChild, 40.);
+                children.push(
+                    View::new(Node::new(Role::Group, "Submenu rows").id("child-rows"))
+                        .children([child])
+                        .restore_focus_in_subtree_on_removal("submenu"),
+                );
+            }
+            let mut menu = View::new(Node::new(Role::Menu, "Commands").id("menu").styled(style))
+                .children(children)
+                .modal_overlay(Message::Dismiss)
+                .modal_dismissal(self.dismissal)
+                .modal_initial_focus("submenu")
+                .modal_focus_fallback("trigger");
+            if self.submenu_open {
+                menu = menu.modal_escape_with(Message::CloseSubmenu);
+            }
+            menu
+        });
+        View::new(Node::new(Role::Window, "Test").styled(Style::column()))
+            .children(std::iter::once(trigger).chain(menu))
+    }
+}
+
+fn button(id: &str, label: &str, message: Message, height: f32) -> View<Message> {
+    View::new(
+        Node::new(Role::Button, label)
+            .id(id)
+            .styled(Style::row().height(Length::Px(height))),
+    )
+    .on_press(message)
+}
+
+struct Metrics;
+
+impl TextMeasurer for Metrics {
+    fn measure(&mut self, _: &str, _: f32, _: Option<f32>) -> (f32, f32) {
+        (0., 0.)
+    }
+}
+
+fn render(runtime: &mut Runtime<App>) {
+    runtime.render(320., 240., &mut Metrics).unwrap();
+}
+
+fn open_menu() -> Runtime<App> {
+    let mut runtime = Runtime::new(App {
+        open: true,
+        ..App::default()
+    })
+    .unwrap();
+    render(&mut runtime);
+    runtime
+}
+
+#[test]
+fn activation_mounts_and_focuses_the_submenu_target() {
+    let mut runtime = open_menu();
+
+    assert!(runtime.activate("submenu").unwrap());
+    assert!(runtime.app().submenu_open);
+    assert_eq!(runtime.focused(), Some("child"));
+    assert_eq!(runtime.app().child_activations, 0);
+}
+
+#[test]
+fn pointer_activation_mounts_and_focuses_the_submenu_target() {
+    let mut runtime = open_menu();
+
+    assert!(runtime
+        .dispatch(Event::PointerDown { x: 120., y: 65. })
+        .unwrap());
+    assert!(runtime
+        .dispatch(Event::PointerUp { x: 120., y: 65. })
+        .unwrap());
+
+    assert!(runtime.app().submenu_open);
+    assert_eq!(runtime.focused(), Some("child"));
+    assert_eq!(runtime.app().child_activations, 0);
+}
+
+#[test]
+fn modal_escape_override_closes_child_before_generic_dismiss() {
+    let mut runtime = open_menu();
+    runtime.activate("submenu").unwrap();
+    assert_eq!(runtime.focused(), Some("child"));
+
+    assert!(runtime.dispatch(Event::Cancel).unwrap());
+    assert!(runtime.app().open);
+    assert!(!runtime.app().submenu_open);
+    assert_eq!(runtime.focused(), Some("submenu"));
+    assert_eq!(runtime.app().dismissals, 0);
+
+    assert!(runtime.dispatch(Event::Cancel).unwrap());
+    assert!(!runtime.app().open);
+    assert_eq!(runtime.focused(), Some("trigger"));
+    assert_eq!(runtime.app().dismissals, 1);
+}
+
+#[test]
+fn outside_press_still_uses_generic_dismiss_and_does_not_activate_trigger() {
+    let mut runtime = open_menu();
+    runtime.activate("submenu").unwrap();
+    render(&mut runtime);
+    let trigger = runtime.dom().by_id("trigger").unwrap();
+    let bounds = runtime.computed().unwrap().nodes[trigger.index()].bounds;
+    let (x, y) = (bounds.x + bounds.width / 2., bounds.y + bounds.height / 2.);
+
+    assert!(runtime.dispatch(Event::PointerDown { x, y }).unwrap());
+    assert!(runtime.dispatch(Event::PointerUp { x, y }).unwrap());
+
+    assert!(!runtime.app().open);
+    assert_eq!(runtime.app().dismissals, 1);
+    assert_eq!(runtime.focused(), Some("trigger"));
+}
+
+#[test]
+fn action_only_policy_blocks_the_custom_escape_message() {
+    let mut runtime = Runtime::new(App {
+        open: true,
+        submenu_open: true,
+        dismissal: ModalDismissal::ActionOnly,
+        ..App::default()
+    })
+    .unwrap();
+    render(&mut runtime);
+
+    // A modal Cancel is consumed even when its dismissal policy blocks it.
+    assert!(runtime.dispatch(Event::Cancel).unwrap());
+    assert!(runtime.app().open);
+    assert!(runtime.app().submenu_open);
+    assert_eq!(runtime.app().dismissals, 0);
+}
