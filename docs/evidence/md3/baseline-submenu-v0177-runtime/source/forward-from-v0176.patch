+use surface::{Color, Length, Node, Role, Style};
+use surface_app::{CursorStyle, EditKey, FocusNavigation, View};
+
+use super::{
+    command_menu_scope, desired_height, entry_height, entry_id, CommandMenuEntry, CommandMenuItem,
+    CommandMenuMeasurement, CommandMenuOptions, ICON_SIZE,
+};
+use crate::{
+    menu_layout::{place_menu, place_submenu, MIN_ITEM_HEIGHT},
+    shape::LayoutDirection,
+    vector_icon::chevron_contour,
+    Theme, VectorIcon,
+};
+
+/// A command, separator, or a row that opens a child menu.
+pub enum CommandMenuRow<'a, M> {
+    Entry(CommandMenuEntry<'a, M>),
+    Submenu(CommandMenuSubmenu<'a, M>),
+}
+
+/// One named child menu with flat command rows.
+pub struct CommandMenuSubmenu<'a, M> {
+    /// Stable ID of the row in the parent menu.
+    pub id: &'a str,
+    /// Stable ID of the child menu panel.
+    pub panel_id: &'a str,
+    /// Localized label of the parent row and its child menu.
+    pub label: &'a str,
+    pub leading_icon: Option<VectorIcon>,
+    pub preferred_width: f32,
+    pub entries: Vec<CommandMenuEntry<'a, M>>,
+    /// Measure with the panel ID and parent row ID on each animation frame.
+    pub measurement: &'a CommandMenuMeasurement,
+    /// The application sets `active_submenu` to this row ID.
+    pub on_open: M,
+    /// The application clears `active_submenu` and keeps the parent open.
+    pub on_close: M,
+}
+
+/// Options for a Baseline command menu with first-level submenus.
+pub struct CommandMenuWithSubmenusOptions<'a> {
+    pub menu: CommandMenuOptions<'a>,
+    /// The stable parent row ID of the one open child menu.
+    pub active_submenu: Option<&'a str>,
+}
+
+struct OpenSubmenu<M> {
+    panel: View<M>,
+    on_close: M,
+}
+
+impl Theme {
+    /// Build a Baseline menu with an optional child menu.
+    /// Down and Up stay within the current menu. The logical trailing arrow
+    /// opens a child, and the leading arrow or Escape returns to its row.
+    /// Tab and an outside click dismiss both menus through `on_dismiss`.
+    /// Command handlers decide when the application clears the open state.
+    pub fn command_menu_with_submenus<'a, M: Clone + 'static>(
+        &self,
+        options: CommandMenuWithSubmenusOptions<'_>,
+        trigger: View<M>,
+        rows: impl IntoIterator<Item = CommandMenuRow<'a, M>>,
+        on_dismiss: M,
+        measurement: &CommandMenuMeasurement,
+    ) -> View<M> {
+        let menu = options.menu;
+        let scope = command_menu_scope(menu.id);
+        let Some(anchor) = measurement.anchor().filter(|_| menu.open) else {
+            return scope.children([trigger.menu_expanded(false)]);
+        };
+        let rows: Vec<_> = rows.into_iter().collect();
+        let Some(first) = rows.iter().find_map(|row| match row {
+            CommandMenuRow::Entry(entry) => entry_id(entry),
+            CommandMenuRow::Submenu(submenu) => Some(submenu.id),
+        }) else {
+            return scope.children([trigger.menu_expanded(false)]);
+        };
+        let height = desired_height(
+            rows.iter().map(|row| match row {
+                CommandMenuRow::Entry(entry) => entry_height(entry),
+                CommandMenuRow::Submenu(_) => MIN_ITEM_HEIGHT,
+            }),
+            measurement,
+        );
+        let Some(layout) = place_menu(anchor, (menu.preferred_width, height), menu.direction)
+        else {
+            return scope.children([trigger.menu_expanded(false)]);
+        };
+        let mut on_escape = None;
+        let mut panel_rows = Vec::with_capacity(rows.len() + 1);
+        for row in rows {
+            match row {
+                CommandMenuRow::Entry(entry) => {
+                    panel_rows.push(self.flat_command_menu_row(entry, menu.direction));
+                }
+                CommandMenuRow::Submenu(submenu) => {
+                    let open = on_escape.is_none() && options.active_submenu == Some(submenu.id);
+                    let (row, child) = self.submenu_row(submenu, menu.direction, open);
+                    panel_rows.push(row);
+                    if let Some(child) = child {
+                        panel_rows.push(child.panel);
+                        on_escape = Some(child.on_close);
+                    }
+                }
+            }
+        }
+        let panel = self.command_menu_panel(&menu, panel_rows, layout.bounds);
+        let scope = scope
+            .children([trigger.menu_expanded(true), panel])
+            .modal_overlay_descendants(on_dismiss)
+            .modal_initial_focus(first)
+            .modal_focus_fallback(menu.restore_focus_to.unwrap_or(menu.trigger_id))
+            .dismiss_modal_on_tab();
+        if let Some(on_close) = on_escape {
+            scope.modal_escape_with(on_close)
+        } else {
+            scope
+        }
+    }
+
+    fn submenu_row<M: Clone + 'static>(
+        &self,
+        submenu: CommandMenuSubmenu<'_, M>,
+        direction: LayoutDirection,
+        open: bool,
+    ) -> (View<M>, Option<OpenSubmenu<M>>) {
+        let height = desired_height(
+            submenu.entries.iter().map(entry_height),
+            submenu.measurement,
+        );
+        let bounds = submenu
+            .measurement
+            .anchor()
+            .and_then(|anchor| place_submenu(anchor, (submenu.preferred_width, height), direction));
+        let target = submenu.entries.iter().find_map(entry_id);
+        let available = target.zip(bounds);
+        let item = CommandMenuItem {
+            id: submenu.id,
+            label: submenu.label,
+            leading_icon: submenu.leading_icon,
+            trailing_icon: None,
+            disabled: available.is_none(),
+            on_press: submenu.on_open,
+        };
+        let row = self.command_menu_item_view(&item, direction, Some(open && available.is_some()));
+        let Some((first, bounds)) = available else {
+            return (row.focus_disabled_menu_item(), None);
+        };
+        let (open_key, close_key) = match direction {
+            LayoutDirection::LeftToRight => (EditKey::Right, EditKey::Left),
+            LayoutDirection::RightToLeft => (EditKey::Left, EditKey::Right),
+        };
+        let first = first.to_owned();
+        let open_message = item.on_press.clone();
+        let row = row
+            .on_press_then_focus(item.on_press, first.clone())
+            .accessible_activation()
+            .suppress_repeated_activation()
+            .cursor(CursorStyle::Pointer)
+            .on_focus_navigation(move |key| {
+                (key == open_key).then(|| FocusNavigation {
+                    target: first.clone(),
+                    message: open_message.clone(),
+                })
+            });
+        let child = open.then(|| {
+            let options = CommandMenuOptions {
+                id: submenu.panel_id,
+                label: submenu.label,
+                trigger_id: submenu.id,
+                open: true,
+                direction,
+                preferred_width: submenu.preferred_width,
+                restore_focus_to: None,
+            };
+            let rows = submenu.entries.into_iter().map(|entry| {
+                let is_item = entry_id(&entry).is_some();
+                let row = self.flat_command_menu_row(entry, direction);
+                if is_item {
+                    let return_to = submenu.id.to_owned();
+                    let close = submenu.on_close.clone();
+                    row.on_focus_navigation(move |key| {
+                        (key == close_key).then(|| FocusNavigation {
+                            target: return_to.clone(),
+                            message: close.clone(),
+                        })
+                    })
+                } else {
+                    row
+                }
+            });
+            let panel = self.command_menu_panel(&options, rows, bounds);
+            OpenSubmenu {
+                panel: panel.restore_focus_in_subtree_on_removal(submenu.id),
+                on_close: submenu.on_close,
+            }
+        });
+        (row, child)
+    }
+}
+
+pub(super) fn chevron<M>(id: &str, direction: LayoutDirection, ink: Color) -> View<M> {
+    let angle = match direction {
+        LayoutDirection::LeftToRight => -90.,
+        LayoutDirection::RightToLeft => 90.,
+    };
+    let size = Length::Px(ICON_SIZE);
+    View::new(
+        Node::new(Role::Group, "")
+            .id(format!("{id}-trailing"))
+            .styled(Style::column().width(size).height(size))
+            .fill_contour(chevron_contour(ICON_SIZE, angle, ink).expect("valid chevron")),
+    )
+    .without_interaction(None)
+}
