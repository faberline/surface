+        );
+        assert_eq!(
+            node(&app, "group-separator").style().background,
+            theme.colors.outline_variant
+        );
+        let frame = app.accessibility_frame().unwrap();
+        for (key, role) in [
+            ("trigger", Role::Button),
+            ("commands", Role::Menu),
+            ("first", Role::MenuItem),
