{
  "endpoint_loopback": true,
  "capabilities": [
    "Devtools.capabilities",
    "DOM.snapshot",
    "DOM.query",
    "Action.activate",
    "Action.fill",
    "Action.setValue",
    "Action.key",
    "Page.screenshot"
  ],
  "activate_toggled": true,
  "bridge_coexists": true,
  "unauthorized_closes": true,
  "screenshot": {
    "format": "png",
    "width": 960,
    "height": 800,
    "scale": 1.0,
    "max_side": 400,
    "colors_match": true,
    "reflects_theme_change": true
  },
  "screenshot_transports_match": true,
  "cli_drove_the_app": true,
  "mcp_listed_and_called": true,
  "stale_session_exit_3": true,
  "normal_shutdown_removes_session": true,
  "existing_file_kept": true
}
