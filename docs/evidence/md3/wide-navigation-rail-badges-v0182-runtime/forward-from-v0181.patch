--- /dev/null
+++ b/examples/material-gallery/src/wide_navigation_badge_demo.rs
@@ -0,0 +1,347 @@
+use surface::{Align, Length, Node, Role, Style};
+use surface_app::View;
+use surface_material::{
+    shape::LayoutDirection, BadgeContent, ChoiceState, NavigationRailItem, Theme,
+    WideNavigationRailMode,
+};
+
+use crate::{rail_icons, scroll_field_demo::control_row, Message};
+
+pub(crate) const SECTION: usize = 1;
+const SHOW: &str = "wide-navigation-badges-demo-show";
+const BACK: &str = "wide-navigation-badges-demo-back";
+const ROOT: &str = "wide-navigation-badges-demo";
+const RAIL: &str = "wide-navigation-badges-demo-rail";
+const EXPAND: &str = "wide-navigation-badges-demo-expand";
+const THEME: &str = "wide-navigation-badges-demo-theme";
+const RTL: &str = "wide-navigation-badges-demo-rtl";
+const LARGE_TEXT: &str = "wide-navigation-badges-demo-large-text";
+const TITLE: &str = "wide-navigation-badges-demo-title";
+const PAGE: &str = "wide-navigation-badges-demo-page";
+const INBOX_COUNT: u32 = 1234;
+const DISABLED: usize = 4;
+const IDS: [&str; 5] = [
+    "wide-navigation-badges-demo-home",
+    "wide-navigation-badges-demo-inbox",
+    "wide-navigation-badges-demo-updates",
+    "wide-navigation-badges-demo-explore",
+    "wide-navigation-badges-demo-settings",
+];
+const LABELS: [&str; 5] = ["首頁", "收件匣", "最新消息", "探索路線", "設定"];
+const NAMES: [&str; 5] = [
+    "首頁",
+    "收件匣，1,234 則未讀",
+    "最新消息，有新內容",
+    "探索路線，有新內容",
+    "設定，無法使用",
+];
+const PAGES: [&str; 5] = [
+    "首頁內容",
+    "收件匣內容",
+    "最新消息內容",
+    "探索路線內容",
+    "設定內容",
+];
+
+#[derive(Clone, Copy)]
+pub enum WideNavigationBadgeEvent {
+    Show,
+    Back,
+    ToggleExpanded,
+    ToggleDirection,
+    ToggleLargeText,
+    ToggleTheme,
+    Select(usize),
+}
+
+pub(crate) struct WideNavigationBadgeDemo {
+    visible: bool,
+    width: f32,
+    expanded: bool,
+    rtl: bool,
+    large_text: bool,
+    dark: bool,
+    selected: usize,
+    activations: usize,
+    inbox_acknowledged: bool,
+}
+
+impl Default for WideNavigationBadgeDemo {
+    fn default() -> Self {
+        Self {
+            visible: false,
+            width: 960.,
+            expanded: false,
+            rtl: false,
+            large_text: false,
+            dark: false,
+            selected: 0,
+            activations: 0,
+            inbox_acknowledged: false,
+        }
+    }
+}
+
+impl WideNavigationBadgeDemo {
+    pub(crate) fn visible(&self) -> bool {
+        self.visible
+    }
+
+    pub(crate) fn leave(&mut self) {
+        self.visible = false;
+    }
+
+    pub(crate) fn viewport_changed(&mut self, width: f32) -> bool {
+        let changed = self.width != width;
+        self.width = width;
+        self.visible && changed
+    }
+
+    pub(crate) fn text_scale(&self) -> f32 {
+        if self.large_text {
+            2.
+        } else {
+            1.
+        }
+    }
+
+    pub(crate) fn update(&mut self, event: WideNavigationBadgeEvent) {
+        match event {
+            WideNavigationBadgeEvent::Show => self.visible = true,
+            WideNavigationBadgeEvent::Back => self.leave(),
+            WideNavigationBadgeEvent::ToggleExpanded => self.expanded = !self.expanded,
+            WideNavigationBadgeEvent::ToggleDirection => self.rtl = !self.rtl,
+            WideNavigationBadgeEvent::ToggleLargeText => self.large_text = !self.large_text,
+            WideNavigationBadgeEvent::ToggleTheme => self.dark = !self.dark,
+            WideNavigationBadgeEvent::Select(index) if index < IDS.len() && index != DISABLED => {
+                self.selected = index;
+                self.activations = self.activations.saturating_add(1);
+                if index == 1 {
+                    self.inbox_acknowledged = true;
+                }
+            }
+            WideNavigationBadgeEvent::Select(_) => {}
+        }
+    }
+
+    pub(crate) fn show_button(theme: &Theme) -> View<Message> {
+        theme
+            .button_with(
+                SHOW,
+                "寬導覽徽章",
+                surface_material::ButtonKind::Outlined,
+                false,
+                Message::WideNavigationBadge(WideNavigationBadgeEvent::Show),
+            )
+            .restore_focus_on_removal(BACK)
+            .accessible_activation()
+    }
+
+    fn badge(&self, index: usize) -> BadgeContent<'static> {
+        match index {
+            1 if !self.inbox_acknowledged => BadgeContent::Count(INBOX_COUNT),
+            2 => BadgeContent::Dot,
+            3 => BadgeContent::Label("新"),
+            _ => BadgeContent::Hidden,
+        }
+    }
+
+    fn accessible_name(&self, index: usize) -> &'static str {
+        if index == 1 && self.inbox_acknowledged {
+            "收件匣"
+        } else {
+            NAMES[index]
+        }
+    }
+
+    pub(crate) fn view(&self) -> View<Message> {
+        let theme = if self.dark {
+            Theme::dark()
+        } else {
+            Theme::light()
+        };
+        let direction = if self.rtl {
+            LayoutDirection::RightToLeft
+        } else {
+            LayoutDirection::LeftToRight
+        };
+        let event = Message::WideNavigationBadge;
+        let mode = if self.expanded {
+            WideNavigationRailMode::Expanded
+        } else {
+            WideNavigationRailMode::Collapsed
+        };
+        let header = theme.row([
+            theme
+                .tonal_button(BACK, "返回", event(WideNavigationBadgeEvent::Back))
+                .restore_focus_on_removal(SHOW)
+                .accessible_activation(),
+            theme.heading(TITLE, "寬軌徽章"),
+        ]);
+        let controls = control_row(vec![
+            theme
+                .segmented_button(
+                    THEME,
+                    "深色",
+                    choice(self.dark),
+                    event(WideNavigationBadgeEvent::ToggleTheme),
+                )
+                .accessible_activation(),
+            theme
+                .segmented_button(
+                    RTL,
+                    "右起",
+                    choice(self.rtl),
+                    event(WideNavigationBadgeEvent::ToggleDirection),
+                )
+                .accessible_activation(),
+            theme
+                .segmented_button(
+                    LARGE_TEXT,
+                    "大字",
+                    choice(self.large_text),
+                    event(WideNavigationBadgeEvent::ToggleLargeText),
+                )
+                .accessible_activation(),
+        ]);
+        let rail = theme.scrollable_wide_navigation_rail(
+            RAIL,
+            "工作區導覽",
+            mode,
+            Some(
+                theme
+                    .icon_button(
+                        EXPAND,
+                        if self.expanded {
+                            "收合導覽列"
+                        } else {
+                            "展開導覽列"
+                        },
+                        if self.rtl == self.expanded {
+                            "»"
+                        } else {
+                            "«"
+                        },
+                        surface_material::IconButtonKind::Standard,
+                        Some(self.expanded),
+                        false,
+                        event(WideNavigationBadgeEvent::ToggleExpanded),
+                    )
+                    .disclosure_expanded(self.expanded)
+                    .accessible_activation(),
+            ),
+            (0..IDS.len()).map(|index| {
+                let icon = match index {
+                    0 => rail_icons::Destination::Home.icon(),
+                    1 => rail_icons::Destination::Inbox.icon(),
+                    2 => rail_icons::search(),
+                    3 => rail_icons::more(),
+                    _ => rail_icons::Destination::Archive.icon(),
+                };
+                let item = NavigationRailItem {
+                    id: IDS[index],
+                    label: LABELS[index],
+                    accessible_name: self.accessible_name(index),
+                    icon,
+                    state: ChoiceState {
+                        selected: self.selected == index,
+                        disabled: index == DISABLED,
+                    },
+                    message: event(WideNavigationBadgeEvent::Select(index)),
+                };
+                theme
+                    .wide_navigation_rail_item_with_badge(mode, direction, item, self.badge(index))
+                    .accessibility_scroll_into_view()
+            }),
+        );
+        let content = View::new(
+            Node::new(Role::Group, "頁面內容")
+                .id("wide-navigation-badges-demo-content")
+                .styled(
+                    Style::column()
+                        .width(Length::Px(0.))
+                        .grow(1.)
+                        .align(Align::Start)
+                        .padding(16.)
+                        .gap(12.)
+                        .background(theme.colors.surface_container_low),
+                ),
+        )
+        .children([
+            theme.heading(PAGE, PAGES[self.selected]),
+            theme.text(
+                "wide-navigation-badges-demo-status",
+                format!("目前頁面：{}", LABELS[self.selected]),
+            ),
+        ]);
+        let mut body_node = Node::new(Role::Group, "").id("wide-navigation-badges-demo-layout");
+        let body_style = Style::row()
+            .width(Length::Percent(1.))
+            .height(Length::Px(0.))
+            .grow(1.)
+            .align(Align::Stretch)
+            .clip(true);
+        if self.rtl {
+            body_node = body_node.reverse_row();
+        }
+        body_node = body_node.styled(body_style);
+        let body = View::new(body_node).children([rail, content]);
+        View::new(
+            Node::new(Role::Window, "Material gallery").id(ROOT).styled(
+                Style::column()
+                    .width(Length::Percent(1.))
+                    .height(Length::Percent(1.))
+                    .gap(8.)
+                    .padding(8.)
+                    .background(theme.background)
+                    .foreground(theme.on_background)
+                    .clip(true),
+            ),
+        )
+        .children([header, controls, body])
+    }
+
+    #[cfg(target_arch = "wasm32")]
+    pub(crate) fn inspect(&self) -> serde_json::Value {
+        let theme = if self.dark {
+            Theme::dark()
+        } else {
+            Theme::light()
+        };
+        let names = (0..IDS.len())
+            .map(|index| self.accessible_name(index))
+            .collect::<Vec<_>>();
+        let badges = (0..IDS.len())
+            .map(|index| match self.badge(index) {
+                BadgeContent::Hidden => "hidden",
+                BadgeContent::Dot => "dot",
+                BadgeContent::Label(label) => label,
+                BadgeContent::Count(_) => "999+",
+            })
+            .collect::<Vec<_>>();
+        serde_json::json!({
+            "visible": self.visible,
+            "dark": self.dark,
+            "rtl": self.rtl,
+            "text_scale": self.text_scale(),
+            "preview_width": self.width,
+            "expanded": self.expanded,
+            "selected": IDS[self.selected],
+            "page": LABELS[self.selected],
+            "destinations": IDS,
+            "accessible_names": names,
+            "activations": self.activations,
+            "inbox_acknowledged": self.inbox_acknowledged,
+            "badges": badges,
+            "error_color": theme.colors.error,
+            "on_error_color": theme.colors.on_error,
+        })
+    }
+}
+
+fn choice(selected: bool) -> ChoiceState {
+    ChoiceState {
+        selected,
+        disabled: false,
+    }
+}
