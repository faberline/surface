+fn badge_bounds(paint: &ExtendedDisplayList, color: Color) -> Option<Rect> {
+    paint.ops().iter().find_map(|op| match op {
+        ExtendedPaintOp::Legacy(PaintOp::Shape {
+            rect, color: ink, ..
+        })
+        | ExtendedPaintOp::Legacy(PaintOp::Quad {
+            rect, color: ink, ..
+        }) if *ink == color => Some(*rect),
+        _ => None,
+    })
+}
+
+#[test]
+fn wide_rail_badges_are_decorative_localized_and_fit_the_same_destination() {
+    let mut fonts = TextSystem::default();
+    for mode in [
+        WideNavigationRailMode::Collapsed,
+        WideNavigationRailMode::Expanded,
+    ] {
+        for direction in [LayoutDirection::LeftToRight, LayoutDirection::RightToLeft] {
+            let mut app = Rail::new(mode, direction);
+            app.gallery_layout = true;
+            app.scale = 2.;
+            app.badged_id = INBOX;
+            if direction == LayoutDirection::RightToLeft {
+                app.theme = Theme::dark();
+            }
+            app.selected = 2;
+            let theme = app.theme;
+            let mut runtime = Runtime::new(app).unwrap();
+            let hidden = runtime.render_extended(960., 760., &mut fonts).unwrap();
+            let original_owner = bounds(&runtime, INBOX);
+            assert!(badge_bounds(&hidden, theme.colors.error).is_none());
+
+            for (badge, expected_text) in [
+                (BadgeContent::Dot, None),
+                (BadgeContent::Label("新"), Some("新")),
+                (BadgeContent::Count(7), Some("7")),
+                (BadgeContent::Count(1234), Some("999+")),
+            ] {
+                runtime.apply(Message::Badge(badge)).unwrap();
+                let paint = runtime.render_extended(960., 760., &mut fonts).unwrap();
+                let owner = bounds(&runtime, INBOX);
+                assert_eq!(owner, original_owner, "{mode:?} {direction:?} {badge:?}");
+                let badge_rect = badge_bounds(&paint, theme.colors.error).unwrap();
+                contains_rect(owner, badge_rect);
+                assert_eq!(
+                    badge_rect.height,
+                    if expected_text.is_some() { 32. } else { 6. }
+                );
+                if let Some(text) = expected_text {
+                    assert!(paint.ops().iter().any(|op| matches!(op,
+                        ExtendedPaintOp::Legacy(PaintOp::StyledText { text: visible, .. })
+                            if visible == text
+                    )));
+                }
+
+                let inbox = runtime.dom().by_id(INBOX).unwrap();
+                let frame = runtime.accessibility_frame().unwrap();
+                let node = frame.node(inbox).unwrap().node;
+                assert_eq!(node.role(), Role::Button);
+                assert_eq!(node.name(), "收件匣，1234 封未讀訊息");
+                assert_eq!(node.is_current_page(), Some(true));
+                assert!(frame.activation_target(inbox).is_some());
+                assert!(frame.children(inbox).next().is_none());
+                if badge == BadgeContent::Count(1234) {
+                    let decoration = runtime
+                        .dom()
+                        .iter()
+                        .find(|(_, node)| node.text_value() == Some("999+"))
+                        .unwrap()
+                        .0;
+                    assert!(frame.node(decoration).is_none());
+                    assert!(frame.activation_target(decoration).is_none());
+                    assert!(frame.focus_target(decoration).is_none());
+                }
+
+                if mode == WideNavigationRailMode::Expanded {
+                    let (label_box, _, _, _) = label(&paint, GALLERY_LABEL);
+                    let overlap = badge_rect.intersect(label_box);
+                    assert!(
+                        overlap.width == 0. || overlap.height == 0.,
+                        "{direction:?} {badge:?}: badge {badge_rect:?}, label {label_box:?}"
+                    );
+                }
+
+                if badge == BadgeContent::Count(1234) {
+                    let x = badge_rect.x + badge_rect.width * 0.5;
+                    let y = badge_rect.y + badge_rect.height * 0.5;
+                    runtime.dispatch(Event::PointerDown { x, y }).unwrap();
+                    runtime.dispatch(Event::PointerUp { x, y }).unwrap();
+                    assert_eq!(runtime.app().actions, 1);
+                    assert_eq!(runtime.app().selected, 2);
+                }
+            }
+
+            runtime.apply(Message::Badge(BadgeContent::Hidden)).unwrap();
+            runtime.render_extended(960., 760., &mut fonts).unwrap();
+            let frame = runtime.accessibility_frame().unwrap();
+            assert_eq!(
+                frame
+                    .node(runtime.dom().by_id(INBOX).unwrap())
+                    .unwrap()
+                    .node
+                    .name(),
+                "收件匣"
+            );
+            assert_eq!(bounds(&runtime, INBOX), original_owner);
+        }
+    }
+}
