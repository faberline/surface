diff --git a/e2e/src/material_wide_navigation_badges.rs b/e2e/src/material_wide_navigation_badges.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c85b10640c04de221378bd969e872047bee0b738
--- /dev/null
+++ b/e2e/src/material_wide_navigation_badges.rs
@@ -0,0 +1,393 @@
+//! Headless WebGPU proof for badges on collapsed and expanded wide rail destinations.
+
+use anyhow::{Context, Result};
+use serde_json::{json, Value};
+
+use super::material_time_input::{
+    activate, ax, ax_property, ax_tree, bounds, contains, focus_projected, focused, near,
+    projected, resize, Raster,
+};
+use super::{click, state, until};
+use crate::browser::{js, Chrome, Tab};
+use crate::check::step;
+use crate::{check, check_eq, Env};
+
+pub(super) const STEPS: [&str; 2] = ["M387", "M388"];
+const SHOW: &str = "wide-navigation-badges-demo-show";
+const BACK: &str = "wide-navigation-badges-demo-back";
+const TITLE: &str = "wide-navigation-badges-demo-title";
+const EXPAND: &str = "wide-navigation-badges-demo-expand";
+const THEME: &str = "wide-navigation-badges-demo-theme";
+const RTL: &str = "wide-navigation-badges-demo-rtl";
+const LARGE: &str = "wide-navigation-badges-demo-large-text";
+const RAIL: &str = "wide-navigation-badges-demo-rail";
+const HOME: &str = "wide-navigation-badges-demo-home";
+const INBOX: &str = "wide-navigation-badges-demo-inbox";
+const UPDATES: &str = "wide-navigation-badges-demo-updates";
+const EXPLORE: &str = "wide-navigation-badges-demo-explore";
+const SETTINGS: &str = "wide-navigation-badges-demo-settings";
+const IDS: [&str; 5] = [HOME, INBOX, UPDATES, EXPLORE, SETTINGS];
+const NAMES: [&str; 5] = [
+    "首頁",
+    "收件匣，1,234 則未讀",
+    "最新消息，有新內容",
+    "探索路線，有新內容",
+    "設定，無法使用",
+];
+const INBOX_NAME: &str = "收件匣";
+const STEM: &str = "material-wide-navigation-badges";
+type Rect = [f64; 4];
+type Rgb = [u8; 3];
+
+async fn ready(tab: &Tab, condition: &str) -> Result<()> {
+    until(
+        tab,
+        &format!("(d => d?.visible && ({condition}))(s.wide_navigation_badges)"),
+    )
+    .await
+}
+
+async fn current(tab: &Tab, id: &str, activations: usize) -> Result<()> {
+    ready(
+        tab,
+        &format!(
+            "d.selected === {} && d.activations === {activations}",
+            js(id)
+        ),
+    )
+    .await?;
+    tab.wait_for(&format!(
+        "{}?.getAttribute('aria-current') === 'page' &&
+         document.querySelectorAll('#surface-accessibility [aria-current=page]').length === 1",
+        projected(id)
+    ))
+    .await
+}
+
+fn pixels(image: &Raster, rect: Rect, color: Rgb, tolerance: u8) -> Result<usize> {
+    Ok(image
+        .colors(rect)?
+        .iter()
+        .filter(|(actual, _)| {
+            actual
+                .iter()
+                .zip(color)
+                .all(|(a, b)| a.abs_diff(b) <= tolerance)
+        })
+        .map(|(_, count)| count)
+        .sum())
+}
+
+fn rgb(value: &Value) -> Result<Rgb> {
+    let [r, g, b, alpha]: [u8; 4] = serde_json::from_value(value.clone())?;
+    check_eq!(alpha, 255, "sampled ink token is opaque");
+    Ok([r, g, b])
+}
+
+async fn accessibility(tab: &Tab, acknowledged: bool) -> Result<Value> {
+    let tree = ax_tree(tab).await?;
+    let rail = ax(&tree, "navigation", "工作區導覽")?;
+    let mut items = Vec::new();
+    for (index, (id, name)) in IDS.iter().zip(NAMES).enumerate() {
+        let name = if *id == INBOX && acknowledged {
+            INBOX_NAME
+        } else {
+            name
+        };
+        let node = ax(&tree, "button", name)?;
+        let disabled = ax_property(node, "disabled")
+            .and_then(Value::as_bool)
+            .unwrap_or(false);
+        check_eq!(disabled, index == 4, "{id} exposes its disabled state");
+        items.push(json!({"id":id,"name":name,"disabled":disabled}));
+    }
+    check!(
+        tree.iter()
+            .all(|node| node["ignored"] == true || node["name"]["value"] != "999+"),
+        "decorative badge text is not announced separately"
+    );
+    Ok(json!({"landmark":rail["name"]["value"],"items":items}))
+}
+
+async fn owned_label(tab: &Tab, id: &str, text: &str, owner: Rect) -> Result<(Rect, Rgb)> {
+    let data = tab
+        .eval(&format!(
+            "(() => {{
+                const {{dom,layout}} = JSON.parse(window.gallery.export_dom());
+                const nodes = dom.nodes;
+                const owner = nodes.findIndex(n => n.stable_id === {});
+                const index = nodes.findIndex(n => {{
+                    if (n.text !== {}) return false;
+                    for (let i = n.parent; Number.isInteger(i); i = nodes[i].parent) {{
+                        if (i === owner) return true;
+                    }}
+                    return false;
+                }});
+                if (index < 0) return null;
+                const {{x,y,width,height}} = layout.nodes[index].bounds;
+                return {{bounds:[x,y,width,height],ink:nodes[index].style.foreground}};
+            }})()",
+            js(id),
+            js(text),
+        ))
+        .await?;
+    let rect: Rect = serde_json::from_value(data["bounds"].clone())
+        .with_context(|| format!("{text} label bounds inside {id}"))?;
+    check!(contains(owner, rect), "{text} label stays inside {id}");
+    Ok((rect, rgb(&data["ink"])?))
+}
+
+async fn capture(
+    env: &Env,
+    tab: &Tab,
+    label: &str,
+    expanded: bool,
+    rtl: bool,
+    acknowledged: bool,
+) -> Result<Value> {
+    let canvas = tab.canvas_box().await?;
+    let viewport: Rect = [0., 0., canvas[2], canvas[3]];
+    let rail = bounds(tab, RAIL).await?;
+    check!(
+        contains(viewport, rail),
+        "rail is inside the canvas: {rail:?}"
+    );
+    let width = rail[2];
+    if expanded {
+        check!(
+            (219.25..=360.75).contains(&width),
+            "expanded rail width follows the 220–360 dp range: {width}"
+        );
+    } else {
+        check!(near(width, 96.), "collapsed rail width is 96 dp: {width}");
+    }
+    let layout = bounds(tab, "wide-navigation-badges-demo-layout").await?;
+    let start = if rtl {
+        layout[0] + layout[2] - width
+    } else {
+        layout[0]
+    };
+    check!(near(rail[0], start), "rail follows logical start");
+    check!(
+        contains(viewport, bounds(tab, TITLE).await?),
+        "gallery title is inside the canvas"
+    );
+
+    let demo = &state(tab).await?["wide_navigation_badges"];
+    let fill = rgb(&demo["error_color"])?;
+    let filename = format!("{STEM}-{label}.png");
+    let path = env.artifact(&filename);
+    tab.settle().await?;
+    tab.screenshot(&path).await?;
+    let image = Raster::read(tab, path).await?;
+    let mut owners = Vec::new();
+    for (index, id) in IDS.iter().copied().enumerate() {
+        let owner = bounds(tab, id).await?;
+        check!(
+            contains(rail, owner) && owner[2] >= 48. && owner[3] >= 48.,
+            "destination {id} remains usable and inside the rail: {owner:?}"
+        );
+        let face = pixels(&image, owner, fill, 8)?;
+        if index == 0 || index == 4 || (index == 1 && acknowledged) {
+            check_eq!(face, 0, "{id} with a hidden badge has no Error pixels");
+        } else {
+            let minimum = if index == 2 { 8 } else { 30 };
+            check!(
+                face >= minimum,
+                "visible badge paints inside {id}: {face} pixels"
+            );
+        }
+        owners.push(json!({"id":id,"bounds":owner,"error_pixels":face}));
+    }
+    let count_ink = if acknowledged {
+        Value::Null
+    } else {
+        let (bounds, ink) = owned_label(tab, INBOX, "999+", bounds(tab, INBOX).await?).await?;
+        check_eq!(
+            ink,
+            rgb(&demo["on_error_color"])?,
+            "count text uses the On Error token"
+        );
+        let visible = pixels(&image, bounds, ink, 8)?;
+        check!(
+            visible >= 4,
+            "the abbreviated count paints visible ink: {visible} pixels"
+        );
+        json!({"bounds":bounds,"ink":ink,"pixels":visible})
+    };
+    let mut inbox_label = Value::Null;
+    if expanded {
+        let (bounds, ink) = owned_label(tab, INBOX, INBOX_NAME, bounds(tab, INBOX).await?).await?;
+        let visible = pixels(&image, bounds, ink, 12)?;
+        check!(
+            visible >= 10,
+            "expanded Inbox label glyphs remain visible: {visible} pixels"
+        );
+        inbox_label = json!({"bounds":bounds,"ink":ink,"pixels":visible});
+    }
+    Ok(json!({
+        "canvas":canvas,"rail":rail,"expanded":expanded,"rtl":rtl,
+        "owners":owners,"inbox_label":inbox_label,"count_ink":count_ink,"error":fill,
+        "screenshot":filename,"accessibility":accessibility(tab, acknowledged).await?,
+    }))
+}
+
+async fn short_collapsed(tab: &Tab) -> Result<Value> {
+    activate(tab, EXPAND).await?;
+    ready(tab, "!d.expanded").await?;
+    resize(tab, 320, 720).await?;
+    let scroll = "wide-navigation-badges-demo-rail-scroll";
+    let clip = bounds(tab, scroll).await?;
+    let page_id = "wide-navigation-badges-demo-page";
+    let page = bounds(tab, page_id).await?;
+    let before = bounds(tab, EXPLORE).await?;
+    check!(
+        !contains(clip, before),
+        "large text needs a short collapsed scroll area"
+    );
+    focus_projected(tab, HOME).await?;
+    for target in [INBOX, UPDATES, EXPLORE] {
+        tab.press("ArrowDown").await?;
+        focused(tab, target).await?;
+        current(tab, HOME, 0).await?;
+    }
+    let revealed = bounds(tab, EXPLORE).await?;
+    check!(
+        contains(clip, revealed) && revealed[1] < before[1],
+        "arrow focus reveals the destination inside the short rail"
+    );
+    check_eq!(
+        bounds(tab, page_id).await?,
+        page,
+        "rail scroll preserves the page layout"
+    );
+    let scroll_offset = tab
+        .eval(&format!(
+            "JSON.parse(window.gallery.export_dom()).dom.nodes
+         .find(node => node.stable_id === {})?.style.scroll_y",
+            js(scroll)
+        ))
+        .await?;
+    check!(
+        scroll_offset.as_f64().is_some_and(|offset| offset > 0.),
+        "only the short rail scrolls to reveal its destination"
+    );
+    resize(tab, 840, 1000).await?;
+    activate(tab, EXPAND).await?;
+    ready(tab, "d.expanded").await?;
+    Ok(
+        json!({"clip":clip,"before":before,"revealed":revealed,"page":page,
+        "focus":EXPLORE,"scroll_offset":scroll_offset}),
+    )
+}
+
+pub(super) async fn run(env: &Env, chrome: &Chrome, url: &str) -> Result<()> {
+    let tab = chrome.page(960, 1300, 2.).await?;
+    tab.goto(url).await?;
+    crate::smoke::ready(&tab, "gallery").await?;
+    resize(&tab, 960, 1800).await?;
+    activate(&tab, "section-1").await?;
+    until(&tab, "s.section === 1").await?;
+    activate(&tab, SHOW).await?;
+    ready(
+        &tab,
+        "!d.expanded && !d.dark && !d.rtl && d.text_scale === 1",
+    )
+    .await?;
+    focused(&tab, BACK).await?;
+
+    step(
+        STEPS[0],
+        "Wide rail badges stay within collapsed and expanded light destinations",
+    );
+    resize(&tab, 840, 720).await?;
+    current(&tab, HOME, 0).await?;
+    let collapsed = capture(env, &tab, "collapsed-light", false, false, false).await?;
+    activate(&tab, EXPAND).await?;
+    ready(&tab, "d.expanded").await?;
+    current(&tab, HOME, 0).await?;
+    focused(&tab, EXPAND).await?;
+    let expanded = capture(env, &tab, "expanded-light", true, false, false).await?;
+    check_eq!(
+        state(&tab).await?["wide_navigation_badges"]["destinations"],
+        json!(IDS),
+        "collapse and expand keep destination IDs"
+    );
+
+    step(
+        STEPS[1],
+        "Dark RTL large text preserves keyboard routing and clears the acknowledged badge",
+    );
+    activate(&tab, THEME).await?;
+    activate(&tab, RTL).await?;
+    activate(&tab, LARGE).await?;
+    ready(&tab, "d.dark && d.rtl && d.text_scale === 2").await?;
+    let compact = short_collapsed(&tab).await?;
+    resize(&tab, 420, 720).await?;
+    let dark = capture(env, &tab, "expanded-dark-rtl-200", true, true, false).await?;
+    activate(&tab, HOME).await?;
+    current(&tab, HOME, 1).await?;
+    focused(&tab, HOME).await?;
+    tab.press("ArrowDown").await?;
+    focused(&tab, INBOX).await?;
+    current(&tab, HOME, 1).await?;
+    let before_resize = state(&tab).await?["wide_navigation_badges"]["page"].clone();
+    resize(&tab, 430, 720).await?;
+    focused(&tab, INBOX).await?;
+    current(&tab, HOME, 1).await?;
+    check_eq!(
+        state(&tab).await?["wide_navigation_badges"]["page"],
+        before_resize,
+        "resizing retains the current page"
+    );
+    resize(&tab, 420, 720).await?;
+    focused(&tab, INBOX).await?;
+    tab.press("Enter").await?;
+    current(&tab, INBOX, 2).await?;
+    focused(&tab, INBOX).await?;
+    ready(&tab, "d.inbox_acknowledged").await?;
+    let acknowledged = capture(env, &tab, "acknowledged", true, true, true).await?;
+    check_eq!(
+        dark["owners"][1]["bounds"],
+        acknowledged["owners"][1]["bounds"],
+        "acknowledgement retains the hit target"
+    );
+    tab.press("ArrowDown").await?;
+    focused(&tab, UPDATES)
+        .await
+        .context("keyboard focus moves to Updates in the accessibility tree")?;
+    tab.press("ArrowDown").await?;
+    focused(&tab, EXPLORE).await?;
+    tab.press("ArrowDown").await?;
+    check!(
+        state(&tab).await?["focused"] != SETTINGS,
+        "arrows skip the disabled item"
+    );
+
+    click(&tab, SETTINGS).await?;
+    tab.settle().await?;
+    current(&tab, INBOX, 2).await?;
+    click(&tab, UPDATES).await?;
+    current(&tab, UPDATES, 3).await?;
+    check_eq!(
+        state(&tab).await?["focused"],
+        UPDATES,
+        "a pointer activation focuses Updates in Surface while Chrome may focus the canvas"
+    );
+
+    activate(&tab, BACK).await?;
+    until(&tab, "s.section === 1 && !s.wide_navigation_badges.visible").await?;
+    focused(&tab, SHOW).await?;
+    env.write_json(
+        "browser-material-wide-navigation-badges.json",
+        &json!({"browser":chrome.version,"steps":STEPS,"collapsed_light":collapsed,
+                "expanded_light":expanded,"collapsed_scroll":compact,"dark":dark,"acknowledged":acknowledged,
+                "errors":tab.errors()}),
+    )?;
+    check!(
+        tab.errors().is_empty(),
+        "page errors: {}",
+        tab.errors().join("\n")
+    );
+    Ok(())
+}
