+#[test]
+fn a_scaled_badge_keeps_the_collapsed_icon_below_its_face() {
+    let mut fonts = TextSystem::default();
+    for direction in [LayoutDirection::LeftToRight, LayoutDirection::RightToLeft] {
+        let mut app = Rail::new(WideNavigationRailMode::Collapsed, direction);
+        app.scale = 2.;
+        app.badged_id = INBOX;
+        app.selected = 2;
+        let theme = app.theme;
+        let mut runtime = Runtime::new(app).unwrap();
+        runtime.render_extended(320., 720., &mut fonts).unwrap();
+        let owner = bounds(&runtime, INBOX);
+
+        runtime
+            .apply(Message::Badge(BadgeContent::Count(1234)))
+            .unwrap();
+        let paint = runtime.render_extended(320., 720., &mut fonts).unwrap();
+        assert_eq!(bounds(&runtime, INBOX), owner);
+        let face = badge_bounds(&paint, theme.colors.error).unwrap();
+        let ink = paint
+            .ops()
+            .iter()
+            .find_map(|entry| match entry {
+                ExtendedPaintOp::FillPath(path)
+                    if path.color() == theme.colors.on_secondary_container
+                        && owner.intersect(path.rect()) == path.rect() =>
+                {
+                    Some(path.rect())
+                }
+                _ => None,
+            })
+            .unwrap();
+        let covered = face.intersect(ink);
+        assert!(
+            covered.height <= 4.,
+            "{direction:?}: badge {face:?}, icon ink {ink:?}"
+        );
+    }
+}
