+        assert!(field.y > bounds(&runtime, "project-name-above-label").y);
+        assert!(count.y >= help.y + help.height + 4.);
+        assert!(count.x < body.x + body.width / 2.);
+        assert!(action.y >= count.y + count.height + 4.);
+        assert_eq!(action.x, field.x);
