+    struct Editor {
+        centered: bool,
+        multiline: bool,
+    }
+    impl Application for Editor {
+        type Message = ();
+        fn update(&mut self, _: ()) {}
+        fn view(&self) -> View<()> {
+            let field = View::new(
+                Node::new(Role::TextInput, "Query")
+                    .id("query")
+                    .text("ab")
+                    .styled(
+                        Style::column()
+                            .height(Length::Px(48.))
+                            .font_size(16.)
+                            .line_height(24.),
+                    ),
+            )
+            .on_input(|_| ())
+            .text_options(TextOptions {
+                multiline: self.multiline,
+                ..TextOptions::default()
+            });
