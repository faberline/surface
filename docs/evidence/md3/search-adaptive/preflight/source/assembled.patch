+const SHOW: &str = "search-overlay-demo-show";
+const BACK: &str = "search-overlay-demo-route-back";
+const OPENER: &str = "search-overlay-demo-opener";
+const ANCHOR: &str = "search-overlay-demo-anchor";
+
+struct Document {
+    id: &'static str,
+    title: &'static str,
+    details: &'static str,
+    disabled: bool,
+}
+
+const DOCUMENTS: &[Document] = &[
+    Document {
