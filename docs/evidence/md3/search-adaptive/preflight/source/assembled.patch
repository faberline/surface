+    Document {
+        id: "search-doc-palette",
+        title: "配色驗證",
+        details: "深色與提高對比",
+        disabled: false,
+    },
+    Document {
+        id: "search-doc-localization",
+        title: "語系設計",
+        details: "字型與右起版面",
+        disabled: false,
+    },
+    Document {
+        id: "search-doc-gesture",
+        title: "觸控驗收",
+        details: "按壓與捲動",
+        disabled: false,
+    },
+    Document {
+        id: "search-doc-guide",
+        title: "開發指南",
+        details: "元件接線範例",
+        disabled: false,
+    },
+    Document {
+        id: "search-doc-notes",
