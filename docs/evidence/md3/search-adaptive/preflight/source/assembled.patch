+        assert_eq!((caret.y, caret.height), (inset, 24.));
+        assert!(paint.ops.iter().any(|op| matches!(op, PaintOp::StyledText {
+            rect, scroll, editable: true, ..
+        } if *rect == bounds && rect.y - scroll.1 == caret.y)));
+    }
