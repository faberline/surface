diff --git a/examples/material-gallery/src/search_overlay_demo.rs b/examples/material-gallery/src/search_overlay_demo.rs
new file mode 100644
--- /dev/null
+++ b/examples/material-gallery/src/search_overlay_demo.rs
@@ -0,0 +1,603 @@
+use surface::{Align, Length, Node, Rect, Role, Style};
+use surface_app::{AnimationFrame, AnimationUpdate, View};
+use surface_material::{
+    shape::{self, LayoutDirection},
+    ButtonKind, ChoiceState, ListItem, ListLines, ListMode, ListOptions, ListStyle,
+    SearchOverlayContent, SearchOverlayOptions, SearchStyle, Theme,
+};
+
+use crate::{scroll_field_demo::control_row, Message};
