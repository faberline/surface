@@ -0,0 +1,290 @@
+//! Controlled Material Search overlay. The caller owns the query and results.
+
+use surface::{Align, Color, Insets, Length, Node, Rect, Role, Style, TextScaling};
+use surface_app::{CursorStyle, TextAction, View};
+
+use crate::{
+    search_layout::{plan_search_layout, SearchLayout, SearchPresentation, SearchStyle},
+    shape::{self, LayoutDirection},
+    typography, IconButtonKind, Theme,
+};
+
+const TOUCH_TARGET: f32 = 48.;
+const CONTROL_GAP: f32 = 4.;
+const MIN_EDITOR_WIDTH: f32 = 24.;
+
+/// Accessible labels, state and geometry for [Theme::search_overlay].
+#[derive(Clone, Copy, Debug)]
+pub struct SearchOverlayOptions<'a> {
+    /// Unique, stable prefix for the editor and overlay controls.
+    pub id: &'a str,
+    pub open: bool,
+    pub title: &'a str,
+    pub input_label: &'a str,
+    pub results_label: &'a str,
+    pub back_label: &'a str,
+    pub clear_label: &'a str,
+    pub query: &'a str,
+    pub style: SearchStyle,
+    pub direction: LayoutDirection,
+    /// Safe area in window coordinates. Recompute it after a resize.
+    pub viewport: Rect,
+    /// The caller's stable resting bar allocation before margins. Leave it
+    /// absent until measured, or when the overlay always fills the viewport.
+    pub anchor: Option<Rect>,
+    /// The preferred outer height when docked. `None` uses the available room.
+    pub preferred_docked_height: Option<f32>,
+    /// A fallback when the original focus target vanishes while Search is open.
+    pub restore_focus_to: Option<&'a str>,
+    /// Localized result count or empty-state announcement. Place any visible
+    /// empty-state content in the results slot.
+    pub results_status: Option<&'a str>,
+}
+
+/// Caller-authored result views and search actions.
+pub struct SearchOverlayContent<M> {
+    /// A results or suggestions view with stable IDs for interactive children.
+    /// It may contain a roving group for result arrow navigation.
+    pub results: View<M>,
+    pub on_submit: M,
+    pub on_clear: M,
+    pub on_close: M,
+}
+
+impl Theme {
+    /// Render the controlled open Search overlay as a sibling of page content.
+    ///
+    /// Docked and Full-screen share `{id}-dialog`, `{id}-input`, and
+    /// `{id}-results`. Keep these IDs and the authored query across resizes
+    /// to retain editing state, focus, and scroll where the new viewport fits.
+    /// The modal initially focuses the editor and returns focus on dismissal.
+    ///
+    /// Plain Enter in the editor sends `on_submit` after IME composition.
+    /// Clear sends `on_clear`. Back, unhandled Escape, and backdrop dismissal
+    /// send `on_close`. Render the caller's new model on the next rebuild.
+    pub fn search_overlay<M: Clone + 'static>(
+        &self,
+        options: SearchOverlayOptions<'_>,
+        content: SearchOverlayContent<M>,
+        on_query: impl Fn(String) -> M + 'static,
+    ) -> Option<View<M>> {
+        if !options.open {
+            return None;
+        }
+        let layout = plan_search_layout(
+            options.viewport,
+            options.anchor,
+            options.style,
+            options.direction,
+            options.preferred_docked_height,
+        )?;
+        let SearchOverlayContent {
+            results,
+            on_submit,
+            on_clear,
+            on_close,
+        } = content;
+        let id = |suffix| format!("{}-{suffix}", options.id);
+        let input_id = id("input");
+        let docked = layout.presentation == SearchPresentation::Docked;
+        let divided = options.style == SearchStyle::Divided;
+        let panel_style = placed(Style::column(), layout.bounds, Rect::default()).background(
+            match (docked, divided) {
+                (true, true) => self.colors.surface_container_high,
+                (true, false) => Color::TRANSPARENT,
+                _ => self.colors.surface_container_low,
+            },
+        );
+        let panel_style = if docked && divided {
+            panel_style.corners(shape::EXTRA_LARGE)
+        } else {
+            panel_style
+        };
+        let panel = Node::new(Role::Dialog, options.title)
+            .id(id("dialog"))
+            .tab_index(-1)
+            .focus_color(Color::TRANSPARENT)
+            .styled(panel_style);
+
+        let bar = search_bar(
+            self,
+            options,
+            layout,
+            on_query,
+            on_submit,
+            on_clear,
+            on_close.clone(),
+        );
+        let mut children = vec![bar];
+        if let Some(divider) = layout.divider {
+            children.push(View::new(
+                Node::new(Role::Separator, "").id(id("divider")).styled(
+                    placed(Style::column(), divider, layout.bounds)
+                        .background(self.colors.outline_variant),
+                ),
+            ));
+        }
+
+        let results_view = View::new(
+            Node::new(Role::Group, options.results_label)
+                .id(id("results"))
+                .styled(
+                    placed(
+                        Style::column(),
+                        layout.results_viewport,
+                        layout.results_surface,
+                    )
+                    .clip(true),
+                ),
+        )
+        .children([results.restore_focus_in_subtree_on_removal(&input_id)])
+        .accessibility_scroll_pages();
+        let surface = placed(Style::column(), layout.results_surface, layout.bounds);
+        let surface = if docked && !divided {
+            surface
+                .background(self.colors.surface_container_high)
+                .corners(shape::SMALL)
+        } else {
+            surface
+        };
+        children.push(
+            View::new(
+                Node::new(Role::Group, "")
+                    .id(id("results-surface"))
+                    .styled(surface),
+            )
+            .children([results_view]),
+        );
+        if let Some(status) = options.results_status {
+            // Keep announcements projected if the results are scrolled away.
+            children.push(View::new(
+                Node::new(Role::Status, status)
+                    .id(id("status"))
+                    .styled(placed(
+                        Style::column(),
+                        Rect::new(layout.bounds.x, layout.bounds.y, 1., 1.),
+                        layout.bounds,
+                    )),
+            ));
+        }
+
+        let mut panel = View::new(panel)
+            .children(children)
+            .modal_initial_focus(input_id);
+        if let Some(target) = options.restore_focus_to {
+            panel = panel.modal_focus_fallback(target);
+        }
+        let Color(red, green, blue, _) = self.colors.scrim;
+        let mut backdrop = Style::column().fixed(Insets::all(0.));
+        if docked {
+            backdrop = backdrop.background(Color(red, green, blue, 82));
+        }
+        backdrop.z_index = 1000;
+        Some(panel.modal_with_backdrop(
+            Node::new(Role::Group, "").id(id("layer")).styled(backdrop),
+            on_close,
+        ))
+    }
+}
+
+fn search_bar<M: Clone + 'static>(
+    theme: &Theme,
+    options: SearchOverlayOptions<'_>,
+    layout: SearchLayout,
+    on_query: impl Fn(String) -> M + 'static,
+    on_submit: M,
+    on_clear: M,
+    on_close: M,
+) -> View<M> {
+    let rtl = options.direction == LayoutDirection::RightToLeft;
+    let id = |suffix| format!("{}-{suffix}", options.id);
+    let input_id = id("input");
+    let input = View::new(
+        Node::new(Role::TextInput, options.input_label)
+            .id(&input_id)
+            .text(options.query)
+            .styled(
+                Style::column()
+                    .width(Length::Px(0.))
+                    .height(Length::Px(TOUCH_TARGET.min(layout.controls.height)))
+                    .grow(1.)
+                    .with_text_style(typography::BODY_LARGE)
+                    .foreground(theme.colors.on_surface),
+            ),
+    )
+    .on_input(on_query)
+    .on_key(move |press| {
+        (!press.repeat && press.text_action() == Some(TextAction::Submit))
+            .then(|| on_submit.clone())
+    })
+    .cursor(CursorStyle::Text);
+
+    let mut controls = Vec::new();
+    let room_for_buttons = layout.controls.width - MIN_EDITOR_WIDTH;
+    if layout.controls.height >= TOUCH_TARGET && room_for_buttons >= TOUCH_TARGET + CONTROL_GAP {
+        controls.push(search_button(
+            theme,
+            &id("back"),
+            options.back_label,
+            if rtl { "→" } else { "←" },
+            on_close,
+        ));
+    }
+    controls.push(input);
+    if !options.query.is_empty()
+        && layout.controls.height >= TOUCH_TARGET
+        && room_for_buttons >= 2. * (TOUCH_TARGET + CONTROL_GAP)
+    {
+        controls.push(
+            search_button(theme, &id("clear"), options.clear_label, "×", on_clear)
+                .restore_focus_on_removal(input_id),
+        );
+    }
+    let controls_style = placed(
+        Style::row().align(Align::Center).gap(CONTROL_GAP),
+        layout.controls,
+        layout.bar,
+    );
+    let controls_node = Node::new(Role::Group, "").styled(controls_style);
+    let controls_node = if rtl {
+        controls_node.reverse_row()
+    } else {
+        controls_node
+    };
+    let bar = placed(Style::column(), layout.bar, layout.bounds);
+    let bar = if options.style == SearchStyle::Contained {
+        bar.background(theme.colors.surface_container_high)
+            .corners(shape::FULL)
+    } else {
+        bar
+    };
+    View::new(Node::new(Role::Group, "").id(id("bar")).styled(bar))
+        .children([View::new(controls_node).children(controls)])
+}
+
+fn search_button<M>(theme: &Theme, id: &str, label: &str, icon: &str, message: M) -> View<M> {
+    theme
+        .icon_button_with_text_scaling(
+            id,
+            label,
+            (icon, TextScaling::Fixed),
+            IconButtonKind::Standard,
+            None,
+            false,
+            message,
+        )
+        .accessible_activation()
+        .suppress_repeated_activation()
+        .protect_composition_on_press()
+}
+
+fn placed(style: Style, rect: Rect, parent: Rect) -> Style {
+    style
+        .width(Length::Px(rect.width))
+        .height(Length::Px(rect.height))
+        .absolute(Insets {
+            left: Length::Px(rect.x - parent.x),
+            top: Length::Px(rect.y - parent.y),
+            ..Insets::default()
+        })
+}
diff --git a/crates/surface-material/tests/search_overlay.rs b/crates/surface-material/tests/search_overlay.rs
new file mode 100644
--- /dev/null
+++ b/crates/surface-material/tests/search_overlay.rs
@@ -0,0 +1,399 @@
+use surface::{Color, Length, Node, Rect, Role, Style, TextMeasurer};
+use surface_app::{
+    Application, EditKey, Event, ImeEvent, Key, KeyPress, Modifiers, Roving, Runtime, ScrollTarget,
+    View,
+};
+use surface_material::{
+    shape::{self, LayoutDirection},
+    SearchOverlayContent, SearchOverlayOptions, SearchStyle, Theme,
+};
+
+const INPUT: &str = "search-input";
+const RESULTS: &str = "search-results";
+
+#[derive(Clone)]
+enum Message {
+    Open,
+    Close,
+    Query(String),
+    Clear,
+    Submit,
+    Result(usize),
+    RemoveFirstResult,
+    RemoveOpener,
+    Background,
+}
+
+struct SearchApp {
+    style: SearchStyle,
+    direction: LayoutDirection,
+    viewport: Rect,
+    open: bool,
+    query: String,
+    submits: Vec<String>,
+    picked: Vec<usize>,
+    first_result: bool,
+    opener: bool,
+    clears: usize,
+    closes: usize,
+    background: usize,
+}
+
+impl Application for SearchApp {
+    type Message = Message;
+
+    fn update(&mut self, message: Message) {
+        match message {
+            Message::Open => self.open = true,
+            Message::Close => {
+                self.open = false;
+                self.closes += 1;
+            }
+            Message::Query(value) => self.query = value,
+            Message::Clear => {
+                self.query.clear();
+                self.clears += 1;
+            }
+            Message::Submit => self.submits.push(self.query.clone()),
+            Message::Result(id) => self.picked.push(id),
+            Message::RemoveFirstResult => self.first_result = false,
+            Message::RemoveOpener => self.opener = false,
+            Message::Background => self.background += 1,
+        }
+    }
+
+    fn viewport_changed(&mut self, width: f32, height: f32) -> bool {
+        self.viewport = Rect::new(0., 0., width, height);
+        true
+    }
+
+    fn text_scale(&self) -> f32 {
+        2.
+    }
+
+    fn view(&self) -> View<Message> {
+        let theme = Theme::dark();
+        let mut children = Vec::new();
+        if self.opener {
+            children.push(button("opener", "Open Search", false, Message::Open));
+        }
+        children.push(button(
+            "background",
+            "Background",
+            false,
+            Message::Background,
+        ));
+        if self.open {
+            let start = usize::from(!self.first_result);
+            let results = View::new(
+                Node::new(Role::List, "Suggestions")
+                    .id("rows")
+                    .styled(Style::column().width(Length::Percent(1.))),
+            )
+            .children((start..24).map(|index| {
+                button(
+                    &format!("result-{index}"),
+                    &format!("Suggestion {index}"),
+                    index == 1,
+                    Message::Result(index),
+                )
+                .protect_composition_on_press()
+            }))
+            .roving_retained_layout(Roving::vertical(false));
+            children.extend(theme.search_overlay(
+                SearchOverlayOptions {
+                    id: "search",
+                    open: self.open,
+                    title: "Search",
+                    input_label: "Query",
+                    results_label: "Results",
+                    back_label: "Back",
+                    clear_label: "Clear query",
+                    query: &self.query,
+                    style: self.style,
+                    direction: self.direction,
+                    viewport: self.viewport,
+                    anchor: Some(Rect::new(48., 36., 464., 56.)),
+                    preferred_docked_height: Some(300.),
+                    restore_focus_to: Some("background"),
+                    results_status: Some(if self.query.is_empty() {
+                        "History"
+                    } else {
+                        "24 results"
+                    }),
+                },
+                SearchOverlayContent {
+                    results,
+                    on_submit: Message::Submit,
+                    on_clear: Message::Clear,
+                    on_close: Message::Close,
+                },
+                Message::Query,
+            ));
+        }
+        theme.page(children)
+    }
+}
+
+fn button(id: &str, label: &str, disabled: bool, action: Message) -> View<Message> {
+    View::new(
+        Node::new(Role::Button, label)
+            .id(id)
+            .disabled(disabled)
+            .styled(
+                Style::row()
+                    .width(Length::Percent(1.))
+                    .height(Length::Px(48.)),
+            ),
+    )
+    .on_press(action)
+    .accessible_activation()
+}
+
+struct Metrics;
+impl TextMeasurer for Metrics {
+    fn measure(&mut self, text: &str, size: f32, _: Option<f32>) -> (f32, f32) {
+        (text.chars().count() as f32 * size * 0.55, size * 1.2)
+    }
+}
+
+fn open(style: SearchStyle, direction: LayoutDirection, width: f32) -> Runtime<SearchApp> {
+    let mut runtime = Runtime::new(SearchApp {
+        style,
+        direction,
+        viewport: Rect::default(),
+        open: false,
+        query: "alpha".into(),
+        submits: vec![],
+        picked: vec![],
+        first_result: true,
+        opener: true,
+        clears: 0,
+        closes: 0,
+        background: 0,
+    })
+    .unwrap();
+    render(&mut runtime, width);
+    assert!(runtime.activate("opener").unwrap());
+    render(&mut runtime, width);
+    assert_eq!(runtime.focused(), Some(INPUT));
+    runtime
+}
+
+fn render(runtime: &mut Runtime<SearchApp>, width: f32) {
+    runtime.render(width, 720., &mut Metrics).unwrap();
+}
+
+fn node<'a>(runtime: &'a Runtime<SearchApp>, id: &str) -> &'a Node {
+    runtime.dom().get(runtime.dom().by_id(id).unwrap()).unwrap()
+}
+
+fn bounds(runtime: &Runtime<SearchApp>, id: &str) -> Rect {
+    runtime.computed().unwrap().nodes[runtime.dom().by_id(id).unwrap().index()].bounds
+}
+
+fn click(runtime: &mut Runtime<SearchApp>, x: f32, y: f32) {
+    runtime.dispatch(Event::PointerDown { x, y }).unwrap();
+    runtime.dispatch(Event::PointerUp { x, y }).unwrap();
+}
+
+fn tab(runtime: &mut Runtime<SearchApp>, reverse: bool) {
+    runtime.dispatch(Event::FocusNext { reverse }).unwrap();
+}
+
+fn enter(runtime: &mut Runtime<SearchApp>) -> bool {
+    runtime
+        .key(&KeyPress::new(Key::Enter, Modifiers::default()))
+        .unwrap()
+}
+
+#[test]
+fn builds_both_variants_with_unclipped_buttons_and_named_results() {
+    for direction in [LayoutDirection::LeftToRight, LayoutDirection::RightToLeft] {
+        let rtl = direction == LayoutDirection::RightToLeft;
+        for style in [SearchStyle::Contained, SearchStyle::Divided] {
+            let mut runtime = open(style, direction, 600.);
+            assert_eq!(bounds(&runtime, "search-dialog").height, 300.);
+            assert_eq!(bounds(&runtime, "search-bar").height, 56.);
+            assert_eq!(node(&runtime, "search-layer").style().background.3, 82);
+            assert_eq!(node(&runtime, INPUT).name(), "Query");
+            assert_eq!(node(&runtime, RESULTS).name(), "Results");
+            assert_eq!(node(&runtime, "search-status").role(), Role::Status);
+            assert_eq!(node(&runtime, "search-status").name(), "24 results");
+            assert_eq!(
+                runtime.dom().by_id("search-divider").is_some(),
+                style == SearchStyle::Divided
+            );
+            let frame = runtime.accessibility_frame().unwrap();
+            assert_eq!(frame.modal_root(), runtime.dom().by_id("search-dialog"));
+            assert!(frame
+                .node(runtime.dom().by_id("background").unwrap())
+                .is_none());
+            assert!(frame
+                .node(runtime.dom().by_id("search-status").unwrap())
+                .is_some());
+
+            render(&mut runtime, 320.);
+            assert_eq!(
+                bounds(&runtime, "search-dialog"),
+                Rect::new(0., 0., 320., 720.)
+            );
+            assert_eq!(
+                node(&runtime, "search-layer").style().background,
+                Color::TRANSPARENT
+            );
+            let (back, clear) = (
+                bounds(&runtime, "search-back"),
+                bounds(&runtime, "search-clear"),
+            );
+            for target in [back, clear] {
+                assert_eq!((target.width, target.height), (48., 48.));
+                assert_eq!(bounds(&runtime, "search-bar").intersect(target), target);
+            }
+            assert_eq!(back.x > clear.x, rtl);
+            let bar = bounds(&runtime, "search-bar");
+            match style {
+                SearchStyle::Contained => {
+                    assert_eq!(
+                        node(&runtime, "search-bar").style().corners,
+                        Some(shape::FULL)
+                    );
+                    assert_eq!(bar, Rect::new(12., 12., 296., 56.));
+                }
+                SearchStyle::Divided => {
+                    assert_eq!(bar.height, 72.);
+                    assert_eq!(bounds(&runtime, "search-divider").y, 72.);
+                }
+            }
+            assert!(bounds(&runtime, RESULTS).y >= bar.y + bar.height);
+        }
+    }
+}
+
+#[test]
+fn editor_submit_is_distinct_from_click_candidate_and_clear() {
+    let mut runtime = open(SearchStyle::Contained, LayoutDirection::LeftToRight, 600.);
+    let rect = bounds(&runtime, INPUT);
+    click(&mut runtime, rect.x + 2., rect.y + 8.);
+    assert!(runtime.app().submits.is_empty());
+    runtime
+        .dispatch(Event::Select {
+            anchor: 0,
+            cursor: 5,
+        })
+        .unwrap();
+    runtime.dispatch(Event::Ime(ImeEvent::Begin)).unwrap();
+    runtime
+        .dispatch(Event::Ime(ImeEvent::Preedit {
+            text: "ㄓ".into(),
+            selection: None,
+        }))
+        .unwrap();
+    assert!(!enter(&mut runtime));
+    assert!(runtime.app().submits.is_empty());
+    assert!(runtime.input_snapshot().unwrap().composing);
+    runtime
+        .dispatch(Event::Ime(ImeEvent::Commit("中".into())))
+        .unwrap();
+    assert_eq!(runtime.app().query, "中");
+    assert!(enter(&mut runtime));
+    assert_eq!(runtime.app().submits, ["中"]);
+
+    runtime.activate("search-clear").unwrap();
+    assert_eq!(runtime.app().clears, 1);
+    assert_eq!(runtime.focused(), Some(INPUT));
+    assert!(runtime.dom().by_id("search-clear").is_none());
+    assert_eq!(node(&runtime, "search-status").name(), "History");
+}
+
+#[test]
+fn scroll_selection_and_preedit_survive_mode_switch() {
+    let mut runtime = open(SearchStyle::Contained, LayoutDirection::RightToLeft, 600.);
+    assert!(runtime.scroll_to(RESULTS, ScrollTarget::Offset { x: 0., y: 144. }));
+    render(&mut runtime, 600.);
+    assert_eq!(runtime.scroll_metrics(RESULTS).unwrap().offset.1, 144.);
+    assert_eq!(bounds(&runtime, "search-bar").y, 36.);
+    runtime
+        .dispatch(Event::Select {
+            anchor: 4,
+            cursor: 1,
+        })
+        .unwrap();
+    runtime.dispatch(Event::Ime(ImeEvent::Begin)).unwrap();
+    runtime
+        .dispatch(Event::Ime(ImeEvent::Preedit {
+            text: "ㄓ".into(),
+            selection: None,
+        }))
+        .unwrap();
+    render(&mut runtime, 599.);
+    assert_eq!(runtime.scroll_metrics(RESULTS).unwrap().offset.1, 144.);
+    assert_eq!(bounds(&runtime, "search-bar").y, 12.);
+    let input = runtime.input_snapshot().unwrap();
+    assert_eq!(input.id, INPUT);
+    assert_eq!(input.value, "alpha");
+    assert_eq!((input.selection.anchor, input.selection.cursor), (4, 1));
+    assert!(input.composing);
+    assert_eq!(runtime.focused(), Some(INPUT));
+
+    runtime.dispatch(Event::Cancel).unwrap();
+    assert!(runtime.app().open);
+    assert!(!runtime.input_snapshot().unwrap().composing);
+    runtime.dispatch(Event::Cancel).unwrap();
+    assert!(!runtime.app().open);
+    assert_eq!(runtime.focused(), Some("opener"));
+}
+
+#[test]
+fn caller_results_keep_disabled_and_ordinary_arrow_rules() {
+    let mut runtime = open(SearchStyle::Divided, LayoutDirection::RightToLeft, 600.);
+    tab(&mut runtime, true);
+    assert_eq!(runtime.focused(), Some("search-back"));
+    tab(&mut runtime, false);
+    assert_eq!(runtime.focused(), Some(INPUT));
+    tab(&mut runtime, false);
+    assert_eq!(runtime.focused(), Some("search-clear"));
+    tab(&mut runtime, false);
+    assert_eq!(runtime.focused(), Some("result-0"));
+    runtime
+        .dispatch(Event::Edit {
+            key: EditKey::Down,
+            extend: false,
+            by_word: false,
+        })
+        .unwrap();
+    assert_eq!(runtime.focused(), Some("result-2"));
+    assert!(runtime.app().picked.is_empty());
+    runtime.dispatch(Event::Activate).unwrap();
+    assert_eq!(runtime.app().picked, [2]);
+    assert!(runtime.activate("result-1").is_err());
+    render(&mut runtime, 600.);
+    runtime
+        .dispatch(Event::Edit {
+            key: EditKey::Up,
+            extend: false,
+            by_word: false,
+        })
+        .unwrap();
+    assert_eq!(runtime.focused(), Some("result-0"));
+    runtime.apply(Message::RemoveFirstResult).unwrap();
+    assert_eq!(runtime.focused(), Some(INPUT));
+}
+
+#[test]
+fn modal_dismissal_does_not_activate_background_and_recovers_missing_opener() {
+    let mut runtime = open(SearchStyle::Contained, LayoutDirection::LeftToRight, 900.);
+    assert!(runtime.activate("background").is_err());
+    click(&mut runtime, 800., 120.);
+    assert_eq!(runtime.app().background, 0);
+    assert_eq!(runtime.app().closes, 1);
+    assert_eq!(runtime.focused(), Some("opener"));
+
+    runtime.activate("opener").unwrap();
+    runtime.apply(Message::RemoveOpener).unwrap();
+    render(&mut runtime, 900.);
+    runtime.activate("search-back").unwrap();
+    assert_eq!(runtime.app().closes, 2);
+    assert_eq!(runtime.focused(), Some("background"));
+    assert_eq!(runtime.app().background, 0);
+}
