+#[test]
+fn decorative_divider_keeps_interactive_rows_in_one_named_list() {
+    let mut app = App::new(ListStyle::Baseline, ListMode::Action);
+    app.rows = vec!["a", "c"];
+    app.direction = LayoutDirection::RightToLeft;
+    app.dividers = true;
+    let mut runtime = runtime(app);
+    let first = bounds(&runtime, "a");
+    let rule = bounds(&runtime, "first-rule");
+    let last = bounds(&runtime, "c");
+    assert_eq!(rule.x, first.x);
+    assert_eq!(rule.width, first.width - 16.);
+    assert_eq!(rule.y, first.y + first.height);
+    assert_eq!(rule.height, 1.);
+    assert_eq!(last.y, rule.y + rule.height);
+    assert!(runtime.dom().by_id("tail-rule").is_none());
+
+    let frame = runtime.accessibility_frame().unwrap();
+    let list = id(&runtime, "list");
+    assert_eq!(frame.node(list).unwrap().node.name(), "專案");
+    for item in ["a", "c"] {
+        let row = node(&runtime, item).parent().unwrap();
+        assert_eq!(runtime.dom().get(row).unwrap().parent(), Some(list));
+    }
+    assert!(frame.node(id(&runtime, "first-rule")).is_none());
+
+    tap(&mut runtime, rule.x + 1., rule.y + 0.5);
+    assert!(runtime.app().presses.is_empty());
+    tab(&mut runtime, false, "before");
+    tab(&mut runtime, false, "a");
+    navigate(&mut runtime, EditKey::Down, "c");
+    assert!(runtime.dispatch(Event::Activate).unwrap());
+    render(&mut runtime);
+    assert_eq!(runtime.app().presses, ["c"]);
+    tab(&mut runtime, false, "after");
+}
