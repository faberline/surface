diff --git a/e2e/src/material_divider_composition.rs b/e2e/src/material_divider_composition.rs
new file mode 100644
index 0000000000000000000000000000000000000000..43f644d8cd9d48f4531dea0f313f1c577b5bf553
--- /dev/null
+++ b/e2e/src/material_divider_composition.rs
@@ -0,0 +1,349 @@
+//! Divider compositions and forced colors in the real Browser host.
+
+use super::material_time_input::{
+    activate, ax, ax_tree, bounds, contains, focus_projected, focused, projected, resize, Raster,
+};
+use super::material_web_contrast::{contrast, media_scheme, palette_with_disabled};
+use super::{state, until};
+use crate::browser::{Chrome, Tab};
+use crate::check::step;
+use crate::{check, check_eq, Env};
+use anyhow::{Context, Result};
+use serde_json::{json, Value};
+
+pub(super) const STEPS: [&str; 2] = ["M381", "M382"];
+const OPEN: &str = "divider-demo-sheet-open";
+const CLOSE: &str = "divider-demo-sheet-panel-close";
+const REGULAR: &str = "divider-demo-unrelated-divider";
+const HEAVY: &str = "divider-demo-heavy-major-break";
+
+async fn route(tab: &Tab, url: &str) -> Result<()> {
+    tab.goto(url).await?;
+    crate::smoke::ready(tab, "gallery").await?;
+    resize(tab, 960, 960).await?;
+    activate(tab, "section-3").await?;
+    until(tab, "s.section === 3").await?;
+    activate(tab, "divider-demo-show").await?;
+    focused(tab, "divider-demo-back").await
+}
+
+async fn semantics(tab: &Tab, sheet: bool) -> Result<Value> {
+    let tree = ax_tree(tab).await?;
+    let names: &[(&str, &str)] = if sheet {
+        &[
+            ("dialog", "分隔線細節"),
+            ("list", "草稿細節"),
+            ("button", "草稿名稱"),
+            ("button", "草稿位置"),
+            ("heading", "其他資料"),
+        ]
+    } else {
+        &[
+            ("group", "相關項目範例"),
+            ("group", "不相關項目範例"),
+            ("group", "主要區段分隔線範例"),
+            ("list", "相關項目"),
+            ("button", "草稿設定"),
+            ("button", "草稿版本"),
+            ("heading", "其他內容"),
+            ("heading", "目前工作"),
+            ("heading", "封存工作"),
+        ]
+    };
+    let list_name = if sheet {
+        "草稿細節"
+    } else {
+        "相關項目"
+    };
+    check_eq!(
+        tree.iter()
+            .filter(|node| node["ignored"] == false
+                && node["role"]["value"] == "list"
+                && node["name"]["value"] == list_name)
+            .count(),
+        1,
+        "exactly one named list contains the related rows"
+    );
+    let mut nodes = Vec::new();
+    for &(role, name) in names {
+        nodes.push(ax(&tree, role, name)?.clone());
+    }
+    for id in [
+        REGULAR,
+        HEAVY,
+        "divider-demo-related-rule",
+        "divider-demo-sheet-inset",
+        "divider-demo-sheet-full",
+    ] {
+        check_eq!(
+            tab.eval(&format!("{} === null", projected(id))).await?,
+            true,
+            "decorative {id} is not an accessibility stop"
+        );
+    }
+    Ok(json!(nodes))
+}
+
+async fn capture(env: &Env, tab: &Tab, profile: &str, mode: &str, rgb: [u8; 3]) -> Result<Value> {
+    let mut lines = Vec::new();
+    let path = env.artifact(&format!(
+        "material-divider-composition-{profile}-{mode}.png"
+    ));
+    tab.screenshot(&path).await?;
+    let raster = Raster::read(tab, path).await?;
+    for (id, thickness) in [
+        ("divider-demo-related-rule", 1.),
+        (REGULAR, 1.),
+        (HEAVY, 8.),
+    ] {
+        let rect = bounds(tab, id).await?;
+        check_eq!(rect[3], thickness, "{id} retains authored thickness");
+        check!(rect[2] > 4., "{id} has visible width");
+        check!(
+            contains(bounds(tab, "divider-demo-scroll").await?, rect),
+            "painted divider lies inside the scroll clip"
+        );
+        for x in [
+            rect[0] + 1.5,
+            rect[0] + rect[2] / 2.,
+            rect[0] + rect[2] - 1.5,
+        ] {
+            for depth in 0..(thickness as u32) {
+                check_eq!(
+                    raster.sample(x, rect[1] + f64::from(depth) + 0.5)?,
+                    rgb,
+                    "{id} paints expected ink"
+                );
+            }
+        }
+        lines.push(json!({"id":id,"bounds":rect,"rgb":rgb}));
+    }
+    Ok(
+        json!({"file":format!("material-divider-composition-{profile}-{mode}.png"),"canvas":tab.canvas_box().await?,"device_pixel_ratio":tab.eval("devicePixelRatio").await?,"lines":lines}),
+    )
+}
+
+async fn profile(env: &Env, tab: &Tab, compact: bool) -> Result<Value> {
+    let profile = if compact {
+        "compact-dark-rtl-200"
+    } else {
+        "wide-light"
+    };
+    let authored = if compact {
+        [73, 69, 78]
+    } else {
+        [202, 196, 207]
+    };
+    let viewport = if compact { [320., 1360.] } else { [960., 960.] };
+    let scroll = bounds(tab, "divider-demo-scroll").await?;
+    let canvas = tab.canvas_box().await?;
+    tab.mouse_move(
+        canvas[0] + scroll[0] + scroll[2] / 2.,
+        canvas[1] + scroll[1] + scroll[3] / 2.,
+    )
+    .await?;
+    tab.wheel(0., 3000.).await?;
+    tab.settle().await?;
+    let original = state(tab).await?["divider_demo"]["outline_variant"].clone();
+    check_eq!(
+        original,
+        json!([authored[0], authored[1], authored[2], 255]),
+        "authored outline variant matches this theme"
+    );
+    let accessibility = semantics(tab, false).await?;
+    focus_projected(tab, "divider-demo-related-a").await?;
+    tab.press("ArrowDown").await?;
+    focused(tab, "divider-demo-related-b").await?;
+    let related_before = state(tab).await?["divider_demo"]["related_activations"]
+        .as_u64()
+        .context("related activation count")?;
+    tab.press("Enter").await?;
+    until(
+        tab,
+        &format!(
+            "s.divider_demo.related_activations === {}",
+            related_before + 1
+        ),
+    )
+    .await?;
+    let item_a = bounds(tab, "divider-demo-related-a").await?;
+    let item_b = bounds(tab, "divider-demo-related-b").await?;
+    let related_rule = bounds(tab, "divider-demo-related-rule").await?;
+    let related_list = bounds(tab, "divider-demo-related-list").await?;
+    check_eq!(
+        related_list[2] - related_rule[2],
+        16.,
+        "related rule has a 16 dp inset"
+    );
+    check_eq!(
+        related_rule[0] - related_list[0],
+        if compact { 0. } else { 16. },
+        "related rule uses the logical leading inset"
+    );
+    let heavy = bounds(tab, HEAVY).await?;
+    let heading_before = bounds(tab, "divider-demo-heavy-before").await?;
+    let heading_after = bounds(tab, "divider-demo-heavy-after").await?;
+    check_eq!(
+        heavy[1] - heading_before[1] - heading_before[3],
+        16.,
+        "heavy divider has 16 dp before"
+    );
+    check_eq!(
+        heading_after[1] - heavy[1] - heavy[3],
+        16.,
+        "heavy divider has 16 dp after"
+    );
+    for rect in [related_rule, heavy] {
+        check!(
+            contains([0., 0., viewport[0], viewport[1]], rect),
+            "sample is visible in the viewport"
+        );
+    }
+    check!(
+        item_a[1] + item_a[3] <= related_rule[1] && related_rule[1] + related_rule[3] <= item_b[1],
+        "related divider sits between the two related items"
+    );
+    let before = capture(env, tab, profile, "before", authored).await?;
+    media_scheme(
+        tab,
+        true,
+        false,
+        Some(if compact { "dark" } else { "light" }),
+    )
+    .await?;
+    let forced = contrast(tab, "forced").await?;
+    let css = palette_with_disabled(tab, &forced).await?;
+    let ink: [u8; 4] = serde_json::from_value(css["pairs"]["canvas"]["foreground"].clone())
+        .context("CanvasText RGBA")?;
+    check_eq!(ink[3], 255, "CanvasText is opaque");
+    check_eq!(
+        state(tab).await?["divider_demo"]["outline_variant"],
+        json!(ink),
+        "forced outline variant uses independent CanvasText"
+    );
+    let during = capture(env, tab, profile, "forced", [ink[0], ink[1], ink[2]]).await?;
+    media_scheme(
+        tab,
+        false,
+        false,
+        Some(if compact { "dark" } else { "light" }),
+    )
+    .await?;
+    let normal = contrast(tab, "normal").await?;
+    check_eq!(
+        normal["system_colors"],
+        Value::Null,
+        "forced palette is cleared"
+    );
+    check_eq!(
+        state(tab).await?["divider_demo"]["outline_variant"],
+        original,
+        "authored outline variant returns after forced colors"
+    );
+    let after = capture(env, tab, profile, "after", authored).await?;
+    activate(tab, OPEN).await?;
+    until(tab, "s.divider_demo.sheet_open").await?;
+    tab.wait_for(&format!("{} !== null", projected(CLOSE)))
+        .await?;
+    focused(tab, CLOSE).await?;
+    let sheet = semantics(tab, true).await?;
+    let inset = bounds(tab, "divider-demo-sheet-inset").await?;
+    let full = bounds(tab, "divider-demo-sheet-full").await?;
+    let list = bounds(tab, "divider-demo-sheet-list").await?;
+    let panel = bounds(tab, "divider-demo-sheet-panel").await?;
+    check_eq!(list[2] - inset[2], 16., "sheet list has 16 dp inset");
+    check_eq!(
+        inset[0] - list[0],
+        if compact { 0. } else { 16. },
+        "sheet divider uses logical leading inset"
+    );
+    check!(
+        contains(panel, inset) && contains(panel, full),
+        "sheet contains both visible dividers"
+    );
+    check!(
+        contains([0., 0., viewport[0], viewport[1]], inset)
+            && contains([0., 0., viewport[0], viewport[1]], full),
+        "sheet dividers lie inside screenshot"
+    );
+    let sheet_path = env.artifact(&format!("material-divider-composition-{profile}-sheet.png"));
+    tab.screenshot(&sheet_path).await?;
+    let sheet_raster = Raster::read(tab, sheet_path).await?;
+    let heading = bounds(tab, "divider-demo-sheet-unrelated-heading").await?;
+    check!(
+        contains(panel, heading) && contains([0., 0., viewport[0], viewport[1]], heading),
+        "sheet heading is visible inside the panel and screenshot"
+    );
+    let on_surface: [u8; 4] = serde_json::from_value(normal["theme"]["on_surface"].clone())
+        .context("authored on-surface color")?;
+    check_eq!(on_surface[3], 255, "heading on-surface color is opaque");
+    let heading_rgb = [on_surface[0], on_surface[1], on_surface[2]];
+    let heading_pixels = sheet_raster
+        .colors(heading)?
+        .get(&heading_rgb)
+        .copied()
+        .unwrap_or(0);
+    check!(
+        heading_pixels > 8,
+        "sheet heading paints visible on-surface text pixels"
+    );
+    for rect in [inset, full] {
+        for x in [
+            rect[0] + 1.5,
+            rect[0] + rect[2] / 2.,
+            rect[0] + rect[2] - 1.5,
+        ] {
+            check_eq!(
+                sheet_raster.sample(x, rect[1] + 0.5)?,
+                authored,
+                "sheet screenshot paints the authored divider"
+            );
+        }
+    }
+    focused(tab, CLOSE).await?;
+    tab.press("Tab").await?;
+    focused(tab, "divider-demo-sheet-item-a").await?;
+    tab.press("ArrowDown").await?;
+    focused(tab, "divider-demo-sheet-item-b").await?;
+    let sheet_before = state(tab).await?["divider_demo"]["sheet_activations"]
+        .as_u64()
+        .context("sheet activation count")?;
+    tab.press("Enter").await?;
+    until(
+        tab,
+        &format!("s.divider_demo.sheet_activations === {}", sheet_before + 1),
+    )
+    .await?;
+    focused(tab, "divider-demo-sheet-item-b").await?;
+    tab.press("Escape").await?;
+    until(tab, "!s.divider_demo.sheet_open").await?;
+    tab.wait_for(&format!("{} === null", projected(CLOSE)))
+        .await?;
+    focused(tab, OPEN).await?;
+    Ok(
+        json!({"profile":profile,"accessibility":accessibility,"sheet_accessibility":sheet,"sheet":{"file":format!("material-divider-composition-{profile}-sheet.png"),"canvas":tab.canvas_box().await?,"device_pixel_ratio":tab.eval("devicePixelRatio").await?,"panel":panel,"list":list,"inset":inset,"full":full,"rgb":authored,"heading":{"bounds":heading,"rgba":on_surface,"ink_pixels":heading_pixels},"focus_return":OPEN},"before":before,"forced":during,"after":after,"forced_appearance":forced,"css_canvas":css["pairs"]["canvas"],"related_geometry":{"first":item_a,"rule":related_rule,"second":item_b,"list":related_list,"heavy_before":heading_before,"heavy":heavy,"heavy_after":heading_after},"authored_outline_variant":original,"normal_appearance":normal}),
+    )
+}
+
+pub(super) async fn run(env: &Env, chrome: &Chrome, url: &str) -> Result<()> {
+    let tab = chrome.page(960, 1004, 2.).await?;
+    let mut report = json!({"browser":chrome.version,"steps":STEPS});
+    let result: Result<()> = async {
+        step(STEPS[0],"wide light divider compositions and modal sheet use forced color paint");
+        route(&tab,url).await?;
+        report["adapter"]=tab.eval("(async()=>{const a=await navigator.gpu?.requestAdapter();if(!a)return null;const {isFallbackAdapter,vendor,architecture}=a.info;return {isFallbackAdapter,vendor,architecture};})()").await?;
+        report["wide"]=profile(env,&tab,false).await?;
+        step(STEPS[1],"compact dark RTL at 200 percent retains divider and sheet behavior");
+        for id in ["divider-demo-theme","divider-demo-rtl","divider-demo-large-text"] { activate(&tab,id).await?; }
+        resize(&tab,320,1360).await?;
+        report["compact"]=profile(env,&tab,true).await?;
+        check!(tab.errors().is_empty(),"no Browser errors: {:?}",tab.errors());
+        Ok(())
+    }.await;
+    report["errors"] = json!(tab.errors());
+    if let Err(error) = &result {
+        report["failure"] = json!(format!("{error:#}"));
+    }
+    env.write_json("browser-material-divider-composition.json", &report)?;
+    result
+}
