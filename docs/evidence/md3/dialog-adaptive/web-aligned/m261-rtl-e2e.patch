+type Ink = Vec<[usize; 2]>;
+
+async fn text_paint(tab: &Tab, id: &str) -> Result<([u8; 3], f64)> {
+    let node = tab
+        .eval(&format!(
+            "JSON.parse(window.gallery.export_dom()).dom.nodes.find(n => n.stable_id === {})",
+            js(id)
+        ))
+        .await?;
+    let [r, g, b, a]: [u8; 4] = serde_json::from_value(node["style"]["foreground"].clone())?;
+    check_eq!(a, 255, "the sampled title/supporting color is opaque");
+    let line_height = node["style"]["line_height"]
+        .as_f64()
+        .context("authored logical line height")?;
+    Ok(([r, g, b], line_height * 2.))
+}
+
+async fn raster(env: &Env, tab: &Tab, name: &str) -> Result<Raster> {
+    screen(env, tab, name).await?;
+    Raster::read(
+        tab,
+        env.artifact(&format!("material-dialog-adaptive-{name}.png")),
+    )
+    .await
+}
+
+fn line_box(rect: Rect, row: u32, pitch: f64) -> Rect {
+    let [x, y, width, _] = rect;
+    [x, y + f64::from(row) * pitch, width, pitch]
+}
+
+fn color_points(image: &Raster, rect: Rect, clip: Rect, rgb: [u8; 3]) -> Result<Ink> {
+    let [x, y, width, height] = rect;
+    let mut ink = Vec::new();
+    // The Gallery runs at verified 2× device scale. Keep each mask relative
+    // to its text line to compare the compact view to the unclipped view.
+    for row in 0..(height * 2.).round() as usize {
+        let py = y + (row as f64 + 0.5) / 2.;
+        if py < clip[1] || py >= clip[1] + clip[3] {
+            continue;
+        }
+        for column in 0..(width * 2.).round() as usize {
+            let px = x + (column as f64 + 0.5) / 2.;
+            if px < clip[0] || px >= clip[0] + clip[2] {
+                continue;
+            }
+            if image
+                .sample(px, py)?
+                .iter()
+                .zip(rgb)
+                .all(|(a, b)| a.abs_diff(b) <= 24)
+            {
+                ink.push([column, row]);
+            }
+        }
+    }
+    Ok(ink)
+}
+
+fn horizontal_ink(ink: &Ink) -> Result<[usize; 2]> {
+    let left = ink
+        .iter()
+        .map(|p| p[0])
+        .min()
+        .context("leftmost title ink")?;
+    let right = ink
+        .iter()
+        .map(|p| p[0])
+        .max()
+        .context("rightmost title ink")?;
+    Ok([left, right])
+}
+
+async fn discard_description(tab: &Tab) -> Result<Value> {
+    let tree = ax_tree(tab).await?;
+    let dialog = ax(&tree, "dialog", "捨棄變更？")?;
+    let relation = tab.eval(&format!(
+        "(() => {{const e={}; return e.getAttribute('aria-describedby').split(/\\s+/).map(id => document.getElementById(id)?.textContent).join(' ');}})()",
+        projected(DISCARD)
+    )).await?;
+    check_eq!(
+        relation,
+        DISCARD_DESCRIPTION,
+        "projected description resolves to the complete authored support text"
+    );
+    check_eq!(
+        dialog["description"]["value"],
+        DISCARD_DESCRIPTION,
+        "Chrome AX retains every word while supporting text is clipped or scrolled"
+    );
+    Ok(relation)
+}
