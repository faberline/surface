+use std::ops::Range;
+
+use surface::ExtendedPaintOp;
+use wgpu::util::DeviceExt;
+
+use crate::ExtendedRenderError;
+
+// The intermediate is in the same space and format as the target. It needs
+// enough alpha precision to store the coverage from the ordinary draw lanes.
+pub(super) fn supports_format(format: wgpu::TextureFormat) -> bool {
+    use wgpu::TextureFormat::*;
+    matches!(
+        format,
+        Rgba8Unorm | Rgba8UnormSrgb | Bgra8Unorm | Bgra8UnormSrgb | Rgba16Float
+    )
+}
+
+pub(super) fn validate(ops: &[ExtendedPaintOp]) -> Result<(), ExtendedRenderError> {
+    let mut open = false;
+    for op in ops {
+        match op {
+            ExtendedPaintOp::BeginOpacityGroup { opacity } => {
+                if open {
+                    return Err(ExtendedRenderError::InvalidOpacityGroup(
+                        "groups cannot nest",
+                    ));
+                }
+                if !(0. ..=1.).contains(opacity) {
+                    return Err(ExtendedRenderError::InvalidOpacityGroup(
+                        "opacity must be finite and between zero and one",
+                    ));
+                }
+                open = true;
+            }
+            ExtendedPaintOp::EndOpacityGroup => {
+                if !open {
+                    return Err(ExtendedRenderError::InvalidOpacityGroup(
+                        "end without a start",
+                    ));
+                }
+                open = false;
+            }
+            _ => {}
+        }
+    }
+    if open {
+        return Err(ExtendedRenderError::InvalidOpacityGroup(
+            "start without an end",
+        ));
+    }
+    Ok(())
+}
+
+pub(super) enum ActiveGroup {
+    Direct,
+    Hidden,
+    Intermediate { start: usize, opacity: f32 },
+}
+
+impl ActiveGroup {
+    pub(super) fn begin(opacity: f32, start: usize) -> Self {
+        if opacity == 0. {
+            Self::Hidden
+        } else if opacity == 1. {
+            Self::Direct
+        } else {
+            Self::Intermediate { start, opacity }
+        }
+    }
+
+    pub(super) fn end(&mut self, end: usize, groups: &mut Vec<DrawGroup>) {
+        if let Self::Intermediate { start, opacity } = std::mem::replace(self, Self::Direct) {
+            if start < end {
+                groups.push(DrawGroup {
+                    draws: start..end,
+                    opacity,
+                });
+            }
+        }
+    }
+}
+
+pub(super) struct DrawGroup {
+    draws: Range<usize>,
+    opacity: f32,
+}
+
+pub(super) enum Pass {
+    Target {
+        draws: Range<usize>,
+        composite: Option<usize>,
+    },
+    Intermediate {
+        draws: Range<usize>,
+    },
+}
+
+pub(super) fn passes(groups: &[DrawGroup], draws: usize) -> impl Iterator<Item = Pass> + '_ {
+    (0..=groups.len()).flat_map(move |index| {
+        let previous = index.checked_sub(1);
+        let start = previous.map_or(0, |prev| groups[prev].draws.end);
+        let next = groups.get(index);
+        let target = Pass::Target {
+            draws: start..next.map_or(draws, |group| group.draws.start),
+            composite: previous,
+        };
+        std::iter::once(target).chain(next.map(|group| Pass::Intermediate {
+            draws: group.draws.clone(),
+        }))
+    })
+}
+
+struct Surface {
+    width: u32,
+    height: u32,
+    view: wgpu::TextureView,
+    binding: wgpu::BindGroup,
+}
+
+pub(super) struct Compositor {
+    layout: wgpu::BindGroupLayout,
+    pipeline: wgpu::RenderPipeline,
+    surface: Option<Surface>,
+}
+
+impl Compositor {
+    pub(super) fn new(device: &wgpu::Device, format: wgpu::TextureFormat) -> Self {
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("Surface opacity texture layout"),
+            entries: &[wgpu::BindGroupLayoutEntry {
+                binding: 0,
+                visibility: wgpu::ShaderStages::FRAGMENT,
+                ty: wgpu::BindingType::Texture {
+                    sample_type: wgpu::TextureSampleType::Float { filterable: false },
+                    view_dimension: wgpu::TextureViewDimension::D2,
+                    multisampled: false,
+                },
+                count: None,
+            }],
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("Surface opacity pipeline layout"),
+            bind_group_layouts: &[&layout],
+            push_constant_ranges: &[],
+        });
+        let shader = device.create_shader_module(wgpu::include_wgsl!("opacity.wgsl"));
+        let pipeline = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some("Surface opacity composite"),
+            layout: Some(&pipeline_layout),
+            vertex: wgpu::VertexState {
+                module: &shader,
+                entry_point: Some("vs_main"),
+                buffers: &[wgpu::VertexBufferLayout {
+                    array_stride: size_of::<f32>() as u64,
+                    step_mode: wgpu::VertexStepMode::Instance,
+                    attributes: &wgpu::vertex_attr_array![0 => Float32],
+                }],
+                compilation_options: Default::default(),
+            },
+            fragment: Some(wgpu::FragmentState {
+                module: &shader,
+                entry_point: Some("fs_main"),
+                targets: &[Some(wgpu::ColorTargetState {
+                    format,
+                    blend: Some(wgpu::BlendState::PREMULTIPLIED_ALPHA_BLENDING),
+                    write_mask: wgpu::ColorWrites::ALL,
+                })],
+                compilation_options: Default::default(),
+            }),
+            primitive: wgpu::PrimitiveState::default(),
+            depth_stencil: None,
+            multisample: wgpu::MultisampleState::default(),
+            multiview: None,
+            cache: None,
+        });
+        Self {
+            layout,
+            pipeline,
+            surface: None,
+        }
+    }
+
+    pub(super) fn prepare(
+        &mut self,
+        device: &wgpu::Device,
+        format: wgpu::TextureFormat,
+        width: u32,
+        height: u32,
+        groups: &[DrawGroup],
+    ) -> Prepared<'_> {
+        if self
+            .surface
+            .as_ref()
+            .is_none_or(|s| (s.width, s.height) != (width, height))
+        {
+            let image = device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("Surface opacity intermediate"),
+                size: wgpu::Extent3d {
+                    width,
+                    height,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format,
+                usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                    | wgpu::TextureUsages::TEXTURE_BINDING,
+                view_formats: &[],
+            });
+            let view = image.create_view(&wgpu::TextureViewDescriptor::default());
+            let binding = device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("Surface opacity intermediate binding"),
+                layout: &self.layout,
+                entries: &[wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(&view),
+                }],
+            });
+            self.surface = Some(Surface {
+                width,
+                height,
+                view,
+                binding,
+            });
+        }
+        let values: Vec<_> = groups.iter().map(|group| group.opacity).collect();
+        let opacities = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some("Surface opacity instances"),
+            contents: bytemuck::cast_slice(&values),
+            usage: wgpu::BufferUsages::VERTEX,
+        });
+        Prepared {
+            surface: self
+                .surface
+                .as_ref()
+                .expect("intermediate surface prepared"),
+            pipeline: &self.pipeline,
+            opacities,
+        }
+    }
+}
+
+pub(super) struct Prepared<'a> {
+    surface: &'a Surface,
+    pipeline: &'a wgpu::RenderPipeline,
+    opacities: wgpu::Buffer,
+}
+
+impl Prepared<'_> {
+    pub(super) fn view(&self) -> &wgpu::TextureView {
+        &self.surface.view
+    }
+
+    pub(super) fn composite(&self, pass: &mut wgpu::RenderPass<'_>, group: usize) {
+        let start = (group * size_of::<f32>()) as u64;
+        pass.set_scissor_rect(0, 0, self.surface.width, self.surface.height);
+        pass.set_pipeline(self.pipeline);
+        pass.set_vertex_buffer(
+            0,
+            self.opacities.slice(start..start + size_of::<f32>() as u64),
+        );
+        pass.set_bind_group(0, &self.surface.binding, &[]);
+        pass.draw(0..3, 0..1);
+    }
+}
