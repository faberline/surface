+#[test]
+fn explicit_only_and_escape_only_consume_outside_input_and_restore_focus() {
+    for policy in [
+        ModalDismissal::ActionOnly,
+        ModalDismissal::Escape,
+        ModalDismissal::EscapeOrOutside,
+    ] {
