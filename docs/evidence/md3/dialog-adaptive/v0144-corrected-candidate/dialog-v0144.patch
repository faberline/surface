+    let opened = raster(env, tab, "transform-reduced-open").await?;
+    let (field_probe, field) = field_pixel(tab, &opened).await?;
+    check_eq!(
+        json!(field_probe),
+        normal["field_probe"],
+        "same field location after Reduce Motion"
+    );
+    check_eq!(
+        json!(field),
+        normal["field_color"],
+        "same exact endpoint paint after Reduce Motion"
+    );
