+    rt.apply(Message::Retire).unwrap();
+    assert_eq!(rt.focused(), Some("open"));
+    draw(&mut rt);
+    scope(&rt, None);
+    assert_eq!(layers(&rt, &ids), ids);
+    no_ax(
+        &rt,
+        &[
+            "outer-scrim",
+            "outer",
+            "row",
+            "inner-scrim",
+            "inner",
+            "inner-action",
