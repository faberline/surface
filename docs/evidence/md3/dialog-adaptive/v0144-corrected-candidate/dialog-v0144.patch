+        page.extend(self.basic(theme, matches!(self.active, Some(Active::Basic))));
+        page.extend(self.alert(theme, matches!(self.active, Some(Active::Alert))));
+        let mut ask_discard = false;
+        if let Some(Active::Edit {
+            draft,
