+async fn scene(tab: &Tab, url: &str, width: u32, height: u32, reduced: bool) -> Result<()> {
+    preference(tab, reduced).await?;
+    route(tab, url, width, height).await?;
+    activate(tab, "dialog-demo-theme").await?;
+    until(tab, "s.dark").await?;
+    freeze(tab).await
