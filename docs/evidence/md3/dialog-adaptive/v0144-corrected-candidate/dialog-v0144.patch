+//! Basic, alert and responsive full-screen dialogs through the real Chrome host.
+
+use anyhow::{Context, Result};
+use serde_json::{json, Value};
+
+use super::material_time_input::{
+    activate, ax, ax_property, ax_tree, bounds, contains, focus_projected, focused, projected,
+    resize, Raster,
+};
+use super::{click, point, state, until};
+use crate::browser::{js, Chrome, Tab};
+use crate::check::step;
+use crate::{check, check_eq, Env};
+
+#[path = "material_dialog_motion.rs"]
+mod motion;
+#[path = "material_dialog_transform.rs"]
+mod transform;
+
+const SHOW: &str = "dialog-demo-show";
+const BASIC: &str = "dialog-demo-basic";
+const ALERT: &str = "dialog-demo-alert";
+const EDIT: &str = "dialog-demo-edit";
+const DISCARD: &str = "dialog-demo-discard";
+const EDITOR: &str = "dialog-demo-editor";
+const INPUT: &str = "document.getElementById('surface-text-input')";
+const INITIAL: &str = "週末行程";
+const CHANGED: &str = "秋日散步";
+
+type Rect = [f64; 4];
+
+async fn ready(tab: &Tab, condition: &str) -> Result<()> {
+    until(tab, &format!("(d => {condition})(s.dialog_demo)")).await?;
+    tab.settle().await
+}
+
+async fn route(tab: &Tab, url: &str, width: u32, height: u32) -> Result<()> {
+    tab.viewport(960, 1844).await?;
+    tab.goto(url).await?;
+    crate::smoke::ready(tab, "gallery").await?;
+    resize(tab, 960, 1800).await?;
+    activate(tab, "section-2").await?;
+    until(tab, "s.section === 2").await?;
+    activate(tab, SHOW).await?;
+    ready(tab, "d.visible && d.open === null").await?;
+    resize(tab, width, height).await
+}
+
+async fn open(tab: &Tab, id: &str, kind: &str) -> Result<()> {
+    activate(tab, &format!("{id}-open")).await?;
+    ready(tab, &format!("d.open === {}", js(kind))).await
+}
+
+async fn tab_to(tab: &Tab, key: &str, id: &str) -> Result<()> {
+    tab.press(key).await?;
+    focused(tab, id).await
+}
+
+async fn dismiss(tab: &Tab, opener: &str) -> Result<()> {
+    ready(tab, "d.open === null").await?;
+    focused(tab, opener).await
+}
+
+async fn pointer_focus(tab: &Tab, id: &str) -> Result<()> {
+    until(tab, &format!("s.focused === {}", js(id))).await?;
+    tab.wait_for(&format!(
+        "document.activeElement === document.getElementById('surface') || document.activeElement === {}",
+        projected(id)
+    )).await
+}
+
+async fn screen(env: &Env, tab: &Tab, name: &str) -> Result<()> {
+    tab.settle().await?;
+    tab.screenshot(&env.artifact(&format!("material-dialog-adaptive-{name}.png")))
+        .await
+}
+
+async fn named_modal(tab: &Tab, id: &str, role: &str, label: &str) -> Result<Value> {
+    let target = projected(id);
+    tab.wait_for(&format!(
+        "{target}?.getAttribute('role') === {} && {target}?.getAttribute('aria-modal') === 'true'",
+        js(role)
+    ))
+    .await?;
+    let relation = tab
+        .eval(&format!(
+            "(() => {{const e={target}; const heading=document.getElementById(e.getAttribute('aria-labelledby')); return {{id:heading?.dataset.surfaceId,text:heading?.textContent}};}})()"
+        ))
+        .await?;
+    check_eq!(
+        relation["text"],
+        label,
+        "dialog refers to its projected heading"
+    );
+    let tree = ax_tree(tab).await?;
+    let node = ax(&tree, role, label)?;
+    check_eq!(
+        ax_property(node, "modal"),
+        Some(&json!(true)),
+        "Chrome AX marks the named dialog modal"
+    );
+    Ok(json!({"role":role,"name":node["name"]["value"],"heading":relation,"modal":true}))
+}
+
+async fn background_blocked(tab: &Tab) -> Result<()> {
+    for id in [
+        "dialog-demo-back",
+        "dialog-demo-basic-open",
+        "dialog-demo-alert-open",
+        "dialog-demo-edit-open",
+    ] {
+        check_eq!(
+            tab.eval(&format!("{} === null", projected(id))).await?,
+            true,
+            "background {id} is pruned from projected AX"
+        );
+    }
+    Ok(())
+}
+
+async fn basic(env: &Env, tab: &Tab, url: &str) -> Result<Value> {
+    route(tab, url, 960, 720).await?;
+    open(tab, BASIC, "basic").await?;
+    let role = named_modal(tab, BASIC, "dialog", "行程通知").await?;
+    check_eq!(
+        role["heading"]["id"],
+        "dialog-demo-basic-heading",
+        "Basic heading ID"
+    );
+    background_blocked(tab).await?;
+    focused(tab, "dialog-demo-basic-confirm").await?;
+    tab_to(tab, "Tab", "dialog-demo-basic-cancel").await?;
+    tab_to(tab, "Tab", "dialog-demo-basic-confirm").await?;
+    tab_to(tab, "Shift+Tab", "dialog-demo-basic-cancel").await?;
+    ready(tab, "d.opacity.basic === 1").await?;
+    screen(env, tab, "basic-wide").await?;
+    tab.press("Escape").await?;
+    dismiss(tab, "dialog-demo-basic-open").await?;
+
+    open(tab, BASIC, "basic").await?;
+    let panel = bounds(tab, BASIC).await?;
+    let [x, y, ..] = tab.canvas_box().await?;
+    check!(
+        panel[0] > 8. && panel[1] > 8.,
+        "pointer is outside the Basic panel: {panel:?}"
+    );
+    tab.click(x + 4., y + 4.).await?;
+    ready(tab, "d.open === null").await?;
+    pointer_focus(tab, "dialog-demo-basic-open").await?;
+    Ok(
+        json!({"ax":role,"panel":panel,"tab_cycle":["confirm","cancel","confirm","cancel"],"escape_return":true,"scrim_return":true}),
+    )
+}
+
+async fn pinned_bounds(tab: &Tab) -> Result<[Rect; 4]> {
+    Ok([
+        bounds(tab, "dialog-demo-basic-heading").await?,
+        bounds(tab, "dialog-demo-basic-body").await?,
+        bounds(tab, "dialog-demo-basic-cancel").await?,
+        bounds(tab, "dialog-demo-basic-confirm").await?,
+    ])
+}
+
+async fn short(env: &Env, tab: &Tab, url: &str) -> Result<Value> {
+    route(tab, url, 320, 400).await?;
+    activate(tab, "dialog-demo-theme").await?;
+    activate(tab, "dialog-demo-large-text").await?;
+    until(tab, "s.dark && s.dialog_demo.text_scale === 2").await?;
+    open(tab, BASIC, "basic").await?;
+    let panel = bounds(tab, BASIC).await?;
+    let [heading, body, cancel, confirm] = pinned_bounds(tab).await?;
+    check!(
+        contains([0., 0., 320., 400.], panel),
+        "Basic stays within the 320×400 viewport: {panel:?}"
+    );
+    for target in [heading, body, cancel, confirm] {
+        check!(
+            contains(panel, target),
+            "pinned component remains inside panel: {target:?} / {panel:?}"
+        );
+    }
+    for target in [cancel, confirm] {
+        check!(
+            target[2] >= 48. && target[3] >= 48.,
+            "complete 48 dp action target: {target:?}"
+        );
+        check!(
+            body[1] + body[3] <= target[1] + 0.5,
+            "actions remain below body: {target:?} / {body:?}"
+        );
+    }
+    check!(
+        heading[1] + heading[3] <= body[1] && body[3] > 0.,
+        "heading stays above a nonempty scroll body"
+    );
+    let tail = "dialog-demo-basic-offline";
+    let before = bounds(tab, tail).await?;
+    check!(
+        before[1] >= body[1] + body[3],
+        "last description initially below body: {before:?}"
+    );
+    ready(tab, "d.opacity.basic === 1").await?;
+    screen(env, tab, "basic-short-before").await?;
+
+    let target = point(tab, "dialog-demo-basic-body").await?;
+    tab.mouse_move(target.x, target.y).await?;
+    tab.wheel(0., 1800.).await?;
+    tab.wait_for(&format!(
+        "window.gallery.control_bounds({})[1] < {}",
+        js(tail),
+        before[1] - 40.
+    ))
+    .await?;
+    tab.settle().await?;
+    let after = bounds(tab, tail).await?;
+    check!(
+        after[1] < body[1] + body[3] && after[1] + after[3] > body[1],
+        "trusted wheel reveals the last description: {after:?} / {body:?}"
+    );
+    check_eq!(
+        pinned_bounds(tab).await?,
+        [heading, body, cancel, confirm],
+        "heading, scroll frame and both action targets stay pinned"
+    );
+    screen(env, tab, "basic-short-after").await?;
+    tab.press("Enter").await?;
+    dismiss(tab, "dialog-demo-basic-open").await?;
+    Ok(
+        json!({"viewport":[320,400],"dark":true,"text_scale":2,"panel":panel,"heading":heading,"body":body,"actions":[cancel,confirm],"last_content_before":before,"last_content_after":after,"pinned":true}),
+    )
+}
+
+async fn alert(env: &Env, tab: &Tab, url: &str) -> Result<Value> {
+    route(tab, url, 960, 720).await?;
+    open(tab, ALERT, "alert").await?;
+    let role = named_modal(tab, ALERT, "alertdialog", "連線中斷").await?;
+    check_eq!(
+        role["heading"]["id"],
+        "dialog-demo-alert-heading",
+        "Alert heading ID"
+    );
+    let tree = ax_tree(tab).await?;
+    let dialog = ax(&tree, "alertdialog", "連線中斷")?;
+    let description = "目前無法同步行程。請確認網路連線後再試。";
+    check_eq!(
+        dialog["description"]["value"],
+        description,
+        "Chrome AX reads the linked alert description"
+    );
+    ax(&tree, "button", "知道了")?;
+    check!(
+        ax(&tree, "button", "編輯行程").is_err(),
+        "Chrome AX suppresses the background control"
+    );
+    background_blocked(tab).await?;
+    focused(tab, "dialog-demo-alert-confirm").await?;
+    tab_to(tab, "Tab", "dialog-demo-alert-confirm").await?;
+    tab_to(tab, "Shift+Tab", "dialog-demo-alert-confirm").await?;
+    tab.press("Escape").await?;
+    ready(tab, "d.open === 'alert' && d.alerts === 0").await?;
+
+    let panel = bounds(tab, ALERT).await?;
+    let background = point(tab, "dialog-demo-edit-open").await?;
+    check!(
+        background.x < background.canvas[0] + panel[0]
+            || background.y < background.canvas[1] + panel[1],
+        "real background button lies outside the alert"
+    );
+    tab.click(background.x, background.y).await?;
+    ready(tab, "d.open === 'alert' && d.alerts === 0 && d.saves === 0").await?;
+    pointer_focus(tab, "dialog-demo-alert-confirm").await?;
+    ready(tab, "d.opacity.alert === 1").await?;
+    screen(env, tab, "alert").await?;
+    focus_projected(tab, "dialog-demo-alert-confirm").await?;
+    tab.press("Enter").await?;
+    dismiss(tab, "dialog-demo-alert-open").await?;
+    ready(tab, "d.alerts === 1").await?;
+    Ok(
+        json!({"ax":role,"description":description,"panel":panel,"escape_blocked":true,"click_through_blocked":true,"acknowledgements":1}),
+    )
+}
+
+async fn editor_focus(tab: &Tab) -> Result<()> {
+    until(tab, &format!("s.focused === {}", js(EDITOR))).await?;
+    tab.wait_for(&format!(
+        "document.activeElement === {INPUT} && {INPUT}.getAttribute('aria-label') === '行程名稱'"
+    ))
+    .await?;
+    tab.settle().await
+}
+
+async fn fill(tab: &Tab, value: &str) -> Result<()> {
+    editor_focus(tab).await?;
+    tab.shortcut("a").await?;
+    tab.insert_text(value).await?;
+    ready(tab, &format!("d.draft === {} && d.saves === 0", js(value))).await
+}
+
+async fn selection(tab: &Tab) -> Result<Value> {
+    tab.eval(&format!(
+        "(() => {{const e={INPUT}; const input=JSON.parse(window.gallery.export_dom()).text_inputs[{}]; return {{same:e===window.__dialogEditor,value:e.value,range:[e.selectionStart,e.selectionEnd],direction:e.selectionDirection,runtime:input}};}})()",
+        js(EDITOR)
+    )).await
+}
+
+async fn select_last_character(tab: &Tab) -> Result<Value> {
+    tab.eval(&format!("window.__dialogEditor={INPUT}")).await?;
