+    let before = select_last_character(tab).await?;
+    tab.ime_compose("ㄅ", 0, 1).await?;
+    tab.wait_for(&format!(
+        "JSON.parse(window.gallery.export_dom()).text_inputs[{}]?.composing === true",
+        js(EDITOR)
+    ))
