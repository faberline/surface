+async fn raster(env: &Env, tab: &Tab, name: &str) -> Result<Raster> {
+    screen(env, tab, name).await?;
+    Raster::read(
+        tab,
+        env.artifact(&format!("material-dialog-adaptive-{name}.png")),
+    )
+    .await
+}
