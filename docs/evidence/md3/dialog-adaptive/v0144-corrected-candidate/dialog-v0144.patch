+        report["short"] = short(env, &tab, url).await.context("M257")?;
+        step("M258", "named Alert requires acknowledgement and blocks outside input and Escape");
+        report["alert"] = alert(env, &tab, url).await.context("M258")?;
+        step("M259", "599 to 600 dp keeps the named editor, draft and backward selection across presentations");
+        report["breakpoint"] = breakpoint(env, &tab, url).await.context("M259")?;
+        step("M260", "dirty Close and Escape ask first, Continue restores exact prior focus, and explicit Save or Discard acts once");
+        report["transaction"] = transaction(env, &tab, url).await.context("M260")?;
+        step("M261", "320 dp dark RTL 200% aligns both title lines and wheels the entire discard description without moving actions");
+        report["rtl_short"] = rtl_short(env, &tab, url).await.context("M261")?;
+        step("M262", "real Basic and nested Discard opacity frames, immediate modal handback, reversal and Reduce Motion");
+        report["motion"] = motion::run(env, &tab, url).await.context("M262")?;
+        step("M263", "actual measured FAB container expands, retires, reverses, reduces motion and keeps the adaptive draft");
