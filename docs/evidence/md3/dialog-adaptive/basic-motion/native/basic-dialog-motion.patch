+    fn opacity_group(frame: &ExtendedDisplayList) -> Option<f32> {
+        frame.ops().iter().find_map(|op| match op {
+            ExtendedPaintOp::BeginOpacityGroup { opacity } => Some(*opacity),
+            _ => None,
+        })
+    }
