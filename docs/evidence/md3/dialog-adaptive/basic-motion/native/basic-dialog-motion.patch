+        let viewport = (960., 800.);
+        let mut runtime = route(viewport, false);
+        runtime.activate(BASIC_OPEN).unwrap();
+        let start = timed_frame(&mut runtime, viewport, 100.);
+        assert_eq!(opacity_group(&start), Some(0.));
