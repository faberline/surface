+    fn scrim_alpha(frame: &ExtendedDisplayList) -> Option<u8> {
+        frame.ops().iter().find_map(|op| match op {
+            ExtendedPaintOp::FillPath(path) if path.rect() == frame.viewport() => {
+                Some(path.color().3)
+            }
+            _ => None,
+        })
+    }
