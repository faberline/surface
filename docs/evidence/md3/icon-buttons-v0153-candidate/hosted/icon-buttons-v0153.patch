+#[test]
+fn colors_follow_command_off_on_and_disabled_roles_in_light_and_dark() {
+    let transparent = Color::TRANSPARENT;
+    for dark in [false, true] {
+        let colors = Model {
+            dark,
+            ..Model::default()
+        }
+        .theme()
+        .colors;
+        let rows = [
+            (
+                IconButtonKind::Filled,
+                None,
+                colors.primary,
+                colors.on_primary,
+                false,
+            ),
+            (
+                IconButtonKind::Filled,
+                Some(false),
+                colors.surface_container,
+                colors.on_surface_variant,
+                false,
+            ),
+            (
+                IconButtonKind::Filled,
+                Some(true),
+                colors.primary,
+                colors.on_primary,
+                false,
+            ),
+            (
+                IconButtonKind::Tonal,
+                None,
+                colors.secondary_container,
+                colors.on_secondary_container,
+                false,
+            ),
+            (
+                IconButtonKind::Tonal,
+                Some(false),
+                colors.secondary_container,
+                colors.on_secondary_container,
+                false,
+            ),
+            (
+                IconButtonKind::Tonal,
+                Some(true),
+                colors.secondary,
+                colors.on_secondary,
+                false,
+            ),
+            (
+                IconButtonKind::Outlined,
+                None,
+                transparent,
+                colors.on_surface_variant,
+                true,
+            ),
+            (
+                IconButtonKind::Outlined,
+                Some(false),
+                transparent,
+                colors.on_surface_variant,
+                true,
+            ),
+            (
+                IconButtonKind::Outlined,
+                Some(true),
+                colors.inverse_surface,
+                colors.inverse_on_surface,
+                false,
+            ),
+            (
+                IconButtonKind::Standard,
+                None,
+                transparent,
+                colors.on_surface_variant,
+                false,
+            ),
+            (
+                IconButtonKind::Standard,
+                Some(false),
+                transparent,
+                colors.on_surface_variant,
+                false,
+            ),
+            (
+                IconButtonKind::Standard,
+                Some(true),
+                transparent,
+                colors.primary,
+                false,
+            ),
