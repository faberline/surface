+}
+
+#[derive(Serialize)]
+struct Geometry {
+    id: &'static str,
+    hit: Rect,
+    face: Rect,
+    icon: Rect,
+    focus: Rect,
+}
+
+#[derive(Serialize)]
+struct AxButton {
+    id: &'static str,
+    name: &'static str,
+    role: String,
+    disabled: bool,
+    pressed: Option<String>,
+}
+
+#[derive(Serialize)]
+struct Wide {
+    viewport: [u32; 2],
+    geometry: Vec<Geometry>,
