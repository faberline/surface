+#[test]
+fn host_selection_colors_only_paint_enabled_checked_rows() {
+    let pair = SystemColorPair {
+        background: Color::rgb(41, 16, 93),
+        foreground: Color::rgb(248, 215, 173),
+    };
+    for palette in [VerticalMenuPalette::Standard, VerticalMenuPalette::Vibrant] {
+        let mut runtime = Runtime::new(Fixture {
+            mode: palette,
+            selected_item: Some(pair),
+            commands: true,
+            checked: vec!["check-disabled", "check-pins"],
+            ..Fixture::default()
+        })
+        .unwrap();
+        open(&mut runtime, 720., 760.);
+        for id in ["sort-old", "check-pins"] {
+            let face = format!("{id}-face");
+            let label = format!("{id}-label");
+            assert_eq!(node(&runtime, &face).style().background, pair.background);
+            assert_eq!(node(&runtime, &label).style().foreground, pair.foreground);
+        }
+        let theme = runtime.app().theme();
+        let normal = match palette {
+            VerticalMenuPalette::Standard => theme.colors.on_surface,
+            VerticalMenuPalette::Vibrant => theme.colors.on_tertiary_container,
+        };
+        for id in ["sort-new", "report", "check-recent"] {
+            assert_eq!(
+                node(&runtime, &format!("{id}-face")).style().background,
+                Color::TRANSPARENT
+            );
+            assert_eq!(
+                node(&runtime, &format!("{id}-label")).style().foreground,
+                normal
+            );
+        }
+        assert_ne!(
+            node(&runtime, "check-disabled-face").style().background,
+            pair.background
+        );
+        assert_eq!(
+            node(&runtime, "check-disabled-label").style().foreground.3,
+            97
+        );
+    }
+}
