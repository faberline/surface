diff --git a/e2e/src/material_choice_menu_forced.rs b/e2e/src/material_choice_menu_forced.rs
new file mode 100644
index 0000000000000000000000000000000000000000..97df46399988f0c9ff02af7a864fef9cf3ebf070
--- /dev/null
+++ b/e2e/src/material_choice_menu_forced.rs
@@ -0,0 +1,265 @@
+//! Forced-color selection pairs on real vertical choice menu paint.
+
+use anyhow::{Context, Result};
+use serde_json::{json, Value};
+
+use super::material_time_input::{activate, ax, ax_property, ax_tree, bounds, focused, Raster};
+use super::{state, until};
+use crate::browser::{Chrome, Tab};
+use crate::check::step;
+use crate::{check, check_eq, Env};
+
+const OPENER: &str = "menu-demo-opener";
+const VIBRANT: &str = "menu-demo-vibrant";
+const RECENT: &str = "menu-demo-choice-recent";
+const NAME: &str = "menu-demo-choice-name";
+const KIND: &str = "menu-demo-choice-kind";
+const LOCKED: &str = "menu-demo-choice-locked";
+
+pub(super) const STEPS: [&str; 1] = ["M380"];
+
+async fn open(tab: &Tab) -> Result<()> {
+    activate(tab, OPENER).await?;
+    until(tab, "s.menu_demo.open").await?;
+    focused(tab, RECENT).await
+}
+
+fn rgba(value: &Value) -> Result<[u8; 4]> {
+    let color: [u8; 4] =
+        serde_json::from_value(value.clone()).context("resolved system color is RGBA")?;
+    check_eq!(color[3], 255, "the system pair color is opaque");
+    Ok(color)
+}
+
+async fn paint_checked_rows(
+    env: &Env,
+    tab: &Tab,
+    label: &str,
+    expected_pair: [[u8; 4]; 2],
+) -> Result<Value> {
+    let [left, top, width, _] = tab.canvas_box().await?;
+    tab.mouse_move(left + width - 2., top + 2.).await?;
+    tab.settle().await?;
+    let file = format!("material-choice-menu-forced-{label}.png");
+    let path = env.artifact(&file);
+    tab.screenshot(&path).await?;
+    let raster = Raster::read(tab, path).await?;
+    let mut rows = Vec::new();
+    for id in [RECENT, KIND] {
+        let face = bounds(tab, &format!("{id}-face")).await?;
+        let mark = bounds(tab, &format!("{id}-leading")).await?;
+        let fill = raster.sample(face[0] + face[2] / 2., face[1] + 4.)?;
+        let foreground = [
+            expected_pair[1][0],
+            expected_pair[1][1],
+            expected_pair[1][2],
+        ];
+        let background = [
+            expected_pair[0][0],
+            expected_pair[0][1],
+            expected_pair[0][2],
+        ];
+        check_eq!(
+            fill,
+            background,
+            "the {label} enabled checked row paints SelectedItem background"
+        );
+        let mark_pixels = raster.colors(mark)?.get(&foreground).copied().unwrap_or(0);
+        check!(
+            mark_pixels > 8,
+            "the {label} checked mark paints SelectedItemText"
+        );
+        rows.push(json!({"id":id,"face":face,"mark":mark,"fill":fill,
+            "foreground":foreground,"mark_pixels":mark_pixels}));
+    }
+    Ok(json!({"file":file,"canvas":tab.canvas_box().await?,
+        "viewport":[tab.eval("innerWidth").await?,tab.eval("innerHeight").await?],
+        "device_pixel_ratio":tab.eval("devicePixelRatio").await?,"rows":rows}))
+}
+
+async fn check_menu_semantics(tab: &Tab) -> Result<Value> {
+    let tree = ax_tree(tab).await?;
+    let radio = ax(&tree, "menuitemradio", "最近修改")?;
+    let checkbox = ax(&tree, "menuitemcheckbox", "檔案類型")?;
+    let disabled = ax(&tree, "menuitemcheckbox", "鎖定狀態")?;
+    check_eq!(
+        ax_property(radio, "checked"),
+        Some(&json!("true")),
+        "the selected radio remains selected"
+    );
+    check_eq!(
+        ax_property(checkbox, "checked"),
+        Some(&json!("true")),
+        "the selected checkbox remains selected"
+    );
+    check_eq!(
+        ax_property(disabled, "checked"),
+        Some(&json!("true")),
+        "the disabled checkbox retains its selected value"
+    );
+    check_eq!(
+        ax_property(disabled, "disabled"),
+        Some(&json!(true)),
+        "the disabled checkbox exposes its disabled state"
+    );
+    Ok(json!({"radio":radio,"checkbox":checkbox,"disabled_checkbox":disabled}))
+}
+
+async fn selected_pair(tab: &Tab, css: &Value, palette: &str) -> Result<[[u8; 4]; 2]> {
+    let state = state(tab).await?;
+    let actual = &state["menu_demo"]["choice"]["palette"];
+    let item = &state["display_contrast"]["system_colors"]["selected_item"];
+    if css["selected_item"].is_object() {
+        check_eq!(
+            item.clone(),
+            css["selected_item"].clone(),
+            "the application receives the independent CSS SelectedItem pair"
+        );
+        check_eq!(
+            actual[0],
+            css["selected_item"]["background"],
+            "the selected face token comes from SelectedItem"
+        );
+        check_eq!(
+            actual[1],
+            css["selected_item"]["foreground"],
+            "the selected content token comes from SelectedItemText"
+        );
+    } else {
+        check_eq!(
+            css["selected_item_raw"],
+            Value::Null,
+            "the CSS witness found no complete supported SelectedItem pair"
+        );
+        check_eq!(
+            item.clone(),
+            Value::Null,
+            "the browser probe reports SelectedItem unavailable"
+        );
+        let fallback = if palette == "standard" {
+            [
+                css["pairs"]["button"]["background"].clone(),
+                css["pairs"]["button"]["foreground"].clone(),
+            ]
+        } else {
+            [
+                css["pairs"]["canvas"]["foreground"].clone(),
+                css["pairs"]["canvas"]["background"].clone(),
+            ]
+        };
+        check_eq!(
+            actual.clone(),
+            json!(fallback),
+            "the unsupported SelectedItem pair keeps the forced M3 fallback"
+        );
+    }
+    Ok([rgba(&actual[0])?, rgba(&actual[1])?])
+}
+
+async fn palette_pass(env: &Env, tab: &Tab, css: &Value, palette: &str) -> Result<Value> {
+    open(tab).await?;
+    let semantics = check_menu_semantics(tab).await?;
+    let pair = selected_pair(tab, css, palette).await?;
+    // Sample idle selected rows while focus is on an unselected row.
+    tab.press("ArrowDown").await?;
+    focused(tab, NAME).await?;
+    let pixels = paint_checked_rows(env, tab, palette, pair).await?;
+
+    tab.press("End").await?;
+    focused(tab, LOCKED).await?;
+    let before = state(tab).await?;
+    check_eq!(
+        before["menu_demo"]["choice"]["changes"],
+        json!(0),
+        "no choice ran yet"
+    );
+    tab.press("Enter").await?;
+    tab.settle().await?;
+    let after = state(tab).await?;
+    check_eq!(
+        after["menu_demo"]["open"],
+        json!(true),
+        "disabled activation keeps the menu open"
+    );
+    check_eq!(
+        after["menu_demo"]["choice"]["changes"],
+        json!(0),
+        "disabled activation sends no action"
+    );
+    check_eq!(
+        after["menu_demo"]["choice"]["checked"],
+        before["menu_demo"]["choice"]["checked"],
+        "disabled activation preserves selected values"
+    );
+    tab.press("Escape").await?;
+    until(tab, "!s.menu_demo.open").await?;
+    focused(tab, OPENER).await?;
+    Ok(
+        json!({"semantics":semantics,"pixels":pixels,"disabled_activation":after["menu_demo"]["choice"]}),
+    )
+}
+
+pub(super) async fn run(env: &Env, chrome: &Chrome, url: &str) -> Result<()> {
+    step(
+        STEPS[0],
+        "Forced colors use SelectedItem system paint in checked choice menus",
+    );
+    let tab = chrome.page(960, 1200, 2.).await?;
+    super::material_choice_menu::route(&tab, url).await?;
+    let normal_standard = state(&tab).await?["menu_demo"]["choice"]["palette"].clone();
+    activate(&tab, VIBRANT).await?;
+    until(&tab, "s.menu_demo.vibrant").await?;
+    let normal_vibrant = state(&tab).await?["menu_demo"]["choice"]["palette"].clone();
+    activate(&tab, VIBRANT).await?;
+    until(&tab, "!s.menu_demo.vibrant").await?;
+
+    super::material_web_contrast::media(&tab, true, false).await?;
+    let forced = super::material_web_contrast::contrast(&tab, "forced").await?;
+    let css = super::material_web_contrast::palette_with_disabled(&tab, &forced).await?;
+    super::material_web_contrast::hidden_probe(&tab, css["field"].is_object()).await?;
+    let pair_equal_to_highlight = css["selected_item"] == css["pairs"]["highlight"];
+
+    let standard = palette_pass(env, &tab, &css, "standard").await?;
+    activate(&tab, VIBRANT).await?;
+    until(&tab, "s.menu_demo.vibrant").await?;
+    let vibrant = palette_pass(env, &tab, &css, "vibrant").await?;
+
+    super::material_web_contrast::media(&tab, false, false).await?;
+    let normal = super::material_web_contrast::contrast(&tab, "normal").await?;
+    check_eq!(
+        normal["system_colors"],
+        Value::Null,
+        "normal contrast clears forced system pairs"
+    );
+    let restored_vibrant = state(&tab).await?["menu_demo"]["choice"]["palette"].clone();
+    check_eq!(
+        restored_vibrant,
+        normal_vibrant,
+        "clearing forced colors restores the authored Vibrant selection palette"
+    );
+    activate(&tab, VIBRANT).await?;
+    until(&tab, "!s.menu_demo.vibrant").await?;
+    let restored_standard = state(&tab).await?["menu_demo"]["choice"]["palette"].clone();
+    check_eq!(
+        restored_standard,
+        normal_standard,
+        "the authored Standard selection palette is still available"
+    );
+    check!(
+        tab.errors().is_empty(),
+        "the forced choice menu has no browser errors: {:?}",
+        tab.errors()
+    );
+    env.write_json(
+        "browser-material-choice-menu-forced.json",
+        &json!({"browser":chrome.version,"steps":STEPS,"mode":forced["mode"],
+            "selected_item":css["selected_item"],"highlight":css["pairs"]["highlight"],
+            "css_button":css["pairs"]["button"],"css_canvas":css["pairs"]["canvas"],
+            "selected_item_equals_highlight":pair_equal_to_highlight,
+            "standard":standard,"vibrant":vibrant,
+            "normal_palettes":{"standard":normal_standard,"vibrant":normal_vibrant},
+            "restored_palettes":{"standard":restored_standard,"vibrant":restored_vibrant},
+            "errors":tab.errors()}),
+    )?;
+    Ok(())
+}
