+fn corner_distance([x, y]: [f32; 2], face: Rect, radius: f32) -> f32 {
+    let dx = (face.x + radius - x)
+        .max(x - (face.x + face.width - radius))
+        .max(0.);
+    let dy = (face.y + radius - y)
+        .max(y - (face.y + face.height - radius))
+        .max(0.);
+    dx.hypot(dy)
+}
