 use surface_devtools_protocol::{ErrorCode, Reply, PAGE_SCREENSHOT, VERSION};
 use surface_wgpu::{Capture, Renderer};
 
+#[cfg(target_os = "macos")]
+use surface_app::DisplayContrast;
+
+#[cfg(target_os = "macos")]
+const TEST_SET_DISPLAY_CONTRAST: &str = "Test.setDisplayContrast";
+
+#[cfg(target_os = "macos")]
+fn contrast_mode(contrast: DisplayContrast) -> &'static str {
+    match contrast {
+        DisplayContrast::Normal => "normal",
+        DisplayContrast::Increased => "increased",
+        DisplayContrast::Forced(_) => "forced",
+        _ => "unknown",
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn set_test_display_contrast<A: Application>(
+    runtime: &mut Runtime<A>,
+    id: u64,
+    params: &serde_json::Value,
+) -> Reply {
+    let contrast = match params.get("mode").and_then(serde_json::Value::as_str) {
+        Some("normal") => DisplayContrast::Normal,
+        Some("increased") => DisplayContrast::Increased,
+        _ => {
+            return Reply::error(
+                id,
+                ErrorCode::InvalidParams,
+                "mode must be normal or increased",
+            )
+        }
+    };
+    match runtime.set_display_contrast(contrast) {
+        Ok(redraw) => Reply::ok(
+            id,
+            serde_json::json!({
+                "schema": "surface.test.set-display-contrast.v1",
+                "mode": contrast_mode(runtime.display_contrast()),
+                "redraw": redraw,
+            }),
+        ),
+        Err(error) => Reply::error(
+            id,
+            ErrorCode::ActionFailed,
+            format!("display contrast: {error}"),
+        ),
+    }
+}
