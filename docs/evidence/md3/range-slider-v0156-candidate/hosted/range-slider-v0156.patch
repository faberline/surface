+                owner: DragOwner::SliderPair
+            })
+        );
+        capture.accept_down(None, Some(DragOwner::Point));
+        assert!(capture.capture_lost(mouse));
+        assert_eq!(
+            capture.take_loss(),
+            Some(Contact {
+                pointer: mouse,
+                owner: DragOwner::Point
+            })
+        );
+        assert_eq!(capture.take_loss(), None);
     }
 }
