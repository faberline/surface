+        "distance-upper",
+        "distance-lower-handle",
+        "distance-upper-handle",
+        "distance-tick-4",
+    ] {
+        let a = bounds(&ltr, key);
+        let b = bounds(&rtl, key);
+        assert_eq!(a.x + right(b), owner.x + right(owner), "{key}");
