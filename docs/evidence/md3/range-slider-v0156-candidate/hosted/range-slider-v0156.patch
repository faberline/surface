+    assert_eq!(rtl.focused(), Some("distance-lower"));
+    rtl.dispatch(Event::FocusNext { reverse: false }).unwrap();
+    assert_eq!(rtl.focused(), Some("distance-upper"));
+    rtl.dispatch(Event::FocusNext { reverse: true }).unwrap();
+    assert_eq!(rtl.focused(), Some("distance-lower"));
+}
