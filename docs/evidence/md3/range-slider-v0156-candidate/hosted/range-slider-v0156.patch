+        let mut runtime = home();
+        open(&mut runtime, WIDE);
+        let rail = bounds(&runtime, "range-slider-demo-continuous-rail");
+        let (x, y) = (rail.x + rail.width * 0.875, rail.y + rail.height / 2.);
