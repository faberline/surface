+async fn touch(tab: &Tab, kind: &str, point: Option<[f64; 2]>) -> Result<()> {
+    let points = point.map_or_else(|| json!([]), |[x, y]| json!([{"x":x,"y":y,"id":1}]));
+    tab.cdp(
+        "Input.dispatchTouchEvent",
+        json!({"type":kind,"touchPoints":points}),
+    )
+    .await?;
+    Ok(())
