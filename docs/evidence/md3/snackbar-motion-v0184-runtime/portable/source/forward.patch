+
+async fn set_motion_preference(tab: &Tab, preference: &str) -> Result<()> {
+    tab.cdp(
+        "Emulation.setEmulatedMedia",
+        json!({"features":[{"name":"prefers-reduced-motion","value":preference}]}),
+    )
+    .await?;
+    tab.wait_for(&format!(
+        "matchMedia({}).matches",
+        js(format!("(prefers-reduced-motion: {preference})"))
+    ))
+    .await
+}
+
+pub(super) async fn run_motion(env: &Env, chrome: &Chrome, url: &str) -> Result<()> {
+    use super::material_time_input::{resize, Raster};
+
+    let tab = chrome.page(960, 804, 2.).await?;
+    set_motion_preference(&tab, "no-preference").await?;
+    tab.goto(url).await?;
+    crate::smoke::ready(&tab, "gallery").await?;
+    visible_click(&tab, "section-2").await?;
+    until(&tab, "s.section === 2 && !s.dark").await?;
+    pin_clock(&tab).await?;
+    observe_announcements(&tab).await?;
+
+    step(
+        MOTION_STEPS[0],
+        "Snackbar exit keeps paint while removing status and controls immediately",
+    );
+    let id = show(&tab, SHOW_UNDO, "undo").await?;
+    let status = element(&format!("{id}-text"));
+    let dismiss = format!("{id}-dismiss");
+    let before = point(&tab, &id).await?;
+    let focus = point(&tab, &dismiss).await?;
+    let rest_path = env.artifact("material-snackbar-motion-light-rest.png");
+    tab.screenshot(&rest_path).await?;
+    let rest_image = Raster::read(&tab, rest_path).await?;
+    let light_fill = rest_image.sample(before.b[0] + 8., before.b[1] + 8.)?;
+    project(&tab, &dismiss).await?;
+    tab.press("Enter").await?;
+    ready(
+        &tab,
+        &format!("r.visible === null && r.dismissed === 1 && r.presented_id === {id:?}"),
+    )
+    .await?;
+    projected_focus(&tab, SHOW_UNDO).await?;
+    tab.wait_for(&format!(
+        "{status} === null && {} === null && {} === null",
+        element(&dismiss),
+        element(&format!("{id}-action"))
+    ))
+    .await?;
+    tab.click(focus.x, focus.y).await?;
+    ready(&tab, "r.dismissed === 1 && r.acted === 0").await?;
+
+    clock_at(&tab, 220).await?;
+    let retired = point(&tab, &id).await?;
+    check!(
+        retired.b[1] > before.b[1],
+        "exit moves toward the lower edge"
+    );
+    check_eq!(retired.b[3], before.b[3], "exit keeps the measured height");
+    let exit_progress = state(&tab).await?["snackbar"]["motion_progress"].clone();
+    let exit_path = env.artifact("material-snackbar-motion-light-exit.png");
+    tab.screenshot(&exit_path).await?;
+    let exit_image = Raster::read(&tab, exit_path).await?;
+    check_eq!(
+        exit_image.sample(retired.b[0] + 8., retired.b[1] + 8.)?,
+        light_fill,
+        "the departing Snackbar still paints its surface"
+    );
+    check!(
+        exit_image.sample(before.b[0] + 8., before.b[1] + 8.)? != light_fill,
+        "the retired view no longer paints at the original position"
+    );
+    clock_at(&tab, 620).await?;
+    ready(&tab, "r.presented_id === null && r.motion_progress === 0").await?;
+    check_eq!(
+        tab.eval("window.snackbarAnnouncements.messages").await?,
+        json!([UNDO_MESSAGE]),
+        "exit paint never repeats the status message"
+    );
+
+    step(
+        MOTION_STEPS[1],
+        "Reduce Motion settles a narrow dark RTL Snackbar and preserves focus",
+    );
+    visible_click(&tab, "theme").await?;
+    visible_click(&tab, "snackbar-direction").await?;
+    visible_click(&tab, "snackbar-scale").await?;
+    until(
+        &tab,
+        "s.dark && s.snackbar.rtl && s.snackbar.text_scale === 2",
+    )
+    .await?;
+    set_motion_preference(&tab, "reduce").await?;
+    visible_click(&tab, SHOW_LONG).await?;
+    ready(&tab, "r.visible === 'long' && r.motion_progress === 1").await?;
+    let id = panel_id(&tab).await?;
+    resize(&tab, 320, 720).await?;
+    let narrow = point(&tab, &id).await?;
+    check!(
+        narrow.b[0] >= 0.
+            && narrow.b[1] >= 0.
+            && narrow.b[0] + narrow.b[2] <= narrow.canvas[2]
+            && narrow.b[1] + narrow.b[3] <= narrow.canvas[3],
+        "the open large-text Snackbar stays within the narrow viewport"
+    );
+    let dark_path = env.artifact("material-snackbar-motion-dark-rtl-200.png");
+    tab.screenshot(&dark_path).await?;
+    let dark_fill = Raster::read(&tab, dark_path)
+        .await?
+        .sample(narrow.b[0] + 8., narrow.b[1] + 8.)?;
+    check!(
+        dark_fill != light_fill,
+        "the dark theme changes the surface paint"
+    );
+    project(&tab, &format!("{id}-dismiss")).await?;
+    tab.press("Space").await?;
+    ready(
+        &tab,
+        "r.visible === null && r.presented_id === null && r.dismissed === 2 && r.motion_progress === 0",
+    )
+    .await?;
+    projected_focus(&tab, SHOW_LONG).await?;
+    check!(
+        tab.errors().is_empty(),
+        "Snackbar motion has no page errors"
+    );
+    env.write_json(
+        "material-snackbar-motion.json",
+        &json!({"browser":chrome.version, "steps": MOTION_STEPS,
+            "light_rest":before.b, "light_exit":retired.b, "exit_progress":exit_progress,
+            "dark_rtl_200":narrow.b, "light_fill":light_fill, "dark_fill":dark_fill,
+            "canvases":[before.canvas, retired.canvas, narrow.canvas],
+            "state":state(&tab).await?["snackbar"], "errors":tab.errors()}),
+    )
+}
