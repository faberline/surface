diff --git a/crates/surface-material/src/snackbar_motion.rs b/crates/surface-material/src/snackbar_motion.rs
new file mode 100644
index 0000000000000000000000000000000000000000..940ca58b1b13c49aed66b7d79b3b27dbb891be9b
--- /dev/null
+++ b/crates/surface-material/src/snackbar_motion.rs
@@ -0,0 +1,104 @@
+//! Presentation for a caller-owned Snackbar.
+
+use surface_app::{AnimationFrame, AnimationUpdate, ToggleMotion, ToggleSpring};
+
+/// The displayed fraction of a Snackbar that enters or leaves its host.
+///
+/// Keep one track for each presented message. Rebuild immediately when the
+/// application closes it and keep the outgoing view only for paint. The queue
+/// can advance independently. A replacement message can start its own track.
+#[derive(Default)]
+pub struct SnackbarMotion {
+    track: ToggleMotion,
+    progress: f32,
+}
+
+impl SnackbarMotion {
+    /// Start hidden or at the fully shown resting position.
+    pub fn new(open: bool) -> Self {
+        Self {
+            track: ToggleMotion::new(open),
+            progress: if open { 1. } else { 0. },
+        }
+    }
+
+    /// Zero is hidden and one is at rest. Use this for presentation only.
+    pub fn progress(&self) -> f32 {
+        self.progress
+    }
+
+    /// Whether to mount the live Snackbar or keep its outgoing paint.
+    pub fn should_mount(&self, open: bool) -> bool {
+        open || self.progress > 0.
+    }
+
+    /// Update the presentation. Reduce Motion and a missing or non-finite
+    /// frame clock settle immediately. A reversal starts from the current pose.
+    pub fn advance(&mut self, frame: &AnimationFrame<'_>, open: bool) -> AnimationUpdate {
+        let snap = frame.reduced_motion || (!open && self.progress == 0.);
+        let (progress, request_next) =
+            self.track
+                .sample(open, frame.now_ms, snap, ToggleSpring::StandardFastEffects);
+        let rebuild = self.progress != progress;
+        self.progress = progress;
+        AnimationUpdate {
+            rebuild,
+            request_next,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use surface::{MicroDom, Node, Role};
+
+    #[test]
+    fn an_interrupted_entrance_exits_from_its_last_pose() {
+        let dom = MicroDom::new(Node::new(Role::Window, ""));
+        let frame = |now_ms| AnimationFrame {
+            now_ms: Some(now_ms),
+            reduced_motion: false,
+            dom: &dom,
+            layout: None,
+        };
+        let mut motion = SnackbarMotion::default();
+        assert!(!motion.should_mount(false));
+        assert!(motion.advance(&frame(0.), true).request_next);
+        assert!(motion.advance(&frame(45.), true).rebuild);
+        let before = motion.progress();
+        assert!((0. ..1.).contains(&before) && before > 0.);
+        assert!(motion.advance(&frame(45.), false).request_next);
+        assert_eq!(motion.progress(), before);
+        assert!(motion.should_mount(false));
+        motion.advance(&frame(100.), false);
+        assert!(motion.progress() < before);
+        let settled = motion.advance(&frame(1000.), false);
+        assert!(!settled.request_next);
+        assert!(!motion.should_mount(false));
+    }
+
+    #[test]
+    fn missing_clock_and_reduced_motion_snap_without_retaining_a_view() {
+        let dom = MicroDom::new(Node::new(Role::Window, ""));
+        let frame = |now_ms, reduced_motion| AnimationFrame {
+            now_ms,
+            reduced_motion,
+            dom: &dom,
+            layout: None,
+        };
+        let mut motion = SnackbarMotion::new(true);
+        for frame in [
+            frame(None, false),
+            frame(Some(f64::NAN), false),
+            frame(Some(5.), true),
+        ] {
+            let closed = motion.advance(&frame, false);
+            assert!(closed.rebuild && !closed.request_next);
+            assert!(!motion.should_mount(false));
+            let opened = motion.advance(&frame, true);
+            assert!(opened.rebuild && !opened.request_next);
+            assert_eq!(motion.progress(), 1.);
+        }
+    }
+}
