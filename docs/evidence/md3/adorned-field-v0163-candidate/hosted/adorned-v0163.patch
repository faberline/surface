+                    && path.rect().height == 16.
+        )));
+        assert!(bounds(&runtime, VALUE).width > 0.);
+        assert!(text_run(&narrow, "每月").is_some());
+        assert_eq!(runtime.focused(), Some(ACTION));
+    }
+}
