+        draw(&mut runtime);
+        assert_eq!(offset(&runtime, "middle"), (0., 0.));
+        assert_eq!(offset(&runtime, "outer"), (0., 20.));
+        assert_eq!(runtime.app().custom_wheels, 0);
+        assert_eq!(runtime.app().activations, 0);
+    }
+}
