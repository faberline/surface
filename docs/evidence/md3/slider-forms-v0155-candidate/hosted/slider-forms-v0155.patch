+    assert_eq!(runtime.app().requests, [-37.25, 100.]);
+    assert_eq!(runtime.focused(), Some(ID));
+    assert_eq!(bounds(&runtime, ID), owner);
+    assert_eq!(bounds(&runtime, "volume-rail"), rail);
+    assert_eq!(center(bounds(&runtime, "volume-handle")), rail.x);
