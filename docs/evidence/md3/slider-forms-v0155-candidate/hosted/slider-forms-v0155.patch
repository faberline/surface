+                Action::SetValue,
+                Action::Increment,
+                Action::Decrement,
+            ] {
+                let expected = name == "vertical"
+                    || (matches!(name, "horizontal" | "legacy") && action == Action::Focus);
+                assert_eq!(node.supports_action(action), expected, "{name}: {action:?}");
+            }
+        }
+    }
