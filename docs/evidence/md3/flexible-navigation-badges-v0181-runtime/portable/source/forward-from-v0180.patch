diff --git a/crates/surface-material/tests/flexible_navigation_bar_badges.rs b/crates/surface-material/tests/flexible_navigation_bar_badges.rs
new file mode 100644
index 0000000000000000000000000000000000000000..44ef6bfd650fedc86c17ad22888d9a855132cb60
--- /dev/null
+++ b/crates/surface-material/tests/flexible_navigation_bar_badges.rs
@@ -0,0 +1,151 @@
+use surface::{Node, PaintOp, Rect, Role, TextMeasurer};
+use surface_app::{Application, Event, Runtime, View};
+use surface_material::{
+    shape::LayoutDirection, BadgeContent, BadgedFlexibleNavigationBarItem, ChoiceState,
+    FlexibleNavigationBarOptions, NavigationRailItem, Theme, VectorIcon,
+};
+
+struct Page {
+    width: f32,
+    direction: LayoutDirection,
+    badge: BadgeContent<'static>,
+    scale: f32,
+    icon: VectorIcon,
+}
+#[derive(Clone)]
+enum Message {
+    Change(BadgeContent<'static>),
+    Press(usize),
+}
+impl Application for Page {
+    type Message = Message;
+    fn update(&mut self, message: Message) {
+        match message {
+            Message::Change(badge) => self.badge = badge,
+            Message::Press(_index) => {}
+        }
+    }
+    fn text_scale(&self) -> f32 {
+        self.scale
+    }
+    fn view(&self) -> View<Message> {
+        let items = ["home", "inbox", "disabled"]
+            .into_iter()
+            .enumerate()
+            .map(|(i, id)| BadgedFlexibleNavigationBarItem {
+                item: NavigationRailItem {
+                    id,
+                    label: ["首頁", "收件匣", "設定"][i],
+                    accessible_name: if i == 1 {
+                        "收件匣，1200 封未讀"
+                    } else {
+                        ""
+                    },
+                    icon: &self.icon,
+                    state: ChoiceState {
+                        selected: i == 1,
+                        disabled: i == 2,
+                    },
+                    message: Message::Press(i),
+                },
+                badge: if i == 1 {
+                    self.badge
+                } else {
+                    BadgeContent::Hidden
+                },
+            });
+        let options = FlexibleNavigationBarOptions {
+            id: "bar",
+            name: "導覽",
+            available_width: self.width,
+            direction: self.direction,
+        };
+        let theme = Theme::light();
+        let bar = if self.width < 600. {
+            theme.flexible_navigation_bar_with_badges(options, items)
+        } else {
+            theme.horizontal_flexible_navigation_bar_with_badges(options, items)
+        };
+        View::new(Node::new(Role::Window, "Test")).children(bar)
+    }
+}
+struct Fonts;
+impl TextMeasurer for Fonts {
+    fn measure(&mut self, text: &str, size: f32, width: Option<f32>) -> (f32, f32) {
+        let natural = text.chars().count() as f32 * size;
+        let w = width.unwrap_or(natural).min(natural);
+        (w, (natural / w.max(1.)).ceil().max(1.) * size * 1.5)
+    }
+}
+fn rect(app: &Runtime<Page>, id: &str) -> Rect {
+    app.computed().unwrap().nodes[app.dom().by_id(id).unwrap().index()].bounds
+}
+fn page(width: f32, direction: LayoutDirection, scale: f32) -> Runtime<Page> {
+    Runtime::new(Page {
+        width,
+        direction,
+        badge: BadgeContent::Hidden,
+        scale,
+        icon: VectorIcon::new([[2., 2.], [22., 2.], [22., 22.], [2., 22.]]).unwrap(),
+    })
+    .unwrap()
+}
+#[test]
+fn badge_updates_preserve_destination_focus_and_stable_geometry() {
+    for width in [320., 600., 839.] {
+        for direction in [LayoutDirection::LeftToRight, LayoutDirection::RightToLeft] {
+            for scale in [1., 2.] {
+                let mut app = page(width, direction, scale);
+                app.render(width, 500., &mut Fonts).unwrap();
+                let before = rect(&app, "inbox");
+                if width >= 600. {
+                    assert_eq!(before.width, 112.);
+                }
+                app.dispatch(Event::FocusNext { reverse: false }).unwrap();
+                app.dispatch(Event::FocusNext { reverse: false }).unwrap();
+                assert_eq!(app.focused(), Some("inbox"));
+                for badge in [
+                    BadgeContent::Dot,
+                    BadgeContent::Label("未讀"),
+                    BadgeContent::Count(1200),
+                    BadgeContent::Hidden,
+                ] {
+                    app.apply(Message::Change(badge)).unwrap();
+                    let display = app.render(width, 500., &mut Fonts).unwrap();
+                    assert_eq!(app.focused(), Some("inbox"));
+                    assert_eq!(rect(&app, "inbox"), before);
+                    let button = app.dom().get(app.dom().by_id("inbox").unwrap()).unwrap();
+                    assert_eq!(button.name(), "收件匣，1200 封未讀");
+                    assert_eq!(button.is_selected(), Some(true));
+                    if !matches!(badge, BadgeContent::Hidden) {
+                        let face = display
+                            .ops
+                            .iter()
+                            .find_map(|op| match op {
+                                PaintOp::Shape { rect, color, .. }
+                                | PaintOp::Quad { rect, color, .. }
+                                    if *color == Theme::light().colors.error =>
+                                {
+                                    Some(*rect)
+                                }
+                                _ => None,
+                            })
+                            .expect("visible badge face");
+                        assert!(
+                            face.x >= before.x
+                                && face.y >= before.y
+                                && face.x + face.width <= before.x + before.width
+                                && face.y + face.height <= before.y + before.height,
+                            "badge stays within destination: {face:?} vs {before:?}"
+                        );
+                    }
+                    if matches!(badge, BadgeContent::Count(_)) {
+                        assert!(display.ops.iter().any(
+                            |op| matches!(op, PaintOp::StyledText { text, .. } if text == "999+")
+                        ));
+                    }
+                }
+            }
+        }
+    }
+}
