diff --git a/e2e/src/material_flexible_navigation_badges.rs b/e2e/src/material_flexible_navigation_badges.rs
new file mode 100644
index 0000000000000000000000000000000000000000..00f9017c63fb1bd59e41f8d938b1dd5da3dcff27
--- /dev/null
+++ b/e2e/src/material_flexible_navigation_badges.rs
@@ -0,0 +1,396 @@
+//! Browser proof for application-owned badges on the Expressive navigation bar.
+
+use anyhow::{Context, Result};
+use serde_json::{json, Value};
+
+use super::material_time_input::{
+    activate, ax, ax_property, ax_tree, bounds, contains, focus_projected, focused, near,
+    projected, resize, Raster,
+};
+use super::{state, until};
+use crate::browser::{Chrome, Tab};
+use crate::check::step;
+use crate::{check, check_eq, Env};
+
+pub(super) const STEPS: [&str; 2] = ["M385", "M386"];
+const SHOW: &str = "navigation-badges-demo-show";
+const BACK: &str = "navigation-badges-demo-back";
+const THEME: &str = "navigation-badges-demo-theme";
+const RTL: &str = "navigation-badges-demo-rtl";
+const LARGE: &str = "navigation-badges-demo-large-text";
+const BAR: &str = "navigation-badges-demo-bar";
+const HOME: &str = "navigation-badges-demo-home";
+const INBOX: &str = "navigation-badges-demo-inbox";
+const UPDATES: &str = "navigation-badges-demo-updates";
+const EXPLORE: &str = "navigation-badges-demo-explore";
+const SETTINGS: &str = "navigation-badges-demo-settings";
+const IDS: [&str; 5] = [HOME, INBOX, UPDATES, EXPLORE, SETTINGS];
+const NAMES: [&str; 5] = [
+    "首頁",
+    "收件匣，1200 則未讀",
+    "最新消息，有新內容",
+    "探索路線，有新內容",
+    "設定",
+];
+const PAGE_NAMES: [&str; 5] = ["首頁", "收件匣", "最新消息", "探索路線", "設定"];
+const STEM: &str = "material-flexible-navigation-badges";
+type Rect = [f64; 4];
+type Rgb = [u8; 3];
+
+fn pixels_near(image: &Raster, rect: Rect, color: Rgb) -> Result<usize> {
+    Ok(image
+        .colors(rect)?
+        .iter()
+        .filter(|(actual, _)| actual.iter().zip(color).all(|(a, b)| a.abs_diff(b) <= 8))
+        .map(|(_, count)| count)
+        .sum())
+}
+
+fn rgb(value: &Value, name: &str) -> Result<Rgb> {
+    let [r, g, b, a]: [u8; 4] = serde_json::from_value(value.clone())
+        .with_context(|| format!("{name} is an RGBA palette token"))?;
+    check_eq!(a, 255, "{name} is opaque");
+    Ok([r, g, b])
+}
+
+async fn route(tab: &Tab, url: &str) -> Result<()> {
+    tab.goto(url).await?;
+    crate::smoke::ready(tab, "gallery").await?;
+    resize(tab, 960, 1800).await?;
+    activate(tab, "section-3").await?;
+    until(tab, "s.section === 3").await?;
+    activate(tab, SHOW).await?;
+    until(tab, "s.navigation_badges.visible").await?;
+    focused(tab, BACK).await
+}
+
+async fn current(tab: &Tab, id: &str, page: &str, activations: u64) -> Result<()> {
+    until(
+        tab,
+        &format!(
+            "s.navigation_badges.selected === {id:?} && s.navigation_badges.page === {page:?} &&
+             s.navigation_badges.activations === {activations}"
+        ),
+    )
+    .await?;
+    tab.wait_for(&format!(
+        "{}?.getAttribute('aria-current') === 'page' &&
+         document.querySelectorAll('#surface-accessibility [aria-current=page]').length === 1",
+        projected(id)
+    ))
+    .await
+}
+
+async fn geometry(tab: &Tab, width: f64, horizontal: bool, rtl: bool) -> Result<Value> {
+    let bar = bounds(tab, BAR).await?;
+    check_eq!(bar[2], width, "the bar uses the measured viewport width");
+    check_eq!(
+        state(tab).await?["navigation_badges"]["horizontal"],
+        json!(horizontal),
+        "the measured breakpoint selects the expected layout"
+    );
+    let mut cells = Vec::new();
+    for (index, id) in IDS.iter().copied().enumerate() {
+        let cell = bounds(tab, id).await?;
+        check!(
+            cell[2] >= 48. && cell[3] >= 48.,
+            "{id} has a usable hit target: {cell:?}"
+        );
+        check!(
+            contains(bar, cell),
+            "{id} stays inside the bar clip: {cell:?}"
+        );
+        let visual = if rtl { IDS.len() - 1 - index } else { index };
+        let (expected_x, expected_width) = if horizontal {
+            (
+                bar[0] + (width - 112. * IDS.len() as f64) / 2. + 112. * visual as f64,
+                112.,
+            )
+        } else {
+            // The layout engine rounds cell edges. Adjacent widths can differ by one dp.
+            let edge = |index| (bar[0] + width / IDS.len() as f64 * index as f64).round();
+            (edge(visual), edge(visual + 1) - edge(visual))
+        };
+        check!(
+            near(cell[0], expected_x) && near(cell[2], expected_width),
+            "{id} follows the measured cell width and visual direction: {cell:?}"
+        );
+        cells.push(json!({"id":id,"bounds":cell}));
+    }
+    Ok(json!({"bar":bar,"cells":cells,"horizontal":horizontal,"rtl":rtl}))
+}
+
+async fn accessibility(tab: &Tab) -> Result<Value> {
+    let tree = ax_tree(tab).await?;
+    let navigation = ax(&tree, "navigation", "導覽列徽章範例")?;
+    let mut items = Vec::new();
+    for (index, (id, name)) in IDS.iter().zip(NAMES).enumerate() {
+        let node = ax(&tree, "button", name)?;
+        let disabled = ax_property(node, "disabled")
+            .cloned()
+            .unwrap_or(Value::Bool(false));
+        check_eq!(
+            disabled,
+            json!(index == 4),
+            "{id} exposes its disabled state"
+        );
+        let current = ax_property(node, "current").cloned().unwrap_or(Value::Null);
+        items.push(json!({"id":id,"name":name,"disabled":disabled,"current":current}));
+    }
+    Ok(json!({"landmark":navigation["name"],"items":items}))
+}
+
+async fn capture(
+    env: &Env,
+    tab: &Tab,
+    label: &str,
+    width: f64,
+    horizontal: bool,
+    rtl: bool,
+) -> Result<Value> {
+    let layout = geometry(tab, width, horizontal, rtl).await?;
+    let canvas = tab.canvas_box().await?;
+    let viewport = [0., 0., canvas[2], canvas[3]];
+    let title = bounds(tab, "navigation-badges-demo-title").await?;
+    check!(
+        contains(viewport, title),
+        "the title stays inside the canvas"
+    );
+    let bar = layout["bar"].as_array().context("bar geometry")?;
+    let bar_rect: Rect = serde_json::from_value(json!(bar))?;
+    check!(
+        contains(viewport, bar_rect),
+        "bar is fully inside the canvas"
+    );
+    let data = state(tab).await?;
+    let fill = rgb(&data["navigation_badges"]["error_color"], "Error")?;
+    let ink = rgb(&data["navigation_badges"]["on_error_color"], "On Error")?;
+    let path_name = format!("{STEM}-{label}.png");
+    let path = env.artifact(&path_name);
+    tab.settle().await?;
+    tab.screenshot(&path).await?;
+    let image = Raster::read(tab, path).await?;
+
+    let mut paint = Vec::new();
+    for (index, id) in IDS.iter().copied().enumerate() {
+        let owner = bounds(tab, id).await?;
+        let error_pixels = pixels_near(&image, owner, fill)?;
+        let on_error_pixels = pixels_near(&image, owner, ink)?;
+        match index {
+            0 | 4 => {
+                check_eq!(error_pixels, 0, "hidden {id} has no Error badge pixels");
+            }
+            1 | 3 => {
+                check!(
+                    error_pixels >= 30,
+                    "content badge paints inside {id}: {error_pixels}"
+                );
+                check!(
+                    on_error_pixels >= 4,
+                    "content badge text paints inside {id}"
+                );
+            }
+            2 => {
+                check!(
+                    error_pixels >= 8,
+                    "dot badge paints inside {id}: {error_pixels}"
+                );
+            }
+            _ => unreachable!(),
+        }
+        paint.push(json!({"id":id,"owner":owner,"error_pixels":error_pixels,
+            "on_error_pixels":on_error_pixels}));
+    }
+    Ok(json!({
+        "canvas":canvas,
+        "device_pixel_ratio":tab.eval("devicePixelRatio").await?,
+        "viewport":[canvas[2],canvas[3]],
+        "layout":layout,
+        "colors":{"error":fill,"on_error":ink},
+        "paint":paint,
+        "accessibility":accessibility(tab).await?,
+        "screenshot":path_name,
+    }))
+}
+
+async fn light(env: &Env, tab: &Tab) -> Result<Value> {
+    resize(tab, 599, 720).await?;
+    until(
+        tab,
+        "s.navigation_badges.preview_width === 599 && !s.navigation_badges.horizontal",
+    )
+    .await?;
+    current(tab, INBOX, PAGE_NAMES[1], 0).await?;
+    check_eq!(
+        state(tab).await?["navigation_badges"]["destinations"],
+        json!(IDS),
+        "stable destination IDs stay in source order"
+    );
+    check_eq!(
+        state(tab).await?["navigation_badges"]["selected"],
+        json!(INBOX),
+        "the application-owned default selection is Inbox"
+    );
+    let mut layouts = vec![geometry(tab, 599., false, false).await?];
+    resize(tab, 600, 720).await?;
+    until(
+        tab,
+        "s.navigation_badges.preview_width === 600 && s.navigation_badges.horizontal",
+    )
+    .await?;
+    current(tab, INBOX, PAGE_NAMES[1], 0).await?;
+    layouts.push(geometry(tab, 600., true, false).await?);
+    resize(tab, 599, 720).await?;
+    until(
+        tab,
+        "s.navigation_badges.preview_width === 599 && !s.navigation_badges.horizontal",
+    )
+    .await?;
+    current(tab, INBOX, PAGE_NAMES[1], 0).await?;
+
+    let mut focus_order = Vec::new();
+    focus_projected(tab, BACK).await?;
+    for id in [THEME, RTL, LARGE, HOME] {
+        tab.press("Tab").await?;
+        focused(tab, id).await?;
+        focus_order.push(id);
+    }
+    tab.press("Enter").await?;
+    current(tab, HOME, PAGE_NAMES[0], 1).await?;
+    focused(tab, HOME).await?;
+    for id in [INBOX, UPDATES, EXPLORE] {
+        tab.press("Tab").await?;
+        focused(tab, id).await?;
+        current(tab, HOME, PAGE_NAMES[0], 1).await?;
+        focus_order.push(id);
+    }
+    layouts.push(geometry(tab, 599., false, false).await?);
+
+    resize(tab, 600, 720).await?;
+    until(
+        tab,
+        "s.navigation_badges.preview_width === 600 && s.navigation_badges.horizontal",
+    )
+    .await?;
+    current(tab, HOME, PAGE_NAMES[0], 1).await?;
+    check_eq!(
+        state(tab).await?["navigation_badges"]["destinations"],
+        json!(IDS),
+        "breakpoint changes keep destination identity"
+    );
+    layouts.push(geometry(tab, 600., true, false).await?);
+    focused(tab, EXPLORE).await?;
+    let image = capture(env, tab, "wide-light-600", 600., true, false).await?;
+
+    let bad = bounds(tab, SETTINGS).await?;
+    let canvas = tab.canvas_box().await?;
+    let x = canvas[0] + bad[0] + bad[2] / 2.;
+    let y = canvas[1] + bad[1] + bad[3] / 2.;
+    tab.click(x, y).await?;
+    tab.settle().await?;
+    current(tab, HOME, PAGE_NAMES[0], 1).await?;
+    check!(
+        state(tab).await?["focused"] != SETTINGS,
+        "disabled pointer target never focuses"
+    );
+
+    resize(tab, 599, 720).await?;
+    until(
+        tab,
+        "!s.navigation_badges.horizontal && s.navigation_badges.preview_width === 599",
+    )
+    .await?;
+    current(tab, HOME, PAGE_NAMES[0], 1).await?;
+    layouts.push(geometry(tab, 599., false, false).await?);
+    let tree = accessibility(tab).await?;
+    Ok(
+        json!({"layouts":layouts,"focus_order":focus_order,"current_after_resize":HOME,
+        "activations":1,"disabled_pointer":SETTINGS,"accessibility":tree,"image":image}),
+    )
+}
+
+async fn dark_rtl_large(env: &Env, tab: &Tab) -> Result<Value> {
+    resize(tab, 320, 720).await?;
+    activate(tab, THEME).await?;
+    until(tab, "s.navigation_badges.dark").await?;
+    activate(tab, RTL).await?;
+    until(tab, "s.navigation_badges.rtl").await?;
+    activate(tab, LARGE).await?;
+    until(tab, "s.navigation_badges.text_scale === 2").await?;
+    current(tab, HOME, PAGE_NAMES[0], 1).await?;
+    let image = capture(env, tab, "compact-dark-rtl-200", 320., false, true).await?;
+    let geometry = geometry(tab, 320., false, true).await?;
+    let data = state(tab).await?;
+    check_eq!(data["navigation_badges"]["dark"], true, "dark theme");
+    check_eq!(data["navigation_badges"]["rtl"], true, "RTL layout");
+    check_eq!(
+        data["navigation_badges"]["text_scale"],
+        2.0,
+        "large text scale"
+    );
+    let ax = accessibility(tab).await?;
+    Ok(
+        json!({"geometry":geometry,"dark":true,"rtl":true,"text_scale":2.0,
+        "current":data["navigation_badges"]["selected"],"accessibility":ax,"image":image}),
+    )
+}
+
+async fn acknowledge(env: &Env, tab: &Tab) -> Result<Value> {
+    activate(tab, INBOX).await?;
+    current(tab, INBOX, PAGE_NAMES[1], 2).await?;
+    focused(tab, INBOX).await?;
+    until(
+        tab,
+        "s.navigation_badges.badges[1] === 'hidden' && s.navigation_badges.unread_count === 0",
+    )
+    .await?;
+    let tree = ax_tree(tab).await?;
+    let button = ax(&tree, "button", PAGE_NAMES[1])?;
+    let accessible_name = button["name"]["value"].clone();
+    let fill = rgb(
+        &state(tab).await?["navigation_badges"]["error_color"],
+        "Error",
+    )?;
+    let filename = format!("{STEM}-acknowledged.png");
+    let path = env.artifact(&filename);
+    tab.screenshot(&path).await?;
+    let image = Raster::read(tab, path).await?;
+    check_eq!(
+        pixels_near(&image, bounds(tab, INBOX).await?, fill)?,
+        0,
+        "acknowledging the count badge clears its paint"
+    );
+    Ok(json!({"id":INBOX,"accessible_name":accessible_name,"activations":2,"screenshot":filename}))
+}
+
+pub(super) async fn run(env: &Env, chrome: &Chrome, url: &str) -> Result<()> {
+    let tab = chrome.page(960, 844, 2.0).await?;
+    route(&tab, url).await?;
+    step(
+        STEPS[0],
+        "Navigation badge owners and selection persist across 599 and 600 dp",
+    );
+    let light = light(env, &tab).await?;
+    step(
+        STEPS[1],
+        "Dark RTL large text keeps badge paint inside targets and clears an acknowledged count",
+    );
+    let dark = dark_rtl_large(env, &tab).await?;
+    let acknowledged = acknowledge(env, &tab).await?;
+    activate(&tab, BACK).await?;
+    until(&tab, "s.section === 3 && !s.navigation_badges.visible").await?;
+    focused(&tab, SHOW).await?;
+    env.write_json(
+        "browser-material-flexible-navigation-badges.json",
+        &json!({
+            "browser":chrome.version,"steps":STEPS,"light":light,"dark":dark,
+            "acknowledged":acknowledged,"errors":tab.errors()
+        }),
+    )?;
+    check!(
+        tab.errors().is_empty(),
+        "page errors: {}",
+        tab.errors().join("\n")
+    );
+    Ok(())
+}
diff --git a/examples/material-gallery/src/flexible_navigation_badge_demo.rs b/examples/material-gallery/src/flexible_navigation_badge_demo.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2f31643c21106db91fd1f438ad8727d0ba5ba1d8
--- /dev/null
+++ b/examples/material-gallery/src/flexible_navigation_badge_demo.rs
@@ -0,0 +1,321 @@
+use surface::{Align, Length, Node, Role, Style};
+use surface_app::View;
+use surface_material::{
+    adaptive::WindowWidthSizeClass, shape::LayoutDirection, BadgeContent,
+    BadgedFlexibleNavigationBarItem, ChoiceState, FlexibleNavigationBarOptions, NavigationRailItem,
+    Theme,
+};
+
+use crate::{flexible_navigation_bar_demo::icon, scroll_field_demo::control_row, Message};
+
+pub(crate) const SECTION: usize = 3;
+const SHOW: &str = "navigation-badges-demo-show";
+const BACK: &str = "navigation-badges-demo-back";
+const BAR: &str = "navigation-badges-demo-bar";
+const MAX_PREVIEW_WIDTH: f32 = 839.;
+const DISABLED: usize = 4;
+const IDS: [&str; 5] = [
+    "navigation-badges-demo-home",
+    "navigation-badges-demo-inbox",
+    "navigation-badges-demo-updates",
+    "navigation-badges-demo-explore",
+    "navigation-badges-demo-settings",
+];
+const LABELS: [&str; 5] = ["首頁", "收件匣", "最新消息", "探索路線", "設定"];
+const NAMES: [&str; 5] = [
+    "首頁",
+    "收件匣，1200 則未讀",
+    "最新消息，有新內容",
+    "探索路線，有新內容",
+    "設定",
+];
+const COUNT: u32 = 1200;
+
+#[derive(Clone)]
+pub enum FlexibleNavigationBadgeDemoEvent {
+    Show,
+    Back,
+    ToggleDirection,
+    ToggleLargeText,
+    Choose(usize),
+}
+
+pub(crate) struct FlexibleNavigationBadgeDemo {
+    visible: bool,
+    viewport_width: f32,
+    rtl: bool,
+    large_text: bool,
+    selected: usize,
+    activations: usize,
+    acknowledged: [bool; IDS.len()],
+}
+
+impl Default for FlexibleNavigationBadgeDemo {
+    fn default() -> Self {
+        Self {
+            visible: false,
+            viewport_width: 320.,
+            rtl: false,
+            large_text: false,
+            selected: 1,
+            activations: 0,
+            acknowledged: [false; IDS.len()],
+        }
+    }
+}
+
+impl FlexibleNavigationBadgeDemo {
+    pub(crate) fn visible(&self) -> bool {
+        self.visible
+    }
+
+    pub(crate) fn leave(&mut self) {
+        self.visible = false;
+    }
+
+    pub(crate) fn viewport_changed(&mut self, width: f32) -> bool {
+        let previous = self.preview_width();
+        self.viewport_width = width;
+        self.visible && previous != self.preview_width()
+    }
+
+    fn preview_width(&self) -> f32 {
+        self.viewport_width.min(MAX_PREVIEW_WIDTH)
+    }
+
+    fn horizontal(&self) -> bool {
+        WindowWidthSizeClass::from_dp(self.preview_width()) == Some(WindowWidthSizeClass::Medium)
+    }
+
+    pub(crate) fn text_scale(&self) -> f32 {
+        if self.large_text {
+            2.
+        } else {
+            1.
+        }
+    }
+
+    pub(crate) fn update(&mut self, event: FlexibleNavigationBadgeDemoEvent) {
+        use FlexibleNavigationBadgeDemoEvent::*;
+        match event {
+            Show => self.visible = true,
+            Back => self.leave(),
+            ToggleDirection => self.rtl = !self.rtl,
+            ToggleLargeText => self.large_text = !self.large_text,
+            Choose(index) if index < IDS.len() && index != DISABLED => {
+                self.selected = index;
+                self.activations += 1;
+                self.acknowledged[index] = true;
+            }
+            Choose(_) => {}
+        }
+    }
+
+    pub(crate) fn show_button(theme: &Theme) -> View<Message> {
+        theme
+            .button_with(
+                SHOW,
+                "徽章導覽",
+                surface_material::ButtonKind::Outlined,
+                false,
+                Message::FlexibleNavigationBadgeDemo(FlexibleNavigationBadgeDemoEvent::Show),
+            )
+            .restore_focus_on_removal(BACK)
+            .accessible_activation()
+    }
+
+    fn badge(&self, index: usize) -> BadgeContent<'static> {
+        if self.acknowledged[index] {
+            return BadgeContent::Hidden;
+        }
+        match index {
+            1 => BadgeContent::Count(COUNT),
+            2 => BadgeContent::Dot,
+            3 => BadgeContent::Label("新"),
+            _ => BadgeContent::Hidden,
+        }
+    }
+
+    fn accessible_name(&self, index: usize) -> &'static str {
+        if self.acknowledged[index] {
+            LABELS[index]
+        } else {
+            NAMES[index]
+        }
+    }
+
+    pub(crate) fn view(&self, theme: &Theme, dark: bool) -> View<Message> {
+        use FlexibleNavigationBadgeDemoEvent::*;
+        let event = Message::FlexibleNavigationBadgeDemo;
+        let preview_width = self.preview_width();
+        let direction = if self.rtl {
+            LayoutDirection::RightToLeft
+        } else {
+            LayoutDirection::LeftToRight
+        };
+        let options = FlexibleNavigationBarOptions {
+            id: BAR,
+            name: "導覽列徽章範例",
+            available_width: preview_width,
+            direction,
+        };
+        let items = (0..IDS.len()).map(|index| BadgedFlexibleNavigationBarItem {
+            item: NavigationRailItem {
+                id: IDS[index],
+                label: LABELS[index],
+                accessible_name: self.accessible_name(index),
+                icon: icon(index, self.selected == index),
+                state: ChoiceState {
+                    selected: self.selected == index,
+                    disabled: index == DISABLED,
+                },
+                message: event(Choose(index)),
+            },
+            badge: self.badge(index),
+        });
+        let bar = if self.horizontal() {
+            theme.horizontal_flexible_navigation_bar_with_badges(options, items)
+        } else {
+            theme.flexible_navigation_bar_with_badges(options, items)
+        };
+        let bar = bar.unwrap_or_else(|| {
+            theme.text(
+                "navigation-badges-demo-width-hint",
+                "請將視窗加寬至 280 dp 以上。",
+            )
+        });
+
+        let toggle = |id, label, selected, message| {
+            theme
+                .segmented_button(id, label, choice(selected), message)
+                .accessible_activation()
+        };
+        let controls = control_row(vec![
+            toggle("navigation-badges-demo-theme", "深色", dark, Message::Theme),
+            toggle(
+                "navigation-badges-demo-rtl",
+                "右起",
+                self.rtl,
+                event(ToggleDirection),
+            ),
+            toggle(
+                "navigation-badges-demo-large-text",
+                "大字",
+                self.large_text,
+                event(ToggleLargeText),
+            ),
+        ]);
+        let header = View::new(
+            Node::new(Role::Group, "")
+                .id("navigation-badges-demo-header")
+                .styled(
+                    Style::row()
+                        .width(Length::Percent(1.))
+                        .align(Align::Center)
+                        .wrap(true)
+                        .padding(16.)
+                        .gap(12.),
+                ),
+        )
+        .children([
+            theme
+                .tonal_button(BACK, "返回", event(Back))
+                .restore_focus_on_removal(SHOW)
+                .accessible_activation(),
+            theme.heading("navigation-badges-demo-title", "導覽徽章"),
+        ]);
+        let controls = View::new(
+            Node::new(Role::Group, "")
+                .id("navigation-badges-demo-controls")
+                .styled(
+                    Style::column()
+                        .width(Length::Percent(1.))
+                        .padding(16.)
+                        .gap(8.),
+                ),
+        )
+        .children([
+            controls,
+            theme.text(
+                "navigation-badges-demo-page",
+                format!(
+                    "目前頁面：{} · 已選取 {} 次",
+                    LABELS[self.selected], self.activations
+                ),
+            ),
+        ]);
+        let spacer = View::new(
+            Node::new(Role::Group, "")
+                .id("navigation-badges-demo-spacer")
+                .styled(Style::column().height(Length::Px(0.)).grow(1.)),
+        );
+        let bar_holder = View::new(
+            Node::new(Role::Group, "")
+                .id("navigation-badges-demo-bar-holder")
+                .styled(
+                    Style::row()
+                        .width(Length::Percent(1.))
+                        .justify(Align::Center)
+                        .align(Align::End),
+                ),
+        )
+        .children([bar]);
+
+        View::new(
+            Node::new(Role::Window, "Material gallery")
+                .id("navigation-badges-demo")
+                .styled(
+                    Style::column()
+                        .width(Length::Percent(1.))
+                        .height(Length::Percent(1.))
+                        .align(Align::Stretch)
+                        .background(theme.colors.surface_container_low)
+                        .foreground(theme.on_background)
+                        .clip(true),
+                ),
+        )
+        .children([header, controls, spacer, bar_holder])
+    }
+
+    #[cfg(target_arch = "wasm32")]
+    pub(crate) fn inspect(&self, theme: &Theme) -> serde_json::Value {
+        let width = self.preview_width();
+        let badges = (0..IDS.len())
+            .map(|index| match self.badge(index) {
+                BadgeContent::Hidden => "hidden",
+                BadgeContent::Dot => "dot",
+                BadgeContent::Label(label) => label,
+                BadgeContent::Count(_) => "999+",
+            })
+            .collect::<Vec<_>>();
+        let names = (0..IDS.len())
+            .map(|index| self.accessible_name(index))
+            .collect::<Vec<_>>();
+        serde_json::json!({
+            "visible": self.visible,
+            "rtl": self.rtl,
+            "text_scale": self.text_scale(),
+            "preview_width": width,
+            "horizontal": self.horizontal(),
+            "count": IDS.len(),
+            "unread_count": if self.acknowledged[1] { 0 } else { COUNT },
+            "destinations": IDS,
+            "accessible_names": names,
+            "disabled": IDS[DISABLED],
+            "selected": IDS[self.selected],
+            "page": LABELS[self.selected],
+            "activations": self.activations,
+            "badges": badges,
+            "dark": theme.is_dark,
+            "error_color": theme.colors.error,
+            "on_error_color": theme.colors.on_error,
+        })
+    }
+}
+
+fn choice(selected: bool) -> ChoiceState {
+    ChoiceState {
+        selected,
+        disabled: false,
+    }
+}
