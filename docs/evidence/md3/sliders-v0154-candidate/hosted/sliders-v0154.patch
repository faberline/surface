new file mode 100644
index 0000000..bd68c3f
--- /dev/null
+++ b/crates/surface-app/src/slider.rs
@@ -0,0 +1,169 @@
+use std::num::NonZeroU16;
+
+use surface::{RangeValue, Rect};
+
+use crate::EditKey;
+
+/// How a slider converts a position to a controlled value.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SliderScale {
+    /// Pointer and absolute adjustment keep the requested value. Keyboard
+    /// and relative adjustment use the range's step.
+    Continuous,
+    /// The range contains this many equal intervals, including both endpoints.
+    Discrete(NonZeroU16),
+}
+
+/// Optional pointer, key, and accessible adjustment rules for a horizontal
+/// slider. Without this policy, a slider uses its original step behavior.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SliderInputOptions {
+    pub scale: SliderScale,
+    /// The physical right edge is the minimum. Only Left and Right reverse.
+    pub reverse_horizontal: bool,
+}
+
+impl SliderInputOptions {
+    /// Clamp a finite request to the range and apply the authored stop grid.
+    pub fn resolve_value(self, range: RangeValue, value: f64) -> Option<f64> {
+        if !range.is_valid() || !value.is_finite() {
+            return None;
+        }
+        let value = value.clamp(range.min, range.max);
+        Some(match self.scale {
+            SliderScale::Continuous => value,
+            SliderScale::Discrete(intervals) => {
+                stop_value(range, intervals, stop_index(range, intervals, value))
+            }
+        })
+    }
+
+    /// Position of the controlled value between the logical minimum and maximum.
+    pub fn value_fraction(self, range: RangeValue) -> Option<f64> {
+        if !range.is_valid() {
+            return None;
+        }
+        Some(match self.scale {
+            SliderScale::Continuous => (range.value - range.min) / (range.max - range.min),
+            SliderScale::Discrete(intervals) => {
+                stop_index(range, intervals, range.value) / f64::from(intervals.get())
+            }
+        })
+    }
+
+    pub(crate) fn relative(self, range: RangeValue, steps: f64) -> f64 {
+        match self.scale {
+            SliderScale::Continuous => {
+                (range.value + steps * range.step).clamp(range.min, range.max)
+            }
+            SliderScale::Discrete(intervals) => {
+                let index = stop_index(range, intervals, range.value);
+                stop_value(range, intervals, index + steps)
+            }
+        }
+    }
+
+    pub(crate) fn key_value(self, range: RangeValue, key: EditKey) -> Option<f64> {
+        let sign = if self.reverse_horizontal { -1. } else { 1. };
+        Some(match key {
+            EditKey::Left => self.relative(range, -sign),
+            EditKey::Right => self.relative(range, sign),
+            EditKey::Down => self.relative(range, -1.),
+            EditKey::Up => self.relative(range, 1.),
+            EditKey::Home => range.min,
+            EditKey::End => range.max,
+            EditKey::PageUp | EditKey::PageDown => {
+                let sign = if key == EditKey::PageUp { 1. } else { -1. };
+                match self.scale {
+                    SliderScale::Continuous => {
+                        let distance = ((range.max - range.min) / 10.).max(range.step);
+                        (range.value + sign * distance).clamp(range.min, range.max)
+                    }
+                    SliderScale::Discrete(intervals) => {
+                        self.relative(range, sign * (f64::from(intervals.get()) / 10.).ceil())
+                    }
+                }
+            }
+            _ => return None,
+        })
+    }
+
+    pub(crate) fn pointer_value(self, range: RangeValue, rail: Rect, x: f32) -> f64 {
+        let fraction = if x <= rail.x {
+            0.
+        } else if x >= rail.x + rail.width {
+            1.
+        } else {
+            (f64::from(x) - f64::from(rail.x)) / f64::from(rail.width)
+        };
+        let fraction = if self.reverse_horizontal {
+            1. - fraction
+        } else {
+            fraction
+        };
+        if fraction == 1. {
+            range.max
+        } else {
+            range.min + fraction * (range.max - range.min)
+        }
+    }
+}
+
+fn stop_index(range: RangeValue, intervals: NonZeroU16, value: f64) -> f64 {
+    let span = range.max - range.min;
+    (((value - range.min) / span) * f64::from(intervals.get())).round()
+}
+
+fn stop_value(range: RangeValue, intervals: NonZeroU16, index: f64) -> f64 {
+    let count = f64::from(intervals.get());
+    if index <= 0. {
+        range.min
+    } else if index >= count {
+        range.max
+    } else {
+        range.min + (range.max - range.min) * (index / count)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn discrete_arrows_and_page_keys_cross_a_sub_ulp_boundary_by_index() {
+        let scale = SliderScale::Discrete(NonZeroU16::new(3).unwrap());
+        let input = SliderInputOptions {
+            scale,
+            reverse_horizontal: false,
+        };
+        let eps = f64::EPSILON;
+        let range = RangeValue {
+            min: 1.,
+            max: 1. + 4. * eps,
+            value: 1. + 3. * eps,
+            step: (4. * eps) / 3.,
+        };
+        assert_eq!(input.key_value(range, EditKey::Left), Some(1. + eps));
+        assert_eq!(input.key_value(range, EditKey::PageDown), Some(1. + eps));
+        assert_eq!(input.value_fraction(range), Some(2. / 3.));
+    }
+
+    #[test]
+    fn pointer_uses_the_visible_f32_edge_as_the_exact_endpoint() {
+        let input = SliderInputOptions {
+            scale: SliderScale::Continuous,
+            reverse_horizontal: false,
+        };
+        let range = RangeValue {
+            min: 0.,
+            max: 100.,
+            value: 0.,
+            step: 1.,
+        };
+        let rail = Rect::new(0.2, 0., 0.6, 48.);
+        assert_eq!(
+            input.pointer_value(range, rail, rail.x + rail.width),
+            range.max
+        );
+    }
+}
diff --git a/crates/surface-app/tests/slider_accessibility.rs b/crates/surface-app/tests/slider_accessibility.rs
new file mode 100644
index 0000000..b5c3eb2
--- /dev/null
+++ b/crates/surface-app/tests/slider_accessibility.rs
@@ -0,0 +1,319 @@
+use surface::{Length, Node, RangeValue, Role, Style, TextMeasurer};
+use surface_app::{
+    AccessibilityAdjustment as Action, AccessibilityAdjustmentResult as Outcome,
+    AccessibilityAdjustmentTarget, AppError, Application, Event, ImeEvent, Queue, Runtime, View,
+};
+
+const SLIDER: &str = "volume";
+
+#[derive(Clone)]
+enum Message {
+    Change(f64),
+    Disable,
+    Hide,
+    Open,
+    Close,
+    Edit,
+}
+
+struct App {
+    range: RangeValue,
+    opt_in: bool,
+    bound: bool,
+    disabled: bool,
+    hidden: bool,
+    modal: bool,
+    hide_on_request: bool,
+    writes: usize,
+    queue: Option<Queue<Message>>,
+}
+
+impl Default for App {
+    fn default() -> Self {
+        Self {
+            range: RangeValue {
+                min: 0.,
+                max: 10.,
+                value: 6.,
+                step: 2.,
+            },
+            opt_in: true,
+            bound: true,
+            disabled: false,
+            hidden: false,
+            modal: false,
+            hide_on_request: false,
+            writes: 0,
+            queue: None,
+        }
+    }
+}
+
+impl Application for App {
+    type Message = Message;
+
+    fn update(&mut self, message: Message) {
+        match message {
+            Message::Change(value) => {
+                self.range.value = value;
+                self.writes += 1;
+            }
+            Message::Disable => self.disabled = true,
+            Message::Hide => self.hidden = true,
+            Message::Open => self.modal = true,
+            Message::Close => self.modal = false,
+            Message::Edit => {}
+        }
+    }
+
+    fn attach_queue(&mut self, queue: Queue<Message>) {
+        self.queue = Some(queue);
+    }
+
+    fn view(&self) -> View<Message> {
+        let size = || Style::row().width(Length::Px(120.)).height(Length::Px(48.));
+        let mut slider = View::new(
+            Node::new(Role::Slider, "Volume")
+                .id(SLIDER)
+                .range(self.range)
+                .disabled(self.disabled)
+                .styled(size()),
+        );
+        if self.opt_in {
+            slider = slider.accessible_slider_adjustment();
+        }
+        if self.bound {
+            let queue = self.queue.clone().filter(|_| self.hide_on_request);
+            slider = slider.on_value(move |value| {
+                if let Some(queue) = &queue {
+                    queue.post(Message::Hide);
+                }
+                Message::Change(value)
+            });
+        }
+        if self.hidden {
+            slider = slider.without_interaction(None);
+        }
+        let opener = View::new(Node::new(Role::Button, "Open").id("open").styled(size()))
+            .on_press(Message::Open);
+        let editor = View::new(
+            Node::new(Role::TextInput, "Editor")
+                .id("editor")
+                .text("sample")
+                .styled(size()),
+        )
+        .on_input(|_| Message::Edit);
+        let panel = self.modal.then(|| {
+            View::new(Node::new(Role::Dialog, "Modal").id("panel").styled(size()))
+                .on_value(Message::Change)
+                .accessible_slider_adjustment()
+                .modal_overlay(Message::Close)
+        });
+        View::new(Node::new(Role::Window, "Slider fixture").styled(Style::column()))
+            .children([opener, editor, slider].into_iter().chain(panel))
+    }
+}
+
+struct Text;
+impl TextMeasurer for Text {
+    fn measure(&mut self, _: &str, _: f32, _: Option<f32>) -> (f32, f32) {
+        (24., 24.)
+    }
+}
+
+fn draw(runtime: &mut Runtime<App>) {
+    runtime.render(320., 400., &mut Text).unwrap();
+}
+
+fn fixture(app: App) -> Runtime<App> {
+    let mut runtime = Runtime::new(app).unwrap();
+    draw(&mut runtime);
+    runtime
+}
+
+fn target(runtime: &Runtime<App>, key: &str) -> Option<AccessibilityAdjustmentTarget> {
+    let id = runtime.dom().by_id(key).unwrap();
+    runtime.accessibility_frame()?.adjustment_target(id)
+}
+
+fn offers_steps(runtime: &Runtime<App>) -> [bool; 2] {
+    let id = runtime.dom().by_id(SLIDER).unwrap();
+    let frame = runtime.accessibility_frame().unwrap();
+    [true, false].map(|increment| frame.supports_adjustment_step(id, increment))
+}
+
+fn adjust(
+    runtime: &mut Runtime<App>,
+    token: &AccessibilityAdjustmentTarget,
+    action: Action,
+) -> Outcome {
+    runtime.accessibility_adjust(token, action).unwrap()
+}
+
+#[test]
+fn native_steps_and_set_value_share_legacy_snapping_and_keep_focus() {
+    let mut rt = Runtime::new(App::default()).unwrap();
+    assert!(target(&rt, SLIDER).is_none());
+    rt.activate("editor").unwrap();
+    draw(&mut rt);
+
+    let token = target(&rt, SLIDER).unwrap();
+    assert_eq!(offers_steps(&rt), [true, true]);
+    for request in [6., 6.2, f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+        assert_eq!(
+            adjust(&mut rt, &token, Action::SetValue(request)),
+            Outcome::Rejected
+        );
+    }
+    assert_eq!(rt.app().writes, 0);
+    assert_eq!(
+        adjust(&mut rt, &token, Action::SetValue(7.2)),
+        Outcome::Adjusted
+    );
+    assert_eq!(rt.app().range.value, 8.);
+    assert_eq!(rt.focused(), Some("editor"));
+
+    draw(&mut rt);
+    assert_eq!(
+        adjust(&mut rt, &token, Action::Increment),
+        Outcome::Rejected
+    );
+    for (request, expected, offered) in [
+        (Action::Increment, 10., [false, true]),
+        (Action::Decrement, 8., [true, true]),
+        (Action::SetValue(-80.), 0., [true, false]),
+    ] {
+        let token = target(&rt, SLIDER).unwrap();
+        assert_eq!(adjust(&mut rt, &token, request), Outcome::Adjusted);
+        assert_eq!(rt.app().range.value, expected);
+        assert_eq!(rt.focused(), Some("editor"));
+        draw(&mut rt);
+        assert_eq!(offers_steps(&rt), offered);
+    }
+    let token = target(&rt, SLIDER).unwrap();
+    assert_eq!(
+        adjust(&mut rt, &token, Action::Decrement),
+        Outcome::Rejected
+    );
+    assert_eq!(rt.app().writes, 4);
+}
+
+#[test]
+fn legacy_unaligned_endpoint_matches_setter_for_opted_in_slider() {
+    let app = || App {
+        range: RangeValue {
+            min: 0.,
+            max: 100.,
+            value: 50.,
+            step: 30.,
+        },
+        ..App::default()
+    };
+    let mut ordinary = fixture(app());
+    let mut native = fixture(app());
+    assert!(ordinary.set_value(SLIDER, 100.).unwrap());
+    let token = target(&native, SLIDER).unwrap();
+    assert_eq!(
+        adjust(&mut native, &token, Action::SetValue(100.)),
+        Outcome::Adjusted
+    );
+    assert_eq!(native.app().range.value, ordinary.app().range.value);
+    assert_eq!(native.app().range.value, 90.);
+    draw(&mut native);
+    assert_eq!(offers_steps(&native), [false, true]);
+}
+
+#[test]
+fn adjustment_requires_opt_in_a_value_binding_visibility_and_scope() {
+    let mut legacy = fixture(App {
+        opt_in: false,
+        ..App::default()
+    });
+    assert!(target(&legacy, SLIDER).is_none());
+    assert_eq!(offers_steps(&legacy), [false, false]);
+    assert!(legacy.set_value(SLIDER, 9.2).unwrap());
+    assert_eq!(legacy.app().range.value, 10.);
+    assert!(!legacy.set_value("missing", f64::NAN).unwrap());
+
+    let unbound_disabled = fixture(App {
+        bound: false,
+        disabled: true,
+        ..App::default()
+    });
+    assert!(target(&unbound_disabled, SLIDER).is_none());
+    assert!(
+        matches!(Runtime::new(App { bound: false, ..App::default() }), Err(AppError::InvalidRange(id)) if id == SLIDER)
+    );
+
+    let mut rt = fixture(App::default());
+    let before_modal = target(&rt, SLIDER).unwrap();
+    rt.apply(Message::Open).unwrap();
+    draw(&mut rt);
+    assert!(target(&rt, SLIDER).is_none());
+    assert!(target(&rt, "panel").is_none());
+    assert_eq!(
+        adjust(&mut rt, &before_modal, Action::Increment),
+        Outcome::Rejected
+    );
+
+    rt.apply(Message::Close).unwrap();
+    draw(&mut rt);
+    let enabled = target(&rt, SLIDER).unwrap();
+    rt.apply(Message::Disable).unwrap();
+    draw(&mut rt);
+    assert!(target(&rt, SLIDER).is_none());
+    assert_eq!(
+        adjust(&mut rt, &enabled, Action::Increment),
+        Outcome::Rejected
+    );
+    assert_eq!(rt.app().writes, 0);
+}
+
+#[test]
+fn composition_pressed_pointer_and_a_queued_rebuild_reject_the_adjustment() {
+    let mut rt = fixture(App {
+        hide_on_request: true,
+        ..App::default()
+    });
+    rt.activate("editor").unwrap();
+    rt.dispatch(Event::Ime(ImeEvent::Begin)).unwrap();
+    draw(&mut rt);
+    let token = target(&rt, SLIDER).unwrap();
+    assert_eq!(
+        adjust(&mut rt, &token, Action::Increment),
+        Outcome::BlockedByComposition
+    );
+    rt.dispatch(Event::Ime(ImeEvent::Cancel)).unwrap();
+    draw(&mut rt);
+
+    let opener = rt.dom().by_id("open").unwrap();
+    let bounds = rt.computed().unwrap().nodes[opener.index()].bounds;
+    rt.dispatch(Event::PointerDown {
+        x: bounds.x + 4.,
+        y: bounds.y + 4.,
+    })
+    .unwrap();
+    draw(&mut rt);
+    let token = target(&rt, SLIDER).unwrap();
+    assert_eq!(
+        adjust(&mut rt, &token, Action::Increment),
+        Outcome::BlockedByPointer
+    );
+    rt.cancel_pointer().unwrap();
+    draw(&mut rt);
+
+    let token = target(&rt, SLIDER).unwrap();
+    assert_eq!(
+        adjust(&mut rt, &token, Action::SetValue(9.)),
+        Outcome::Rebuilt
+    );
+    assert!(rt.app().hidden);
+    assert_eq!(rt.app().range.value, 6.);
+    assert_eq!(rt.app().writes, 0);
+    draw(&mut rt);
+    assert!(target(&rt, SLIDER).is_none());
+    assert_eq!(
+        adjust(&mut rt, &token, Action::Decrement),
+        Outcome::Rejected
+    );
+}
