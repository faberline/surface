+        assert_eq!(
+            (node.role(), node.name(), node.is_disabled()),
+            (Role::Slider, "音量", disabled)
+        );
+        assert_eq!(
+            node.range_value(),
+            Some(RangeValue {
+                min: 0.,
+                max: 100.,
+                value: 25.,
+                step: 1.
+            })
