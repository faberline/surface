+#[test]
+fn independent_checks_stay_open_and_keep_stable_art_and_focus() {
+    let mut runtime = Runtime::new(Fixture::default()).unwrap();
+    open(&mut runtime, 720., 760.);
+    key(&mut runtime, EditKey::End);
+    assert_eq!(runtime.focused(), Some("check-disabled"));
+    runtime.dispatch(Event::Activate).unwrap();
+    key(&mut runtime, EditKey::Up);
+    assert_eq!(runtime.focused(), Some("check-recent"));
+    let geometry = bounds(&runtime, "check-recent-leading");
+    let label = bounds(&runtime, "check-recent-label");
+    let frame = runtime.accessibility_frame().unwrap();
+    let focus = frame
+        .focus_target(runtime.dom().by_id("check-recent").unwrap())
+        .unwrap();
+    let space = KeyPress::new(Key::Space, Modifiers::default());
+    assert!(runtime
+        .accessibility_key(&focus, &space, Some(Event::Activate))
+        .unwrap());
+    render(&mut runtime, 720., 760.);
+    assert!(runtime.app().open);
+    assert_eq!(runtime.focused(), Some("check-recent"));
+    assert_eq!(node(&runtime, "check-recent").is_checked(), Some(true));
+    assert_eq!(bounds(&runtime, "check-recent-leading"), geometry);
+    assert_eq!(bounds(&runtime, "check-recent-label"), label);
+
+    let tap = bounds(&runtime, "check-pins");
+    let (x, y) = (tap.x + tap.width / 2., tap.y + tap.height / 2.);
+    runtime.dispatch_touch(Event::PointerDown { x, y }).unwrap();
+    runtime.cancel_pointer().unwrap();
+    assert!(!runtime.dispatch_touch(Event::PointerUp { x, y }).unwrap());
+    assert_eq!(runtime.app().choices, ["check-recent"]);
+    runtime.dispatch(Event::PointerDown { x, y }).unwrap();
+    runtime.dispatch(Event::PointerUp { x, y }).unwrap();
+    render(&mut runtime, 720., 760.);
+    assert_eq!(runtime.app().choices, ["check-recent", "check-pins"]);
+    assert_eq!(node(&runtime, "check-pins").is_checked(), Some(true));
+    assert_eq!(node(&runtime, "check-recent").is_checked(), Some(true));
+    let repeat = KeyPress::new(Key::Enter, Modifiers::default()).with_repeat(true);
+    assert!(runtime.key(&repeat).unwrap());
+    assert_eq!(runtime.app().choices.len(), 2);
+    assert!(runtime.dispatch(Event::Activate).unwrap());
+    render(&mut runtime, 720., 760.);
+    assert_eq!(node(&runtime, "check-pins").is_checked(), Some(false));
+    assert_eq!(node(&runtime, "check-recent").is_checked(), Some(true));
+    assert!(runtime.app().open);
+
+    runtime
+        .dispatch(Event::FocusNext { reverse: false })
+        .unwrap();
+    render(&mut runtime, 720., 760.);
+    assert!(!runtime.app().open);
+    assert_eq!(runtime.focused(), Some("outside"));
+    assert_eq!(runtime.app().checked, ["check-disabled", "check-recent"]);
+}
