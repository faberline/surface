+#[test]
+fn both_palettes_paint_a_stable_logical_leading_check() {
+    for (rtl, mode) in [
+        (false, VerticalMenuPalette::Standard),
+        (true, VerticalMenuPalette::Vibrant),
+    ] {
+        let mut runtime = Runtime::new(Fixture {
+            rtl,
+            large: rtl,
+            mode,
+            ..Fixture::default()
+        })
+        .unwrap();
+        let (w, h) = if rtl { (320., 480.) } else { (720., 760.) };
+        open(&mut runtime, w, h);
+        let theme = runtime.app().theme();
+        let (fill, ink) = if rtl {
+            (theme.colors.tertiary, theme.colors.on_tertiary)
+        } else {
+            (
+                theme.colors.tertiary_container,
+                theme.colors.on_tertiary_container,
+            )
+        };
+        let face = bounds(&runtime, "sort-old-face");
+        let row = bounds(&runtime, "sort-old");
+        let mark = bounds(&runtime, "sort-old-leading");
+        let unchecked = bounds(&runtime, "sort-new-leading");
+        assert_eq!(node(&runtime, "sort-old-face").style().background, fill);
+        assert_eq!(node(&runtime, "sort-old-face").style().state_layer, ink);
+        assert_eq!(
+            node(&runtime, "sort-old-face").style().corner_radii(),
+            shape::MEDIUM
+        );
+        assert_eq!(node(&runtime, "sort-old-label").style().foreground, ink);
+        assert_eq!(
+            node(&runtime, "sort-old-label").style().text_style(),
+            typography::LABEL_LARGE
+        );
+        assert_eq!(
+            (mark.width, mark.height, unchecked.width, unchecked.height),
+            (20., 20., 20., 20.)
+        );
+        assert!(!node(&runtime, "sort-old-leading").is_focusable());
+        assert_eq!(
+            if rtl {
+                face.x + face.width - mark.x - mark.width
+            } else {
+                mark.x - face.x
+            },
+            16.
+        );
+        assert!(row.height >= 48. && face.height >= 44.);
+        if rtl {
+            assert!(bounds(&runtime, "sort-disabled-label").height >= 80.);
+        } else {
+            assert_eq!((row.height, face.height), (48., 44.));
+        }
+        let Color(r, g, b, _) = theme.colors.tertiary_container;
+        assert_eq!(
+            node(&runtime, "view-grid-face").style().background,
+            if rtl {
+                Color::TRANSPARENT
+            } else {
+                Color(r, g, b, 97)
+            }
+        );
+        assert_eq!(node(&runtime, "view-grid-label").style().foreground.3, 97);
+
+        let mut fonts = TextSystem::default();
+        let paint = runtime.render_extended(w, h, &mut fonts).unwrap();
+        assert!(paint.ops().iter().any(|op| {
+            matches!(op, ExtendedPaintOp::FillPath(path)
+                if path.color() == ink && path.rect().intersect(mark) == path.rect())
+        }));
+    }
+}
