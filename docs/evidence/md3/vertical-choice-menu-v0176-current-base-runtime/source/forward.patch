+use surface::{Node, Role};
+
+#[test]
+fn radio_menu_items_round_trip_explicit_checked_state_without_changing_role() {
+    let plain = Node::new(Role::MenuItem, "Paper");
+    let legacy = plain.clone().checked(false);
+    let legacy_json = serde_json::to_value(legacy.clone()).unwrap();
+    assert_eq!(legacy_json["role"], "MenuItem");
+    assert!(legacy_json.get("menu_radio").is_none());
+    let restored: Node = serde_json::from_value(legacy_json).unwrap();
+    assert_eq!(restored, legacy);
+    assert_eq!(restored.menu_radio_checked_state(), None);
+    assert_eq!(restored.is_checked(), Some(false));
+
+    for checked in [false, true] {
+        let choice = plain.clone().menu_radio_checked(checked);
+        let json = serde_json::to_value(&choice).unwrap();
+        assert_eq!(json["role"], "MenuItem");
+        assert_eq!(json["checked"], checked);
+        let restored: Node = serde_json::from_value(json).unwrap();
+        assert_eq!(restored, choice);
+        assert_eq!(restored.role(), Role::MenuItem);
+        assert_eq!(restored.menu_radio_checked_state(), Some(checked));
+        assert_eq!(restored.is_checked(), Some(checked));
+        assert_eq!(restored.is_selected(), None);
+        assert!(restored.is_focusable());
+        assert_eq!(
+            restored.checked(!checked).menu_radio_checked_state(),
+            Some(!checked)
+        );
+    }
+}
+
+#[test]
+fn radio_menu_metadata_is_ignored_for_other_roles_on_authoring_and_readback() {
+    let button = Node::new(Role::Button, "Show details").checked(true);
+    assert_eq!(button.clone().menu_radio_checked(false), button);
+    let mut foreign = serde_json::to_value(button).unwrap();
+    foreign["menu_radio"] = true.into();
+    let restored: Node = serde_json::from_value(foreign).unwrap();
+    assert_eq!(restored.menu_radio_checked_state(), None);
+    assert_eq!(restored.is_checked(), Some(true));
+}
