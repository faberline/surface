+fn node<'a>(runtime: &'a Runtime<Fixture>, key: &str) -> &'a Node {
+    runtime
+        .dom()
+        .get(runtime.dom().by_id(key).unwrap())
+        .unwrap()
+}
+
+fn bounds(runtime: &Runtime<Fixture>, key: &str) -> Rect {
+    runtime.computed().unwrap().nodes[runtime.dom().by_id(key).unwrap().index()].bounds
+}
