@@ -0,0 +1,178 @@
+use surface_app::View;
+use surface_material::{
+    CommandMenuItem, CommandMenuMeasurement, CommandMenuOptions, Theme, VerticalChoiceMenuGroup,
+    VerticalMenuPalette, VerticalMenuSelection,
+};
+
+use super::MenuDemoEvent;
+use crate::Message;
+
+const RECENT: &str = "menu-demo-choice-recent";
+const NAME: &str = "menu-demo-choice-name";
+const OWNER: &str = "menu-demo-choice-owner";
+const COMFORTABLE: &str = "menu-demo-choice-comfortable";
+const COMPACT: &str = "menu-demo-choice-compact";
+const KIND: &str = "menu-demo-choice-kind";
+const SIZE: &str = "menu-demo-choice-size";
+const LOCKED: &str = "menu-demo-choice-locked";
+
+#[derive(Clone)]
+pub enum MenuChoice {
+    SortByName(bool),
+    CompactDensity(bool),
+    ToggleKind,
+    ToggleSize,
+    Unavailable,
+}
+
+pub(super) struct MenuChoices {
+    sort_by_name: bool,
+    compact_density: bool,
+    show_kind: bool,
+    show_size: bool,
+    changes: usize,
+}
+
+impl Default for MenuChoices {
+    fn default() -> Self {
+        Self {
+            sort_by_name: false,
+            compact_density: false,
+            show_kind: true,
+            show_size: false,
+            changes: 0,
+        }
+    }
+}
+
+impl MenuChoices {
+    pub(super) fn change(&mut self, choice: MenuChoice) -> bool {
+        // Record every callback so the Gallery can detect duplicate actions.
+        self.changes += 1;
+        match choice {
+            MenuChoice::SortByName(value) if self.sort_by_name != value => {
+                self.sort_by_name = value;
+                true
+            }
+            MenuChoice::CompactDensity(value) if self.compact_density != value => {
+                self.compact_density = value;
+                true
+            }
+            MenuChoice::ToggleKind => {
+                self.show_kind = !self.show_kind;
+                false
+            }
+            MenuChoice::ToggleSize => {
+                self.show_size = !self.show_size;
+                false
+            }
+            _ => false,
+        }
+    }
+
+    fn sort(&self) -> &'static str {
+        if self.sort_by_name {
+            NAME
+        } else {
+            RECENT
+        }
+    }
+
+    fn density(&self) -> &'static str {
+        if self.compact_density {
+            COMPACT
+        } else {
+            COMFORTABLE
+        }
+    }
+
+    fn checked(&self) -> impl Iterator<Item = &'static str> {
+        [
+            (KIND, self.show_kind),
+            (SIZE, self.show_size),
+            (LOCKED, true),
+        ]
+        .into_iter()
+        .filter_map(|(id, checked)| checked.then_some(id))
+    }
+
+    pub(super) fn menu(
+        &self,
+        theme: &Theme,
+        options: CommandMenuOptions<'_>,
+        palette: VerticalMenuPalette,
+        trigger: View<Message>,
+        measurement: &CommandMenuMeasurement,
+    ) -> View<Message> {
+        use MenuChoice::*;
+        let row = |id, label, choice, disabled| CommandMenuItem {
+            id,
+            label,
+            leading_icon: None,
+            trailing_icon: None,
+            disabled,
+            on_press: Message::MenuDemo(MenuDemoEvent::ChangeChoice(choice)),
+        };
+        let checked: Vec<_> = self.checked().collect();
+        theme.vertical_choice_menu(
+            options,
+            palette,
+            trigger,
+            [
+                VerticalChoiceMenuGroup {
+                    id: "menu-demo-choice-sort",
+                    label: "排序方式",
+                    mode: VerticalMenuSelection::Single {
+                        selected_id: Some(self.sort()),
+                    },
+                    items: vec![
+                        row(RECENT, "最近修改", SortByName(false), false),
+                        row(NAME, "名稱", SortByName(true), false),
+                        row(OWNER, "擁有者", Unavailable, true),
+                    ],
+                },
+                VerticalChoiceMenuGroup {
+                    id: "menu-demo-choice-density",
+                    label: "顯示密度",
+                    mode: VerticalMenuSelection::Single {
+                        selected_id: Some(self.density()),
+                    },
+                    items: vec![
+                        row(COMFORTABLE, "舒適", CompactDensity(false), false),
+                        row(COMPACT, "緊湊", CompactDensity(true), false),
+                    ],
+                },
+                VerticalChoiceMenuGroup {
+                    id: "menu-demo-choice-fields",
+                    label: "在清單中顯示",
+                    mode: VerticalMenuSelection::Multiple {
+                        checked_ids: &checked,
+                    },
+                    items: vec![
+                        row(KIND, "檔案類型", ToggleKind, false),
+                        row(SIZE, "檔案大小與可用空間的詳細資料", ToggleSize, false),
+                        row(LOCKED, "鎖定狀態", Unavailable, true),
+                    ],
+                },
+            ],
+            Message::MenuDemo(MenuDemoEvent::Dismiss),
+            measurement,
+        )
+    }
+
+    #[cfg(target_arch = "wasm32")]
+    pub(super) fn inspect(&self, theme: &Theme, vibrant: bool) -> serde_json::Value {
+        let colors = &theme.colors;
+        serde_json::json!({
+            "sort": self.sort(),
+            "density": self.density(),
+            "checked": self.checked().collect::<Vec<_>>(),
+            "changes": self.changes,
+            "palette": if vibrant {
+                [colors.tertiary, colors.on_tertiary]
+            } else {
+                [colors.tertiary_container, colors.on_tertiary_container]
+            },
+        })
+    }
+}
