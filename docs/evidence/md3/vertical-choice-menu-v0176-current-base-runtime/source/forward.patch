+    /// Expose a menu item as a radio choice with an explicit checked state.
+    ///
+    /// The item keeps its menu keyboard and activation behavior. Callers
+    /// manage which item is checked. Other roles ignore this builder.
+    pub fn menu_radio_checked(mut self, value: bool) -> Self {
