+/// The choice state of one vertical menu group, supplied by the caller.
+#[derive(Clone, Copy, Debug, Default)]
+pub enum VerticalMenuSelection<'a> {
+    #[default]
+    Commands,
+    /// At most one checked item. Pressing it again sends no change.
+    Single { selected_id: Option<&'a str> },
+    /// Independent choices. The menu stays open while the caller keeps it open.
+    Multiple { checked_ids: &'a [&'a str] },
+}
+
+/// A named group of commands or checkable items. Each item's message is
+/// delivered to the caller, which owns its values and any decision to close.
+pub struct VerticalChoiceMenuGroup<'a, M> {
+    pub id: &'a str,
+    pub label: &'a str,
+    pub mode: VerticalMenuSelection<'a>,
+    pub items: Vec<CommandMenuItem<'a, M>>,
+}
+
+struct MenuGroup<'a, M> {
+    id: &'a str,
+    label: Option<&'a str>,
+    mode: VerticalMenuSelection<'a>,
+    items: Vec<CommandMenuItem<'a, M>>,
+}
+
+#[derive(Clone, Copy)]
+enum RowMode {
+    Command,
+    Radio(bool),
+    Checkbox(bool),
+}
+
+impl VerticalMenuSelection<'_> {
+    fn row(self, id: &str) -> RowMode {
+        match self {
+            Self::Commands => RowMode::Command,
+            Self::Single { selected_id } => RowMode::Radio(selected_id == Some(id)),
+            Self::Multiple { checked_ids } => RowMode::Checkbox(checked_ids.contains(&id)),
+        }
+    }
+}
