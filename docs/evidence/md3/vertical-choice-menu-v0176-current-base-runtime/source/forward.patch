@@ -0,0 +1,454 @@
+use surface::{Color, ExtendedPaintOp, Node, Rect, Role, Style};
+use surface_app::{
+    AccessibilityActivationResult, AnimationFrame, AnimationUpdate, Application, EditKey, Event,
+    Key, KeyPress, Modifiers, Runtime, View,
+};
+use surface_material::{
+    shape::{self, LayoutDirection},
+    typography, CommandMenuItem, CommandMenuMeasurement, CommandMenuOptions, Theme,
+    VerticalChoiceMenuGroup, VerticalMenuPalette, VerticalMenuSelection,
+};
+use surface_wgpu::TextSystem;
+
+#[derive(Clone, Copy)]
+enum Message {
+    Open,
+    Dismiss,
+    Choose(&'static str),
+}
+
+struct Fixture {
+    open: bool,
+    rtl: bool,
+    large: bool,
+    mode: VerticalMenuPalette,
+    commands: bool,
+    missing_name: bool,
+    sort: &'static str,
+    view: &'static str,
+    checked: Vec<&'static str>,
+    choices: Vec<&'static str>,
+    measurement: CommandMenuMeasurement,
+}
+
+impl Default for Fixture {
+    fn default() -> Self {
+        Self {
+            open: false,
+            rtl: false,
+            large: false,
+            mode: VerticalMenuPalette::Standard,
+            commands: false,
+            missing_name: false,
+            sort: "sort-old",
+            view: "view-grid",
+            checked: vec!["check-disabled"],
+            choices: Vec::new(),
+            measurement: CommandMenuMeasurement::default(),
+        }
+    }
+}
+
+impl Fixture {
+    fn theme(&self) -> Theme {
+        if self.rtl {
+            Theme::dark()
+        } else {
+            Theme::light()
+        }
+    }
+}
+
+impl Application for Fixture {
+    type Message = Message;
+
+    fn update(&mut self, message: Message) {
+        match message {
+            Message::Open => self.open = true,
+            Message::Dismiss => self.open = false,
+            Message::Choose(id) => {
+                self.choices.push(id);
+                match id {
+                    "sort-new" | "sort-old" => {
+                        self.sort = id;
+                        self.open = false;
+                    }
+                    "view-list" | "view-grid" => {
+                        self.view = id;
+                        self.open = false;
+                    }
+                    "report" => self.open = false,
+                    _ => {
+                        if let Some(index) = self.checked.iter().position(|choice| *choice == id) {
+                            self.checked.remove(index);
+                        } else {
+                            self.checked.push(id);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    fn text_scale(&self) -> f32 {
+        if self.large {
+            2.
+        } else {
+            1.
+        }
+    }
+
+    fn animation_frame(&mut self, frame: AnimationFrame<'_>) -> AnimationUpdate {
+        self.measurement.advance("choices", "trigger", &frame)
+    }
+
+    fn view(&self) -> View<Message> {
+        let theme = self.theme();
+        let item = |id, label, disabled| CommandMenuItem {
+            id,
+            label,
+            disabled,
+            leading_icon: None,
+            trailing_icon: None,
+            on_press: Message::Choose(id),
+        };
+        let middle = if self.commands {
+            VerticalChoiceMenuGroup {
+                id: "view-group",
+                label: "動作",
+                mode: VerticalMenuSelection::Commands,
+                items: vec![item("report", "報告", false)],
+            }
+        } else {
+            VerticalChoiceMenuGroup {
+                id: "view-group",
+                label: "版面",
+                mode: VerticalMenuSelection::Single {
+                    selected_id: Some(self.view),
+                },
+                items: vec![
+                    item("view-list", "清單", false),
+                    item("view-grid", "格線", true),
+                ],
+            }
+        };
+        let menu = theme.vertical_choice_menu(
+            CommandMenuOptions {
+                id: "choices",
+                label: "視圖設定",
+                trigger_id: "trigger",
+                open: self.open,
+                direction: if self.rtl {
+                    LayoutDirection::RightToLeft
+                } else {
+                    LayoutDirection::LeftToRight
+                },
+                preferred_width: 240.,
+                restore_focus_to: None,
+            },
+            self.mode,
+            theme.button("trigger", "開啟", Message::Open),
+            [
+                VerticalChoiceMenuGroup {
+                    id: "sort-group",
+                    label: if self.missing_name { " " } else { "排序" },
+                    mode: VerticalMenuSelection::Single {
+                        selected_id: Some(self.sort),
+                    },
+                    items: vec![
+                        item("sort-new", "最新", false),
+                        item("sort-old", "最舊", false),
+                        item("sort-disabled", "停用的完整檔案名稱", true),
+                    ],
+                },
+                middle,
+                VerticalChoiceMenuGroup {
+                    id: "check-group",
+                    label: "篩選",
+                    mode: VerticalMenuSelection::Multiple {
+                        checked_ids: &self.checked,
+                    },
+                    items: vec![
+                        item("check-pins", "釘選", false),
+                        item("check-recent", "最近", false),
+                        item("check-disabled", "停用的篩選", true),
+                    ],
+                },
+            ],
+            Message::Dismiss,
+            &self.measurement,
+        );
+        View::new(Node::new(Role::Window, "Gallery").styled(Style::column().padding(20.)))
+            .children([menu, theme.button("outside", "關於", Message::Dismiss)])
+    }
+}
+
+fn render(runtime: &mut Runtime<Fixture>, width: f32, height: f32) {
+    let mut fonts = TextSystem::default();
+    for _ in 0..8 {
+        runtime.render_extended(width, height, &mut fonts).unwrap();
+        if !runtime.needs_frame() {
+            return;
+        }
+    }
+    panic!("menu did not settle");
+}
