+
+fn choice_leading<M>(id: String, icon: Option<VectorIcon>, checked: bool, ink: Color) -> View<M> {
+    let artwork = if checked {
+        VectorIcon::new([
+            [9., 16.2],
+            [4.8, 12.],
+            [3.4, 13.4],
+            [9., 19.],
+            [21., 7.],
+            [19.6, 5.6],
+        ])
+    } else {
+        icon
+    };
+    if let Some(artwork) = artwork {
+        return icon_view(id, artwork, ink, ICON_SIZE);
+    }
+    let edge = Length::Px(ICON_SIZE);
+    View::new(
+        Node::new(Role::Group, "")
+            .id(id)
+            .styled(Style::column().width(edge).height(edge)),
+    )
+    .without_interaction(None)
+}
