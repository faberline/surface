+                foreground: Color(249, 220, 126, 255),
+            })
+        );
+        assert_eq!(
+            updated,
+            base.with_field(SystemColorPair {
+                background: Color(19, 45, 47, 204),
+                foreground: Color(238, 228, 190, 128),
+            })
+        );
+        assert_ne!(initial, updated);
+        assert_eq!(unavailable, base);
+    }
 }
