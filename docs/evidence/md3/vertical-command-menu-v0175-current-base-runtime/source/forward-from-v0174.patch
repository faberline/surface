+async fn vertical_paint(
+    env: &Env,
+    tab: &Tab,
+    photo: &str,
+    group: [f64; 4],
+    thumb: Option<[f64; 4]>,
+) -> Result<Value> {
+    tab.settle().await?;
+    let fixture = state(tab).await?;
+    let [red, green, blue, alpha]: [u8; 4] =
+        serde_json::from_value(fixture["menu_demo"]["palette"][0].clone())
+            .context("vertical menu exposes its group paint token")?;
+    check_eq!(alpha, 255, "the palette uses opaque group paint");
+    let path = env.artifact(&format!("material-vertical-menu-{photo}.png"));
+    tab.screenshot(&path).await?;
+    let raster = Raster::read(tab, path).await?;
+    let [x, y, width, height] = group;
+    let fill = raster.sample(x + width / 2., y + height / 2.)?;
+    let inset = if fixture["menu_demo"]["rtl"] == true {
+        width - 2.
+    } else {
+        2.
+    };
+    let edge = raster.sample(x + inset, y + height / 2.)?;
+    check_eq!(
+        edge,
+        [red, green, blue],
+        "the group paints its Material palette"
+    );
+    let thumb_color = if let Some([x, y, width, height]) = thumb {
+        let [red, green, blue, _]: [u8; 4] =
+            serde_json::from_value(fixture["menu_demo"]["palette"][1].clone())
+                .context("Vibrant menu exposes its scrollbar paint token")?;
+        let ink = raster.sample(x + width / 2., y + height / 2.)?;
+        check_eq!(
+            ink,
+            [red, green, blue],
+            "the scrollbar paints its contrasted token"
+        );
+        Some(ink)
+    } else {
+        None
+    };
+    Ok(json!({
+        "group": group,
+        "color": edge,
+        "center": fill,
+        "thumb_color": thumb_color,
+        "commands_at_capture": fixture["menu_demo"]["commands_executed"],
+    }))
+}
+
+async fn vertical_standard(env: &Env, tab: &Tab) -> Result<Value> {
+    open(tab).await?;
+    let boxes = vertical_groups(tab, 2.).await?;
+    let tree = ax_tree(tab).await?;
+    ax(&tree, "menu", "檔案動作")?;
+    for (id, label) in VERTICAL_GROUPS.into_iter().zip(["檔案", "整理", "資訊"]) {
+        ax(&tree, "group", label)?;
+        check_eq!(
+            tab.eval(&format!(
+                "{}?.contains({})",
+                projected(PANEL),
+                projected(id)
+            ))
+            .await?,
+            json!(true),
+            "the named group belongs to the menu's accessibility projection"
+        );
+    }
+    tab.press("ArrowDown").await?;
+    focused(tab, DISABLED).await?;
+    tab.press("Enter").await?;
+    until(
+        tab,
+        "s.menu_demo.open && s.menu_demo.commands_executed === 0",
+    )
+    .await?;
+    tab.press("ArrowDown").await?;
+    focused(tab, FIND).await?;
+    tab.press("ArrowDown").await?;
+    focused(tab, "menu-demo-rename").await?;
+    let paint = vertical_paint(env, tab, "standard", boxes[0], None).await?;
+    check_eq!(
+        tab.eval(&format!(
+            "window.gallery.control_bounds({THUMB:?}).length === 0"
+        ))
+        .await?,
+        json!(true),
+        "a fitting menu needs no scrollbar"
+    );
+    tab.press("End").await?;
+    focused(tab, LAST).await?;
+    tab.press("Enter").await?;
+    until(
+        tab,
+        "!s.menu_demo.open && s.menu_demo.commands_executed === 1 && s.menu_demo.last === '顯示詳細資料'",
+    )
+    .await?;
+    focused(tab, OPENER).await?;
+    Ok(json!({"groups":boxes,"paint":paint,"last":"顯示詳細資料"}))
+}
+
+async fn vertical_vibrant(env: &Env, tab: &Tab) -> Result<Value> {
+    activate(tab, "menu-demo-vibrant").await?;
+    activate(tab, "menu-demo-groups").await?;
+    until(tab, "s.menu_demo.vibrant && !s.menu_demo.grouped").await?;
+    open(tab).await?;
+    let group = bounds(tab, VERTICAL_GROUPS[0]).await?;
+    check!(
+        contains(group, bounds(tab, FIRST).await?) && contains(group, bounds(tab, LAST).await?),
+        "one group contains all commands"
+    );
+    let mut paint = vertical_paint(env, tab, "vibrant", group, None).await?;
+    let (x, y) = point(tab, "menu-demo-copy", 0.5).await?;
+    tab.click(x, y).await?;
+    until(
+        tab,
+        "!s.menu_demo.open && s.menu_demo.commands_executed === 2 && s.menu_demo.last === '建立副本'",
+    )
+    .await?;
+    canvas_focus(tab, OPENER)
+        .await
+        .context("the trusted click returns focus to the trigger through the canvas")?;
+    let after = state(tab).await?;
+    paint["pointer_command"] = json!({
+        "before_count": paint["commands_at_capture"],
+        "after_count": after["menu_demo"]["commands_executed"],
+        "focus": after["focused"],
+        "last": after["menu_demo"]["last"],
+    });
+    open(tab)
+        .await
+        .context("the projected trigger keeps focus when it reopens from the canvas")?;
+    paint["reopen_focus"] = state(tab).await?["focused"].clone();
+    tab.press("Tab").await?;
+    until(tab, "!s.menu_demo.open").await?;
+    focused(tab, OUTSIDE).await?;
+    paint["tab_focus"] = state(tab).await?["focused"].clone();
+
+    // An actual focus change to the surrounding page must still leave Surface.
+    tab.eval(
+        "(() => { const button = document.createElement('button');
+            button.id = 'menu-demo-host-focus'; button.textContent = 'Host action';
+            document.body.append(button); button.focus(); })()",
+    )
+    .await?;
+    until(tab, "s.focused === null").await?;
+    let host_focus = tab.eval("document.activeElement.id").await?;
+    check_eq!(
+        host_focus,
+        "menu-demo-host-focus",
+        "the surrounding page keeps its focus"
+    );
+    paint["external_focus"] = json!({
+        "element": host_focus,
+        "surface_focus": state(tab).await?["focused"],
+    });
+    tab.eval("document.getElementById('menu-demo-host-focus').remove()")
+        .await?;
+    Ok(paint)
+}
