+pub(super) async fn run_vertical(env: &Env, chrome: &Chrome, url: &str) -> Result<()> {
+    let tab = chrome.page(960, 2444, 2.).await?;
+    let mut report = json!({"browser":chrome.version});
+    let result: Result<()> = async {
+        step(VERTICAL_STEPS[0], "Standard uses three named groups and two gaps with real keyboard navigation");
+        tab.goto(url).await?;
+        crate::smoke::ready(&tab, "gallery").await?;
+        resize(&tab, 960, 2400).await?;
+        activate(&tab, "section-2").await?;
+        until(&tab, "s.section === 2").await?;
+        activate(&tab, VERTICAL_SHOW).await?;
+        focused(&tab, BACK).await?;
+        resize(&tab, 960, 1120).await?;
+        report["adapter"] = tab.eval("(async()=>{const a=await navigator.gpu?.requestAdapter();if(!a)return null;const {isFallbackAdapter,vendor,architecture}=a.info;return {isFallbackAdapter,vendor,architecture};})()").await?;
+        check!(report["adapter"]["isFallbackAdapter"].is_boolean(), "WebGPU reports fallback status");
+        report["standard"] = vertical_standard(env, &tab).await?;
+        step(VERTICAL_STEPS[1], "Vibrant paints one group, takes a trusted click and returns Tab focus to the page");
+        report["vibrant"] = vertical_vibrant(env, &tab).await?;
+        step(VERTICAL_STEPS[2], "short dark RTL removes gaps and shows a scrollbar that follows trusted keys");
+        report["overflow"] = vertical_overflow(env, &tab).await?;
+        check!(tab.errors().is_empty(), "no page errors: {:?}", tab.errors());
+        Ok(())
+    }.await;
+    report["errors"] = json!(tab.errors());
+    if let Err(error) = &result {
+        report["failure"] = json!(format!("{error:#}"));
+        report["state_at_failure"] = state(&tab).await.unwrap_or(Value::Null);
+        let _ = tab
+            .screenshot(&env.artifact("material-vertical-menu-failure.png"))
+            .await;
+    }
+    env.write_json("browser-material-vertical-menu.json", &report)?;
+    result
+}
