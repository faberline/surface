+#[test]
+fn grouped_commands_use_two_token_palettes_and_one_keyboard_scope() {
+    for (rtl, palette) in [
+        (false, VerticalMenuPalette::Standard),
+        (true, VerticalMenuPalette::Vibrant),
+    ] {
+        let mut runtime = Runtime::new(Fixture {
+            rtl,
+            palette,
+            ..Fixture::default()
+        })
+        .unwrap();
+        open(&mut runtime, 720., 640.);
+        let group = bounds(&runtime, "documents");
+        assert_eq!(bounds(&runtime, "other").y - bottom(group), 2.);
+        assert_eq!(get(&runtime, "documents").name(), "文件");
+        assert_eq!(get(&runtime, "documents-header").text_value(), Some("文件"));
+        assert_eq!(get(&runtime, "vertical").role(), Role::Menu);
+        assert_eq!(get(&runtime, "vertical").name(), "報告操作");
+        assert_eq!(get(&runtime, "trigger").expanded_state(), Some(true));
+        assert_eq!(
+            get(&runtime, "documents").style().corner_radii(),
+            Corners::new(16., 16., 8., 8.)
+        );
+        assert_eq!(
+            get(&runtime, "other").style().corner_radii(),
+            Corners::new(8., 8., 16., 16.)
+        );
+        assert_eq!(
+            get(&runtime, "vertical").style().background,
+            Color::TRANSPARENT
+        );
+        let theme = runtime.app().theme();
+        let (surface, ink, icon) = if rtl {
+            (
+                theme.colors.tertiary_container,
+                theme.colors.on_tertiary_container,
+                theme.colors.on_tertiary_container,
+            )
+        } else {
+            (
+                theme.colors.surface_container_low,
+                theme.colors.on_surface,
+                theme.colors.on_surface_variant,
+            )
+        };
+        assert_eq!(get(&runtime, "documents").style().background, surface);
+        assert_eq!(get(&runtime, "save-label").style().foreground, ink);
+        let target = bounds(&runtime, "save");
+        let face = bounds(&runtime, "save-face");
+        let leading = bounds(&runtime, "save-leading");
+        let trailing = bounds(&runtime, "save-trailing");
+        assert_eq!(
+            (target.height, face.height, face.y - target.y),
+            (48., 44., 2.)
+        );
+        assert_eq!((leading.width, leading.height), (20., 20.));
+        let (left, right_icon) = if rtl {
+            (trailing, leading)
+        } else {
+            (leading, trailing)
+        };
+        assert_eq!(left.x - face.x, 16.);
+        assert_eq!(right(face) - right(right_icon), 16.);
+        let mut fonts = TextSystem::default();
+        let paint = runtime.render_extended(720., 640., &mut fonts).unwrap();
+        assert!(paint
+            .ops()
+            .iter()
+            .any(|op| matches!(op, ExtendedPaintOp::FillPath(path)
+            if path.color() == icon && path.rect().intersect(leading) == path.rect())));
+        assert!(runtime.dom().by_id("empty").is_none());
+        assert!(runtime.dom().by_id("vertical-scroll-thumb").is_none());
+
+        assert_eq!(runtime.focused(), Some("disabled"));
+        runtime.dispatch(Event::Activate).unwrap();
+        assert!(runtime.app().chosen.is_empty());
+        key(&mut runtime, EditKey::Down);
+        assert_eq!(runtime.focused(), Some("save"));
+        key(&mut runtime, EditKey::Down);
+        assert_eq!(runtime.focused(), Some("archive"));
+        runtime.dispatch(Event::Activate).unwrap();
+        settle(&mut runtime, 720., 640.);
+        assert_eq!(runtime.app().chosen, vec!["archive"]);
+        assert_eq!(runtime.focused(), Some("trigger"));
+        assert!(runtime.dom().by_id("vertical").is_none());
+
+        open(&mut runtime, 720., 640.);
+        let target = bounds(&runtime, "save");
+        let x = target.x + target.width / 2.;
+        let y = target.y + target.height / 2.;
+        runtime.dispatch(Event::PointerDown { x, y }).unwrap();
+        assert_eq!(runtime.focused(), Some("save"));
+        runtime.dispatch(Event::PointerUp { x, y }).unwrap();
+        render_until_idle(&mut runtime, 720., 640.);
+        assert_eq!(runtime.app().chosen, vec!["archive", "save"]);
+        assert_eq!(runtime.focused(), Some("trigger"));
+        assert!(runtime.dom().by_id("vertical").is_none());
+    }
+}
