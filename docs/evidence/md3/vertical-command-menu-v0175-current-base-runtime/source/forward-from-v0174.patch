+#[test]
+fn disabled_click_stays_in_a_separated_menu_and_outside_click_dismisses() {
+    let mut runtime = Runtime::new(Fixture::default()).unwrap();
+    open(&mut runtime, 720., 640.);
+
+    let panel = bounds(&runtime, "vertical");
+    let group = bounds(&runtime, "documents");
+    let gap = bounds(&runtime, "other").y - bottom(group);
+    let row = bounds(&runtime, "disabled");
+    let (x, y) = (row.x + row.width / 2., row.y + row.height / 2.);
+    assert_eq!(gap, 2.);
+    assert_eq!(
+        get(&runtime, "vertical").style().background,
+        Color::TRANSPARENT
+    );
+    assert!(!get(&runtime, "vertical").style().clip);
+    assert_eq!(get(&runtime, "documents").style().background.3, 255);
+    assert!(panel.contains(x, y) && group.contains(x, y));
+    assert!(get(&runtime, "disabled").is_disabled());
+    assert_eq!(runtime.focused(), Some("disabled"));
+
+    let click = |runtime: &mut Runtime<Fixture>, x, y| {
+        runtime.dispatch(Event::PointerDown { x, y }).unwrap();
+        runtime.dispatch(Event::PointerUp { x, y }).unwrap();
+    };
+    click(&mut runtime, x, y);
+    assert!(runtime.app().open, "a disabled row is inside the popup");
+    assert!(runtime.app().chosen.is_empty());
+    assert_eq!(runtime.focused(), Some("disabled"));
+
+    assert!(!panel.contains(700., 620.));
+    click(&mut runtime, 700., 620.);
+    assert!(!runtime.app().open);
+    assert!(runtime.app().chosen.is_empty());
+    assert_eq!(runtime.focused(), Some("trigger"));
+
+    open(&mut runtime, 720., 640.);
+    let group = bounds(&runtime, "documents");
+    let next = bounds(&runtime, "other");
+    let gap_y = (bottom(group) + next.y) / 2.;
+    assert!(bounds(&runtime, "vertical").contains(x, gap_y));
+    assert!(!group.contains(x, gap_y) && !next.contains(x, gap_y));
+    click(&mut runtime, x, gap_y);
+    assert!(!runtime.app().open);
+    assert!(runtime.app().chosen.is_empty());
+    assert_eq!(runtime.focused(), Some("trigger"));
+}
