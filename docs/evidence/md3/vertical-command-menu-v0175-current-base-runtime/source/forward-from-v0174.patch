diff --git a/crates/surface-material/src/command_menu/vertical.rs b/crates/surface-material/src/command_menu/vertical.rs
new file mode 100644
index 0000000..fd62fa1
--- /dev/null
+++ b/crates/surface-material/src/command_menu/vertical.rs
@@ -0,0 +1,467 @@
+//! Grouped Expressive vertical commands.
+//!
+//! Google M3 Menus Specs and Guidelines define the two color mappings and
+//! continuous scrolling layout. Geometry follows AndroidX SegmentedMenuTokens
+//! (268d841a45644cadf438fc335c793869728449ec).
+
+use surface::{
+    Align, Color, ComputedDom, Corners, Insets, Length, MicroDom, Node, Rect, Role, Style,
+    TextAlignment,
+};
+use surface_app::{Roving, View};
+
+use super::{
+    bind_command_item, content_id, icon_view, CommandMenuItem, CommandMenuMeasurement,
+    CommandMenuOptions,
+};
+use crate::{
+    menu_layout::{place_menu, MenuAnchor, MenuLayout, MIN_ITEM_HEIGHT},
+    shape::{self, LayoutDirection},
+    typography, Elevation, Theme,
+};
+
+const GROUP_GAP: f32 = 2.;
+const GROUP_PADDING: f32 = 4.;
+const FACE_HEIGHT: f32 = 44.;
+const FACE_PADDING: f32 = 8.;
+const SLOT_GAP: f32 = 12.;
+const ICON_SIZE: f32 = 20.;
+const HEADER_MIN: f32 = 28.;
+const THUMB_WIDTH: f32 = 4.;
+const THUMB_EDGE: f32 = 2.;
+const THUMB_VERTICAL: f32 = 4.;
+const THUMB_MIN: f32 = 16.;
+
+/// The two Material 3 Expressive vertical menu color mappings.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum VerticalMenuPalette {
+    #[default]
+    Standard,
+    Vibrant,
+}
+
+/// One optional named heading and its ordered commands.
+pub struct VerticalCommandMenuGroup<'a, M> {
+    pub id: &'a str,
+    pub label: Option<&'a str>,
+    pub items: Vec<CommandMenuItem<'a, M>>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct VerticalMenuGeometry {
+    width: f32,
+    height_without_gaps: f32,
+    offset_y: f32,
+    groups: usize,
+}
+
+impl VerticalMenuGeometry {
+    pub(super) fn measure(menu_id: &str, dom: &MicroDom, layout: &ComputedDom) -> Option<Self> {
+        let viewport = layout
+            .nodes
+            .get(dom.by_id(&viewport_id(menu_id))?.index())?
+            .bounds;
+        let content = dom.by_id(&content_id(menu_id))?;
+        let bounds = layout.nodes.get(content.index())?.bounds;
+        let groups = dom.children(content).count();
+        let gaps = dom.get(content).ok()?.style().gap * groups.saturating_sub(1) as f32;
+        let result = Self {
+            width: viewport.width,
+            height_without_gaps: bounds.height - gaps,
+            offset_y: (viewport.y - bounds.y).max(0.),
+            groups,
+        };
+        (result.width.is_finite()
+            && result.width > 0.
+            && result.height_without_gaps.is_finite()
+            && result.height_without_gaps > 0.
+            && result.offset_y.is_finite())
+        .then_some(result)
+    }
+}
+
+#[derive(Clone, Copy)]
+struct MenuColors {
+    surface: Color,
+    label: Color,
+    icon: Color,
+    layer: Color,
+    thumb: Color,
+}
+
+#[derive(Clone, Copy)]
+struct VerticalPlacement {
+    menu: MenuLayout,
+    separated: bool,
+    thumb: Option<Rect>,
+}
+
+impl Theme {
+    /// Build one anchored Expressive vertical menu from one to three
+    /// nonempty groups. Each group and command must have a distinct stable ID.
+    /// A nonempty group label names the group and paints a passive heading.
+    ///
+    /// Use the same measurement and caller-owned open/dismiss flow as
+    /// [Self::command_menu]. If measured contents need to scroll, the groups
+    /// share a continuous surface and a passive thumb follows the viewport.
+    pub fn vertical_command_menu<'a, M: 'a>(
+        &self,
+        options: CommandMenuOptions<'_>,
+        palette: VerticalMenuPalette,
+        trigger: View<M>,
+        groups: impl IntoIterator<Item = VerticalCommandMenuGroup<'a, M>>,
+        on_dismiss: M,
+        measurement: &CommandMenuMeasurement,
+    ) -> View<M> {
+        let scope = View::new(
+            Node::new(Role::Group, "")
+                .id(format!("{}-scope", options.id))
+                .styled(Style::column()),
+        );
+        let Some(anchor) = measurement.anchor.filter(|_| options.open) else {
+            return scope.children([trigger.menu_expanded(false)]);
+        };
+        let groups: Vec<_> = groups
+            .into_iter()
+            .filter(|group| !group.items.is_empty())
+            .take(4)
+            .collect();
+        if !(1..=3).contains(&groups.len()) {
+            return scope.children([trigger.menu_expanded(false)]);
+        }
+        let minimum = groups
+            .iter()
+            .map(|group| {
+                2. * GROUP_PADDING
+                    + group.items.len() as f32 * MIN_ITEM_HEIGHT
+                    + group_label(group.label).map_or(0., |_| HEADER_MIN)
+            })
+            .sum();
+        let Some(placement) = placement(
+            anchor,
+            &options,
+            minimum,
+            groups.len(),
+            measurement.vertical,
+        ) else {
+            return scope.children([trigger.menu_expanded(false)]);
+        };
+        let first = groups[0].items[0].id;
+        let colors = match palette {
+            VerticalMenuPalette::Standard => MenuColors {
+                surface: self.colors.surface_container_low,
+                label: self.colors.on_surface,
+                icon: self.colors.on_surface_variant,
+                layer: self.colors.on_surface,
+                thumb: self.colors.outline,
+            },
+            VerticalMenuPalette::Vibrant => MenuColors {
+                surface: self.colors.tertiary_container,
+                label: self.colors.on_tertiary_container,
+                icon: self.colors.on_tertiary_container,
+                layer: self.colors.on_tertiary_container,
+                thumb: self.colors.on_tertiary_container,
+            },
+        };
+        let panel = self.vertical_menu_panel(&options, placement, groups, colors);
+        scope
+            .children([trigger.menu_expanded(true), panel])
+            .modal_overlay_descendants(on_dismiss)
+            .modal_initial_focus(first)
+            .modal_focus_fallback(options.restore_focus_to.unwrap_or(options.trigger_id))
+            .dismiss_modal_on_tab()
+    }
+
+    fn vertical_menu_panel<M>(
+        &self,
+        options: &CommandMenuOptions<'_>,
+        placement: VerticalPlacement,
+        groups: Vec<VerticalCommandMenuGroup<'_, M>>,
+        colors: MenuColors,
+    ) -> View<M> {
+        let count = groups.len();
+        let gap = if placement.separated { GROUP_GAP } else { 0. };
+        let content = View::new(
+            Node::new(Role::Group, "")
+                .id(content_id(options.id))
+                .styled(Style::column().width(Length::Percent(1.)).gap(gap)),
+        )
+        .children(groups.into_iter().enumerate().map(|(index, group)| {
+            self.vertical_menu_group(
+                group,
+                index,
+                count,
+                placement.separated,
+                options.direction,
+                colors,
+            )
+        }));
+        let scroller = View::new(
+            Node::new(Role::Group, "")
+                .id(viewport_id(options.id))
+                .styled(
+                    Style::column()
+                        .height(Length::Px(0.))
+                        .grow(1.)
+                        .clip(!placement.separated),
+                ),
+        )
+        .children([content])
+        .accessibility_scroll_pages()
+        .observe_scroll_geometry();
+        let bounds = placement.menu.bounds;
+        let mut style = Style::column()
+            .width(Length::Px(bounds.width))
+            .height(Length::Px(bounds.height))
+            .fixed(Insets {
+                left: Length::Px(bounds.x),
+                top: Length::Px(bounds.y),
+                ..Insets::default()
+            });
+        if !placement.separated {
+            style = style.background(colors.surface).corners(shape::LARGE);
+        }
+        let mut panel = Node::new(Role::Menu, options.label)
+            .id(options.id)
+            .styled(style);
+        if !placement.separated {
+            panel = panel.box_shadows(self.elevation(Elevation::Level2));
+        }
+        let thumb = placement.thumb.map(|rect| {
+            View::new(
+                Node::new(Role::Group, "")
+                    .id(format!("{}-scroll-thumb", options.id))
+                    .styled(
+                        Style::column()
+                            .width(Length::Px(rect.width))
+                            .height(Length::Px(rect.height))
+                            .absolute(Insets {
+                                left: Length::Px(rect.x),
+                                top: Length::Px(rect.y),
+                                ..Insets::default()
+                            })
+                            .background(colors.thumb)
+                            .corners(shape::FULL),
+                    ),
+            )
+            .without_interaction(None)
+        });
+        View::new(panel)
+            .children(std::iter::once(scroller).chain(thumb))
+            .roving(Roving::vertical(false))
+    }
+
+    fn vertical_menu_group<M>(
+        &self,
+        group: VerticalCommandMenuGroup<'_, M>,
+        index: usize,
+        count: usize,
+        separated: bool,
+        direction: LayoutDirection,
+        colors: MenuColors,
+    ) -> View<M> {
+        let label = group_label(group.label);
+        let mut style = Style::column().padding(GROUP_PADDING);
+        if separated {
+            style = style
+                .background(colors.surface)
+                .corners(position_corners(index, count, 16., 8.));
+        }
+        let mut owner = Node::new(Role::Group, label.unwrap_or_default())
+            .id(group.id)
+            .styled(style);
+        if separated {
+            owner = owner.box_shadows(self.elevation(Elevation::Level2));
+        }
+        let heading = label.map(|label| {
+            View::new(
+                Node::new(Role::Text, "")
+                    .id(format!("{}-header", group.id))
+                    .text(label)
+                    .text_alignment(text_alignment(direction))
+                    .styled(
+                        Style::column()
+                            .padding(GROUP_PADDING)
+                            .with_text_style(typography::BODY_MEDIUM)
+                            .foreground(colors.icon),
+                    ),
+            )
+            .without_interaction(None)
+        });
+        let length = group.items.len();
+        View::new(owner).children(heading.into_iter().chain(
+            group.items.into_iter().enumerate().map(|(position, item)| {
+                self.vertical_menu_item(item, position, length, direction, colors)
+            }),
+        ))
+    }
+
+    fn vertical_menu_item<M>(
+        &self,
+        item: CommandMenuItem<'_, M>,
+        position: usize,
+        count: usize,
+        direction: LayoutDirection,
+        colors: MenuColors,
+    ) -> View<M> {
+        let corners = if count == 1 {
+            shape::EXTRA_SMALL
+        } else {
+            position_corners(position, count, 12., 4.)
+        };
+        let (label_ink, icon_ink) = if item.disabled {
+            let Color(r, g, b, _) = colors.label;
+            let ink = Color(r, g, b, 97);
+            (ink, ink)
+        } else {
+            (colors.label, colors.icon)
+        };
+        let text = View::new(
+            Node::new(Role::Text, "")
+                .id(format!("{}-label", item.id))
+                .text(item.label)
+                .text_alignment(text_alignment(direction))
+                .shrink_to_fit_width()
+                .styled(
+                    Style::column()
+                        .grow(1.)
+                        .with_text_style(typography::BODY_LARGE)
+                        .foreground(label_ink),
+                ),
+        );
+        let leading = item
+            .leading_icon
+            .map(|icon| icon_view(format!("{}-leading", item.id), icon, icon_ink, ICON_SIZE));
+        let trailing = item
+            .trailing_icon
+            .map(|icon| icon_view(format!("{}-trailing", item.id), icon, icon_ink, ICON_SIZE));
+        let mut row = Node::new(Role::Group, "").styled(
+            Style::row()
+                .width(Length::Px(0.))
+                .grow(1.)
+                .gap(SLOT_GAP)
+                .align(Align::Center),
+        );
+        if direction == LayoutDirection::RightToLeft {
+            row = row.reverse_row();
+        }
+        let interior = View::new(row).children(leading.into_iter().chain([text]).chain(trailing));
+        let mut face = Style::row()
+            .align(Align::Center)
+            .padding(FACE_PADDING)
+            .corners(corners)
+            .state_layer(colors.layer);
+        face.min_height = FACE_HEIGHT;
+        // The extra horizontal spacer makes 16 dp outer spacing on each side
+        // while keeping the inside vertical padding at 8 dp.
+        let side = || {
+            View::new(
+                Node::new(Role::Group, "").styled(Style::row().width(Length::Px(FACE_PADDING))),
+            )
+        };
+        let face = View::new(
+            Node::new(Role::Group, "")
+                .id(format!("{}-face", item.id))
+                .styled(face),
+        )
+        .children([side(), interior, side()])
+        .without_interaction(None);
+        let mut owner = Style::column().justify(Align::Center).corners(corners);
+        owner.min_height = MIN_ITEM_HEIGHT;
+        let view = View::new(
+            Node::new(Role::MenuItem, item.label)
+                .id(item.id)
+                .disabled(item.disabled)
+                .focus_color(self.colors.secondary)
+                .focus_outline_width(3.)
+                .styled(owner),
+        )
+        .children([face])
+        .accessibility_scroll_into_view();
+        bind_command_item(view, item.disabled, item.on_press)
+    }
+}
+
+fn position_corners(index: usize, count: usize, outer: f32, inner: f32) -> Corners {
+    let top = if index == 0 { outer } else { inner };
+    let bottom = if index + 1 == count { outer } else { inner };
+    Corners::new(top, top, bottom, bottom)
+}
+
+fn group_label(label: Option<&str>) -> Option<&str> {
+    label.filter(|label| !label.trim().is_empty())
+}
+
+fn text_alignment(direction: LayoutDirection) -> TextAlignment {
+    match direction {
+        LayoutDirection::LeftToRight => TextAlignment::Left,
+        LayoutDirection::RightToLeft => TextAlignment::Right,
+    }
+}
+
+fn viewport_id(menu_id: &str) -> String {
+    format!("{menu_id}-viewport")
+}
+
+fn placement(
+    anchor: MenuAnchor,
+    options: &CommandMenuOptions<'_>,
+    minimum: f32,
+    count: usize,
+    geometry: Option<VerticalMenuGeometry>,
+) -> Option<VerticalPlacement> {
+    let plan = |height| place_menu(anchor, (options.preferred_width, height), options.direction);
+    let minimum_layout = plan(minimum)?;
+    let geometry = geometry.filter(|geometry| {
+        geometry.groups == count && (geometry.width - minimum_layout.bounds.width).abs() <= 0.5
+    });
+    let continuous = geometry.map_or(minimum, |geometry| {
+        geometry.height_without_gaps.max(minimum)
+    });
+    // Keep the viewport clipped until Runtime clears an old scroll offset.
+    // The separated layout can then let the group shadows escape the viewport.
+    if geometry.is_some_and(|geometry| geometry.offset_y == 0.) && count > 1 {
+        let gapped = continuous + GROUP_GAP * (count - 1) as f32;
+        if let Some(menu) = plan(gapped).filter(|layout| layout.bounds.height >= gapped) {
+            return Some(VerticalPlacement {
+                menu,
+                separated: true,
+                thumb: None,
+            });
+        }
+    }
+    let menu = plan(continuous)?;
+    let thumb = geometry.and_then(|geometry| {
+        scroll_thumb(
+            menu.bounds,
+            continuous,
+            geometry.offset_y,
+            options.direction,
+        )
+    });
+    Some(VerticalPlacement {
+        menu,
+        separated: false,
+        thumb,
+    })
+}
+
+fn scroll_thumb(
+    bounds: Rect,
+    content_height: f32,
+    offset: f32,
+    direction: LayoutDirection,
+) -> Option<Rect> {
+    let track = bounds.height - 2. * THUMB_VERTICAL;
+    let overflow = content_height - bounds.height;
+    if bounds.width < THUMB_WIDTH + 2. * THUMB_EDGE || track <= THUMB_MIN || overflow <= 0. {
+        return None;
+    }
+    let height = (track * bounds.height / content_height).clamp(THUMB_MIN, track);
+    let y = THUMB_VERTICAL + (track - height) * (offset / overflow).clamp(0., 1.);
+    let x = match direction {
+        LayoutDirection::LeftToRight => bounds.width - THUMB_WIDTH - THUMB_EDGE,
+        LayoutDirection::RightToLeft => THUMB_EDGE,
+    };
+    Some(Rect::new(x, y, THUMB_WIDTH, height))
+}
