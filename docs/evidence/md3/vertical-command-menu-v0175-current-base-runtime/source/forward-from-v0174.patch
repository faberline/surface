+use surface::{Color, Corners, ExtendedPaintOp, Node, Rect, Role, Style};
+use surface_app::{
+    AccessibilityScrollDirection, AccessibilityScrollResult, AnimationFrame, AnimationUpdate,
+    Application, EditKey, Event, Runtime, View,
+};
+use surface_material::{
+    shape::LayoutDirection, CommandMenuItem, CommandMenuMeasurement, CommandMenuOptions, Theme,
+    VectorIcon, VerticalCommandMenuGroup, VerticalMenuPalette,
+};
+use surface_wgpu::TextSystem;
+
+#[derive(Clone, Copy)]
+enum Message {
+    Open,
+    Dismiss,
+    Choose(&'static str),
+}
+
+#[derive(Default)]
+struct Fixture {
+    open: bool,
+    chosen: Vec<&'static str>,
+    rtl: bool,
+    large: bool,
+    palette: VerticalMenuPalette,
+    many: bool,
+    measurement: CommandMenuMeasurement,
+}
+
+impl Fixture {
+    fn theme(&self) -> Theme {
+        if self.rtl {
+            Theme::dark()
+        } else {
+            Theme::light()
+        }
+    }
+}
+
+impl Application for Fixture {
+    type Message = Message;
+
+    fn update(&mut self, message: Self::Message) {
+        match message {
+            Message::Open => self.open = true,
+            Message::Dismiss => self.open = false,
+            Message::Choose(id) => {
+                self.chosen.push(id);
+                self.open = false;
+            }
+        }
+    }
+
+    fn text_scale(&self) -> f32 {
+        if self.large {
+            2.
+        } else {
+            1.
+        }
+    }
+
+    fn animation_frame(&mut self, frame: AnimationFrame<'_>) -> AnimationUpdate {
+        self.measurement.advance("vertical", "trigger", &frame)
+    }
+
+    fn view(&self) -> View<Self::Message> {
+        let theme = self.theme();
+        let icon = || VectorIcon::new([[2., 2.], [22., 2.], [22., 22.], [2., 22.]]);
+        let command = |id: &'static str, label, disabled, icons| CommandMenuItem {
+            id,
+            label,
+            leading_icon: if icons { icon() } else { None },
+            trailing_icon: if icons { icon() } else { None },
+            disabled,
+            on_press: Message::Choose(id),
+        };
+        let mut next = vec![command("archive", "封存", false, false)];
+        if self.many {
+            next.extend([
+                command("load", "載入已儲存的工作區與標籤", false, false),
+                command("clear", "清除", false, false),
+                command("sort", "排序", false, false),
+                command("report", "列出工作區中的完整報告", false, false),
+                command("last", "結束", false, false),
+            ]);
+        }
+        let menu = theme.vertical_command_menu(
+            CommandMenuOptions {
+                id: "vertical",
+                label: "報告操作",
+                trigger_id: "trigger",
+                open: self.open,
+                direction: if self.rtl {
+                    LayoutDirection::RightToLeft
+                } else {
+                    LayoutDirection::LeftToRight
+                },
+                preferred_width: 240.,
+                restore_focus_to: None,
+            },
+            self.palette,
+            theme.button("trigger", "開啟", Message::Open),
+            [
+                VerticalCommandMenuGroup {
+                    id: "documents",
+                    label: Some("文件"),
+                    items: vec![
+                        command("disabled", "停用", true, false),
+                        command("save", "儲存", false, true),
+                    ],
+                },
+                VerticalCommandMenuGroup {
+                    id: "other",
+                    label: Some("其他動作"),
+                    items: next,
+                },
+                VerticalCommandMenuGroup {
+                    id: "empty",
+                    label: Some("沒有可用的動作"),
+                    items: Vec::new(),
+                },
+            ],
+            Message::Dismiss,
+            &self.measurement,
+        );
+        View::new(Node::new(Role::Window, "Gallery").styled(Style::column().padding(20.)))
+            .children([menu])
+    }
+}
+
+fn settle(runtime: &mut Runtime<Fixture>, width: f32, height: f32) {
+    let mut fonts = TextSystem::default();
+    for _ in 0..7 {
+        runtime.render_extended(width, height, &mut fonts).unwrap();
+    }
+}
+
+fn render_until_idle(runtime: &mut Runtime<Fixture>, width: f32, height: f32) -> usize {
+    let mut fonts = TextSystem::default();
+    for count in 1..=8 {
+        runtime.render_extended(width, height, &mut fonts).unwrap();
+        if !runtime.needs_frame() {
+            return count;
+        }
+    }
+    panic!("menu still needs frames after layout settled");
+}
+
+fn get<'a>(runtime: &'a Runtime<Fixture>, id: &str) -> &'a Node {
+    runtime.dom().get(runtime.dom().by_id(id).unwrap()).unwrap()
+}
+
+fn bounds(runtime: &Runtime<Fixture>, id: &str) -> Rect {
+    runtime.computed().unwrap().nodes[runtime.dom().by_id(id).unwrap().index()].bounds
+}
+
+fn right(bounds: Rect) -> f32 {
+    bounds.x + bounds.width
+}
+
+fn bottom(bounds: Rect) -> f32 {
+    bounds.y + bounds.height
+}
+
+fn key(runtime: &mut Runtime<Fixture>, key: EditKey) {
+    assert!(runtime
+        .dispatch(Event::Edit {
+            key,
+            extend: false,
+            by_word: false
+        })
+        .unwrap());
+}
+
+fn open(runtime: &mut Runtime<Fixture>, width: f32, height: f32) {
+    settle(runtime, width, height);
+    assert!(runtime.activate("trigger").unwrap());
+    settle(runtime, width, height);
+}
