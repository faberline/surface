+async fn vertical_groups(tab: &Tab, gap: f64) -> Result<[[f64; 4]; 3]> {
+    let [first, second, third] = VERTICAL_GROUPS;
+    tab.wait_for(&format!(
+        "(() => {{ const [a,b,c] = [{first:?},{second:?},{third:?}].map(id => window.gallery.control_bounds(id));
+            return a && b && c && Math.abs(b[1]-a[1]-a[3]-{gap}) < 0.2
+                && Math.abs(c[1]-b[1]-b[3]-{gap}) < 0.2; }})()"
+    )).await?;
+    Ok([
+        bounds(tab, first).await?,
+        bounds(tab, second).await?,
+        bounds(tab, third).await?,
+    ])
