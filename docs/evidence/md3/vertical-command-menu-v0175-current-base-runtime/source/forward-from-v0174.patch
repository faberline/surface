+#[test]
+fn overflow_has_real_mirrored_thumb_and_retains_group_and_focus_on_resize() {
+    for rtl in [false, true] {
+        let mut runtime = Runtime::new(Fixture {
+            rtl,
+            large: true,
+            many: true,
+            ..Fixture::default()
+        })
+        .unwrap();
+        open(&mut runtime, 320., 270.);
+        let viewport = bounds(&runtime, "vertical-viewport");
+        let group = bounds(&runtime, "documents");
+        assert_eq!(bounds(&runtime, "other").y, bottom(group));
+        assert!(bounds(&runtime, "vertical-content").height > viewport.height);
+        assert!(bounds(&runtime, "report-label").height >= 48.);
+        let start = bounds(&runtime, "vertical-scroll-thumb");
+        assert_eq!((start.width, start.y - viewport.y), (4., 4.));
+        assert_eq!(
+            if rtl {
+                start.x - viewport.x
+            } else {
+                right(viewport) - right(start)
+            },
+            2.
+        );
+        assert!(!get(&runtime, "vertical-scroll-thumb").is_focusable());
+        runtime
+            .dispatch(Event::Scroll {
+                x: viewport.x + viewport.width / 2.,
+                y: viewport.y + viewport.height / 2.,
+                delta_x: 0.,
+                delta_y: 38.,
+            })
+            .unwrap();
+        assert!(render_until_idle(&mut runtime, 320., 270.) > 1);
+        let wheel = bounds(&runtime, "vertical-scroll-thumb");
+        assert!(
+            runtime
+                .scroll_metrics("vertical-viewport")
+                .unwrap()
+                .offset
+                .1
+                > 0.
+        );
+        assert!(wheel.y > start.y);
+        assert_eq!(runtime.focused(), Some("disabled"));
+        let viewport_id = runtime.dom().by_id("vertical-viewport").unwrap();
+        let page_down = runtime
+            .accessibility_frame()
+            .unwrap()
+            .scroll_page_target(viewport_id, AccessibilityScrollDirection::Down)
+            .unwrap();
+        assert_eq!(
+            runtime.accessibility_scroll_page(&page_down).unwrap(),
+            AccessibilityScrollResult::Scheduled
+        );
+        assert!(render_until_idle(&mut runtime, 320., 270.) > 1);
+        let page = bounds(&runtime, "vertical-scroll-thumb");
+        assert!(page.y > wheel.y);
+        assert_eq!(runtime.focused(), Some("disabled"));
+
+        let tail_unrevealed = bounds(&runtime, "last");
+        key(&mut runtime, EditKey::End);
+        assert!(render_until_idle(&mut runtime, 320., 270.) > 1);
+        assert_eq!(runtime.focused(), Some("last"));
+        let tail_revealed = bounds(&runtime, "last");
+        let end = bounds(&runtime, "vertical-scroll-thumb");
+        assert!(tail_revealed.y < tail_unrevealed.y);
+        assert!(bottom(tail_revealed) <= bottom(viewport));
+        assert!(end.y > page.y);
+        assert!(bottom(end) <= bottom(viewport) - 3.5);
+        assert!(render_until_idle(&mut runtime, 720., 900.) > 1);
+        let anchor = runtime.app().measurement.anchor().unwrap();
+        assert_eq!(anchor.viewport, Rect::new(0., 0., 720., 900.));
+        assert_eq!(anchor.trigger, bounds(&runtime, "trigger"));
+        assert!(bounds(&runtime, "vertical").height > viewport.height);
+        assert_eq!(runtime.focused(), Some("last"));
+        assert!(runtime.dom().by_id("vertical-scroll-thumb").is_none());
+        assert_eq!(
+            bounds(&runtime, "other").y - bottom(bounds(&runtime, "documents")),
+            2.
+        );
+        assert_eq!(
+            bounds(&runtime, "vertical-content").y,
+            bounds(&runtime, "vertical-viewport").y,
+            "Fitted groups must clear the old scroll offset"
+        );
